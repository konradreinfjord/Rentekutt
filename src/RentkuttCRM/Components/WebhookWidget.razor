<div class="webhook-widget">
    <div class="ww-header" @onclick="() => _open = !_open">
        <div class="ww-title">
            <span class="ww-chevron @(_open ? "open" : "")">▸</span>
            <strong>@(Hook?.Name ?? Name)</strong>
            <span class="ww-tag">inbound endepunkt</span>
        </div>
        <div class="ww-meta">
            @if (Hook?.LastReceivedAt is { } t)
            {
                <span class="ww-last">Sist mottatt @t.TilOslo().ToString("dd.MM.yyyy HH:mm") · @Hook.LastReceivedInfo</span>
            }
            else
            {
                <span class="ww-last muted">Ingen data mottatt ennå</span>
            }
            <span class="status on">Aktiv</span>
        </div>
    </div>

    @if (_open)
    {
        <div class="ww-body">
            <p class="page-sub" style="margin:0 0 16px">
                @if (ErVipps)
                {
                    @:Mottar Vipps/BankID-bekreftelse og oppretter et utkast med status «Påbegynt søknad». Kompletteres når selve søknaden kommer inn på /soknad (match på mobil → e-post → navn).
                }
                else
                {
                    @:Mottar lånesøknader (finansielle data + fødselsnummer) fra ekstern leverandør og mapper dem til kundekort.
                }
            </p>

            <div class="kv-list" style="margin-bottom:16px">
                <span class="k">Endepunkt</span>
                <span class="v">POST @Url</span>
                <span class="k">Autentisering</span>
                <span class="v">Authorization: Bearer &lt;token&gt;</span>
                <span class="k">Format</span>
                <span class="v">application/json</span>
                <span class="k">Token</span>
                <span>
                    @if (Hook is null)
                    {
                        <span class="muted">Genereres ved oppstart…</span>
                    }
                    else
                    {
                        <span class="token-row">
                            <span class="token-val">@(_showToken ? Hook.Token : "whk_••••••••••••••••••••••••")</span>
                            <button class="btn-sm" @onclick="() => _showToken = !_showToken">@(_showToken ? "Skjul" : "Vis")</button>
                        </span>
                    }
                </span>
            </div>

            <div style="margin-bottom:18px">
                <span class="sec-badge">🔒 HTTPS påkrevd (TLS)</span>
                <span class="sec-badge">🔑 Token (konstant-tid)</span>
                <span class="sec-badge">🇪🇺 EU-lagring</span>
                <span class="sec-badge">🛡️ RLS — kun server</span>
                <span class="sec-badge">🙈 Ingen PII i logg</span>
            </div>

            <h3 class="ww-h">Dataflyt</h3>
            @if (ErVipps)
            {
                <ol class="flow-steps" style="margin-bottom:18px">
                    <li>Kunde autentiserer med <strong>Vipps</strong> → leverandør sender <strong>POST</strong> med JSON hit over HTTPS.</li>
                    <li>Autentiseres med <strong>Bearer-token</strong> (kun denne kanalens token godtas).</li>
                    <li>Det opprettes et <strong>utkast</strong> med status <strong>«Påbegynt søknad»</strong> (navn, mobil, e-post, adresse m.m.).</li>
                    <li>Når kunden fullfører skjemaet (mottas på <code>/soknad</code>), <strong>matches</strong> det mot utkastet på <strong>mobil → e-post → navn</strong>.</li>
                    <li>Ved treff kompletteres utkastet og status løftes til <strong>«Åpen»</strong>.</li>
                </ol>
            }
            else
            {
                <ol class="flow-steps" style="margin-bottom:18px">
                    <li>Leverandør sender <strong>POST</strong> med JSON til endepunktet over <strong>HTTPS</strong>.</li>
                    <li>Forespørselen autentiseres med <strong>Bearer-token</strong> (konstant-tid). Ugyldig token → <code>401</code>.</li>
                    <li>Payloaden <strong>mappes til et kundekort</strong> (fødselsnummer for B2C; for B2B sendes <code>orgnr</code> som eget felt og vises i «Orgnr»-kolonnen).</li>
                    <li>Kundekortet lagres i <strong>Supabase</strong> (EU, Postgres) med RLS — kun serveren har tilgang.</li>
                    <li>Søknaden dukker opp i <strong>Database</strong>-fanen og kan rutes videre via Logikk-matrise.</li>
                </ol>
            }

            <h3 class="ww-h">Payload — send til utvikler</h3>
            <pre class="code-block">curl -X POST @Url \
  -H "Authorization: Bearer @(Hook?.Token ?? "<token>")" \
  -H "Content-Type: application/json" \
  -d '@(ErVipps ? VippsPayloadExample : PayloadExample)'</pre>
        </div>
    }
</div>

@code {
    [Parameter] public Webhook? Hook { get; set; }
    [Parameter] public string Url { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    /// <summary>Vipps-bekreftelseskanal — viser Vipps-payloadformat og «påbegynt søknad»-flyt.</summary>
    [Parameter] public bool ErVipps { get; set; }

    private bool _open;
    private bool _showToken;

    // Faktisk Vipps-payloadformat (feltnavn som Vipps sender).
    private const string VippsPayloadExample = """
{
  "FullName": "Ola Nordmann",
  "CompanyName": "Ola Nordmann",
  "CellPhone": "90012345",
  "Email": "ola.nordmann@example.no",
  "OrderNumber": "9001234500",
  "CustomerType": "B2C",
  "Source": "VIPPS",
  "Address": "Storgata 1\nH0101",
  "ZipCode": "0150"
}
""";

    private const string PayloadExample = """
