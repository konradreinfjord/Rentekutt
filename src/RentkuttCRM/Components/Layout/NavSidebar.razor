        </div>
        }
    </nav>

    <div class="sidebar-footer">
        <div class="footer-user">
            <div class="footer-avatar">@Initials(Session.UserName)</div>
            <div class="footer-meta">
                <span class="footer-name">@Session.UserName</span>
                <span class="footer-role">@Session.Role</span>
            </div>
        </div>
    </div>
</aside>

@code {
    private int _antAlarmer;
    private int _antBugs;

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAdmin)
        {
            _antAlarmer = await Alarmer.AntallAapneAsync();
            // Varsel = kun ubehandlede (ikke_registrert) bugs.
            _antBugs = (await Bugs.GetBugsAsync()).Count(b => b.Status == BugService.StatusIkkeRegistrert);
        }
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "–";
        var at = name.IndexOf('@');
        var s = at > 0 ? name[..at] : name;
        var parts = s.Split(new[] { ' ', '.', '-', '_' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "–";
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[^1][..1]).ToUpper();
    }
}
