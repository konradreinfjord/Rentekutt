@inherits LayoutComponentBase
@implements IDisposable
@inject RentkuttCRM.Services.SessionState Session
@inject RentkuttCRM.Services.SupabaseUserService Users
@inject RentkuttCRM.Services.LinkMobilityService LinkMobility
@inject RentkuttCRM.Services.EventService Events
@inject NavigationManager Nav
@inject ProtectedLocalStorage LocalStorage

<style>
    /* Notifikasjonssenter for kundesvar (SMS) i topplinja. */
    .sms-varsel { position: relative; cursor: pointer; display: inline-flex; align-items: center; padding: 4px 6px; border-radius: 8px; }
    .sms-varsel:hover { background: rgba(0,0,0,.05); }
    .sms-varsel-ikon { font-size: 18px; line-height: 1; }
    .sms-varsel-teller { position: absolute; top: -2px; right: -2px; min-width: 16px; height: 16px; padding: 0 4px;
        border-radius: 999px; background: #e5484d; color: #fff; font-size: 10px; font-weight: 800; line-height: 16px; text-align: center; }
    .sms-varsel-panel { position: absolute; top: 120%; right: 0; z-index: 50; width: 320px; max-height: 420px; overflow-y: auto;
        background: #fff; border: 1px solid #e3e8ef; border-radius: 12px; box-shadow: 0 12px 32px -8px rgba(16,24,40,.28); padding: 8px; }
    .sms-varsel-tit { display: flex; align-items: center; justify-content: space-between; font-weight: 700; font-size: 13px; padding: 4px 8px 8px; color: #1f2937; }
    .sms-varsel-ref { border: none; background: none; cursor: pointer; font-size: 15px; color: #64748b; }
    .sms-varsel-tom { padding: 10px 8px; color: #64748b; font-size: 13px; }
    .sms-varsel-rad { position: relative; padding: 8px 34px 8px 10px; border-radius: 8px; }
    .sms-varsel-kvitt { position: absolute; top: 8px; right: 8px; width: 22px; height: 22px; border-radius: 50%;
        border: 1px solid #c7ecd3; background: #e8f6ed; color: #1b7f3b; font-size: 12px; font-weight: 800; cursor: pointer; line-height: 1; }
    .sms-varsel-kvitt:hover { background: #1b7f3b; color: #fff; border-color: #1b7f3b; }
    .sms-varsel-rad.klikk { cursor: pointer; }
    .sms-varsel-rad.klikk:hover { background: #f4f6f9; }
    .sms-varsel-navn { font-weight: 600; font-size: 13px; color: #1f2937; }
    .sms-varsel-tekst { font-size: 12.5px; color: #475467; margin-top: 1px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sms-varsel-tid { font-size: 11px; color: #98a2b3; margin-top: 2px; }
</style>

@if (!_ready)
{
    @* Vent til sesjonen er gjenopprettet fra nettleseren før noe rendres —
       ellers rekker en beskyttet side å sende oss til /login ved refresh. *@
    <div class="app-boot"></div>
}
else if (!Session.IsLoggedIn)
{
    @* Login og andre åpne sider vises uten skall *@
    @Body
}
else
{
    <div class="app-shell">
        <NavSidebar />
        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-left">
                    <TopbarKlokke />
                    @if (_issues.Count > 0)
                    {
                        <div class="health health-feil"
                             title="@($"{_issues.Count} tekniske feil")"
                             @onclick="() => _healthOpen = !_healthOpen">
                            <span class="health-icon">⚠</span>
                            <span class="health-count">@_issues.Count</span>
                            @if (_healthOpen)
                            {
                                <div class="health-panel" @onclick:stopPropagation="true">
                                    <div class="health-panel-title feil">@_issues.Count tekniske feil</div>
                                    @foreach (var i in _issues)
                                    {
                                        <div class="health-item">
                                            <span class="lampe off"></span>
                                            <div><strong>@i.Navn</strong><div class="health-item-msg">@i.Melding</div></div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <SmsVarsler />
                </div>
                <div class="topbar-user">
                    <button class="btn-bredde @(_wide ? "aktiv" : "")"
                            title="@(_wide ? "Avslutt bredmodus" : "Bredmodus — strekk siden ut i full bredde")"
                            aria-label="Veksle bredmodus"
                            @onclick="ToggleBredde">⛶</button>
                    <span class="user-name">@Session.UserName</span>
                    <span class="user-role">@Session.Role</span>
                    <button class="btn-logout" @onclick="LogOut">Logg ut</button>
                </div>
            </header>
            <RingeBar />
            <main class="app-content @(_wide ? "wide" : "")">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>@Body</ChildContent>
                    <ErrorContent>
                        <div class="form-card" style="max-width:520px;margin:40px auto;text-align:center">
                            <h2>Noe gikk galt</h2>
                            <p class="page-sub">Siden støtte på en uventet feil. Prøv igjen, eller gå tilbake til dashbordet.</p>
                            <button class="btn-primary" @onclick="NullstillFeil">Prøv igjen</button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </main>
        </div>
    </div>
}

@code {
    private System.Threading.Timer? _timer;
    private ErrorBoundary? _errorBoundary;

    private List<(string Navn, string Melding)> _issues = new();
    private bool _healthOpen;
    private bool _ready;
    private bool _wide;   // bredmodus — strekker siden ut i full bredde (lagres per agent i nettleseren)
    private const string WideKey = "rk_widemode";

    // Gjenopprett innloggingen fra kryptert nettleserlagring ved oppstart av circuiten
    // (skjer også ved full refresh, siden in-memory SessionState da er tom). JS-interop er
    // først tilgjengelig etter første render, derfor OnAfterRenderAsync.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (!Session.IsLoggedIn)
            {
                var res = await LocalStorage.GetAsync<PersistertSesjon>("rk_session");
                if (res is { Success: true, Value: { } s })
                {
                    Session.SignIn(new UserRow(s.Id, s.Email, s.Navn, s.Rolle, true));
                    // Gjenopprettet økt (ny fane/refresh) = agenten er aktiv i systemet — teller i arbeidstid.
                    await Events.LogAsync("Innlogging", s.Navn + " (gjenopprettet økt)", s.Email);
                }
            }
            // Gjenopprett agentens bredmodus-valg (lagret i nettleseren ved første bruk).
            var wide = await LocalStorage.GetAsync<bool>(WideKey);
            if (wide is { Success: true, Value: true }) _wide = true;
        }
        catch { /* korrupt/utløpt lagring → forbli utlogget / standardbredde */ }
        finally
        {
            _ready = true;
            StateHasChanged();
        }
    }

    // Sjekk om noen tekniske overføringer feiler (vises som varsellampe i headeren).
    private void SjekkHelse()
    {
        // Varsellampa skal kun lyse ved reelle tekniske alarmer (manglende konfigurasjon/tilkobling).
        // Vi varsler IKKE på «ingen innkommende trafikk siste N døgn» — lav leadvolum er ikke en feil.
        var issues = new List<(string, string)>();
        if (!Users.IsConfigured) issues.Add(("Database (Supabase)", "Ikke konfigurert / ikke tilkoblet"));
        if (!LinkMobility.ErKonfigurert) issues.Add(("LinkMobility", "SMS/2FA ikke konfigurert"));
        _issues = issues;
    }

    private void NullstillFeil() => _errorBoundary?.Recover();

    // Nullstill feilgrensen ved navigasjon, så en feil på én side ikke henger igjen.
    protected override void OnParametersSet() => _errorBoundary?.Recover();

    protected override void OnInitialized()
    {
        // Helsesjekk hvert 30. sek. Klokka bor i egen komponent (TopbarKlokke) slik at
        // sekund-oppdateringen IKKE re-rendrer hele siden (som nullstilte felt under skriving).
        _timer = new System.Threading.Timer(async _ =>
        {
            if (!Session.IsLoggedIn) return;
            SjekkHelse();
            await InvokeAsync(StateHasChanged);
        }, null, 0, 30000);
    }

    // Veksle bredmodus og lagre valget per agent (nettleserlagring — overlever refresh/innlogging).
    private async Task ToggleBredde()
    {
        _wide = !_wide;
        try { await LocalStorage.SetAsync(WideKey, _wide); }
        catch { /* lagring feilet → gjelder i det minste for denne økten */ }
    }

    private async Task LogOut()
    {
        try { await LocalStorage.DeleteAsync("rk_session"); } catch { /* fjernes uansett ved SignOut */ }
        await Events.LogAsync("Utlogging", Session.UserName, Session.Email);
        Session.SignOut();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose() => _timer?.Dispose();
}
