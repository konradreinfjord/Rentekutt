@implements IDisposable
@inject RentkuttCRM.Services.DialerCallService Dialer

<div class="ringebar @(Dialer.Aktiv is null ? "rb-idle" : "rb-aktiv")">
    @if (Dialer.Aktiv is { } a)
    {
        <span class="rb-badge rb-@(a.Tilstand.ToString().ToLowerInvariant())">@StatusTekst(a)</span>
        <span class="rb-nr">📞 @a.Nummer</span>
        <span class="rb-timer">@Varighet(a)</span>
        @if (a.Tilstand is RentkuttCRM.Services.DialerCallService.Tilstand.Ringer or RentkuttCRM.Services.DialerCallService.Tilstand.Besvart)
        {
            <button class="rb-btn rb-kutt" @onclick="Kutt" disabled="@_jobber"
                    title="Kutter samtalen ved å logge agenten AV i Zisson (agenten må logge inn igjen i softphone)">
                @(_jobber ? "…" : "✕ Kutt")
            </button>
        }
        else
        {
            <button class="rb-btn" @onclick="() => Dialer.Lukk()">Lukk</button>
        }
        @if (!string.IsNullOrWhiteSpace(a.Melding)) { <span class="rb-msg">@a.Melding</span> }
    }
    else
    {
        <span class="rb-status" title="@StatusTittel">
            <span class="rb-dot @(Dialer.Paalogget == true ? "on" : Dialer.Paalogget == false ? "off" : "ukjent")"></span>
            <span class="rb-status-tekst">@(Dialer.Paalogget == true ? "Pålogget Zisson" : Dialer.Paalogget == false ? "Ikke pålogget Zisson" : "Zisson…")</span>
            <button class="rb-refresh" @onclick="Oppdater" disabled="@_sjekker" title="Sjekk pålogging mot Zisson på nytt">@(_sjekker ? "…" : "⟳")</button>
        </span>

        <span class="rb-sep"></span>
        <span class="rb-label">Ring:</span>
        <input class="rb-input" @bind="_nr" @bind:event="oninput" placeholder="mobilnummer…"
               @onkeydown="Enter" />
        <button class="rb-btn rb-ring" @onclick="Ring" disabled="@(_jobber || string.IsNullOrWhiteSpace(_nr))">
            @(_jobber ? "Ringer…" : "📞 Ring")
        </button>
        @if (!string.IsNullOrWhiteSpace(_msg)) { <span class="rb-msg">@_msg</span> }
    }
</div>

<style>
    .ringebar { display:flex; align-items:center; gap:10px; padding:6px 16px; font-size:13px;
                border-bottom:1px solid var(--border,#e5e7eb); background:var(--card,#fff); min-height:38px; }
    .ringebar.rb-aktiv { background:#f0f9ff; }
    .rb-label { color:#64748b; }
    .rb-input { width:170px; padding:4px 8px; border:1px solid var(--border,#cbd5e1); border-radius:6px; font-size:13px; }
    .rb-btn { padding:4px 12px; border:1px solid var(--border,#cbd5e1); border-radius:6px; background:#fff; cursor:pointer; font-size:13px; }
    .rb-btn:disabled { opacity:.55; cursor:default; }
    .rb-ring { background:#16a34a; color:#fff; border-color:#16a34a; }
    .rb-kutt { background:#dc2626; color:#fff; border-color:#dc2626; }
    .rb-nr { font-weight:600; }
    .rb-timer { font-variant-numeric:tabular-nums; font-weight:600; color:#0f172a; }
    .rb-msg { color:#64748b; }
    .rb-status { display:flex; align-items:center; gap:6px; }
    .rb-status-tekst { color:#475569; }
    .rb-dot { width:9px; height:9px; border-radius:50%; display:inline-block; }
    .rb-dot.on { background:#16a34a; box-shadow:0 0 0 3px rgba(22,163,74,.18); }
    .rb-dot.off { background:#dc2626; }
    .rb-dot.ukjent { background:#cbd5e1; }
    .rb-refresh { border:none; background:none; cursor:pointer; font-size:13px; color:#64748b; padding:0 2px; }
    .rb-sep { width:1px; height:20px; background:var(--border,#e5e7eb); margin:0 4px; }
    .rb-badge { padding:2px 8px; border-radius:999px; font-size:12px; font-weight:600; }
    .rb-ringer   { background:#fef9c3; color:#854d0e; }
    .rb-besvart  { background:#dcfce7; color:#166534; }
    .rb-avsluttet{ background:#e2e8f0; color:#334155; }
    .rb-feil     { background:#fee2e2; color:#991b1b; }
</style>

@code {
    private string? _nr;
    private string? _msg;
    private bool _jobber;
    private bool _sjekker;

    protected override void OnInitialized() => Dialer.OnChange += Endret;

    // Sjekk pålogging én gang når baren lastes (API-kall → etter første render).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Dialer.Paalogget is null && Dialer.Aktiv is null)
            await Oppdater();
    }

    private async Task Oppdater()
    {
        _sjekker = true;
        try { await Dialer.SjekkPaaloggingAsync(); }
        finally { _sjekker = false; }
    }

    private string StatusTittel => Dialer.Paalogget switch
    {
        true => "Agenten er pålogget Zisson — click-to-call kan ringe.",
        false => "Agenten er ikke pålogget Zisson. Logg inn i softphone/agentklienten før du ringer.",
        _ => "Sjekker pålogging mot Zisson…",
    };

    private void Endret() => InvokeAsync(StateHasChanged);

    private async Task Ring()
    {
        if (string.IsNullOrWhiteSpace(_nr)) return;
        _jobber = true; _msg = null;
        try
        {
            var r = await Dialer.RingAsync(_nr!.Trim());
            _msg = r.Ok ? null : r.Melding;
            if (r.Ok) _nr = null;
        }
        finally { _jobber = false; }
    }

    private async Task Kutt()
    {
        _jobber = true;
        try { await Dialer.KuttAsync(); }
        finally { _jobber = false; }
    }

    private async Task Enter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Ring();
    }

    private static string StatusTekst(RentkuttCRM.Services.DialerCallService.Anrop a) => a.Tilstand switch
    {
        RentkuttCRM.Services.DialerCallService.Tilstand.Ringer => "Ringer opp…",
        RentkuttCRM.Services.DialerCallService.Tilstand.Besvart => "Samtale pågår",
        RentkuttCRM.Services.DialerCallService.Tilstand.Avsluttet => "Avsluttet",
        _ => "Feil",
    };

    private static string Varighet(RentkuttCRM.Services.DialerCallService.Anrop a)
    {
        var s = a.Tilstand == RentkuttCRM.Services.DialerCallService.Tilstand.Avsluttet && a.TaletidSek is int t ? t : a.GaattSek;
        return $"{s / 60}:{s % 60:00}";
    }

    public void Dispose() => Dialer.OnChange -= Endret;
}
