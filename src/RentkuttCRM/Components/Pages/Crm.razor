@page "/crm"
@inject RentkuttCRM.Services.SessionState Session
@inject RentkuttCRM.Services.KundekortService Svc
@inject NavigationManager Nav

<PageTitle>Dashbord — Rentekutt</PageTitle>

<div class="dash-head">
    <div>
        <h1 class="page-title">Hei, @Fornavn 👋</h1>
    </div>
</div>

@if (_loading)
{
    <p class="page-sub">Laster…</p>
}
else
{
    @* Nøkkeltall — øverst *@
    <div class="panel" style="margin-bottom:16px">
        <div class="panel-head"><div><h2>Nøkkeltall</h2><span class="sub">Porteføljen i tall</span></div></div>
        <div class="mcards">
            <div class="mcard" style="--a:#1f5fc4">
                <span class="mcard-ic"><svg viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg></span>
                <div><div class="mcard-num">@_rows.Count</div><div class="mcard-lbl">Totalt søknader</div><div class="mcard-new-line">I dag +@_nyeIDag · Uke +@_nyeDenneUke · Måned +@_nyeDenneMaaned · År +@_nyeDetteAar</div><div class="mcard-sub">@_b2c privat · @_b2b bedrift</div></div>
            </div>
            <div class="mcard" style="--a:#c2740a">
                <span class="mcard-ic"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                <div><div class="mcard-num">@_eierskapPct<span class="u">%</span></div><div class="mcard-lbl">Med eierskap</div><div class="mcard-new-line">I dag +@_eierTattIDag · Uke +@_eierTattUke · Måned +@_eierTattMaaned · År +@_eierTattAar</div><div class="mcard-sub">@_medEierskap av @_rows.Count har rådgiver</div></div>
            </div>
            <div class="mcard" style="--a:#266f32">
                <span class="mcard-ic"><svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></span>
                <div><div class="mcard-num">@_ferdigstilt</div><div class="mcard-lbl">Søknader ferdigstilt</div><div class="mcard-new-line">I dag +@_ferdigIDag · Uke +@_ferdigUke · Måned +@_ferdigMaaned · År +@_ferdigAar</div><div class="mcard-sub">@_ferdigstiltPct % av alle · @_utbetalt utbetalt</div></div>
            </div>
        </div>

        <div class="dist-cards">
            @{
                var _kildeSum = _kildeAlle.Sum(x => x.Antall);
                var _laanSum = _laanetypeAlle.Sum(x => x.Antall);
            }
            @{
                var _pipeAnt = _pipelineMedAntall + _pipelineUtenAntall;
                var _pipeTotal = _pipeline + _pipelineEstimert;
            }
            <div class="dcard dcard-wide">
                <div class="dcard-head">
                    <span class="mcard-ic" style="--a:#0e7490"><svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></span>
                    <div><div class="dcard-title">Pipeline</div><div class="dcard-sub">Estimert total @Mnok(_pipeTotal) · @_pipeAnt saker</div></div>
                </div>
                @{
                    var _oppgPct = _pipeTotal > 0 ? (double)(_pipeline / _pipeTotal) * 100 : 0;
                    var _estPct = 100 - _oppgPct;
                }
                <div class="pl-splitbar">
                    <span style="width:@_oppgPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; background:#0e7490"></span>
                    <span style="width:@_estPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; background:#1f5fc4"></span>
                </div>
                <div class="pl-splitlegend">
                    <span><span class="d" style="background:#0e7490"></span>Oppgitt <b>@Mnok(_pipeline)</b> · @($"{_oppgPct:0}") %</span>
                    <span><span class="d" style="background:#1f5fc4"></span>Estimert <b>@Mnok(_pipelineEstimert)</b> · @($"{_estPct:0}") %</span>
                </div>

                @* Oppgitt beløp *@
                <div class="pl-sec">
                    <div class="pl-sec-head"><span class="pl-dot" style="background:#0e7490"></span><span class="pl-sec-t">Oppgitt beløp</span><span class="pl-sec-meta">@_pipelineMedAntall saker</span><span class="pl-sec-sum">@Mnok(_pipeline)</span></div>
                    <div class="pl-kt"><span>B2C <b>@MnokTall(_oppgittB2C)</b></span><span>B2B <b>@MnokTall(_oppgittB2B)</b></span></div>
                    <div class="pl-tab">
                        @foreach (var r in _pipeLaanRader.Where(r => r.OppgittAntall > 0))
                        {
                            <div class="pl-tr">
                                <span class="pl-tn"><span class="d" style="background:@LaanetypeFarge(r.Navn)"></span>@r.Navn</span>
                                <span class="pl-tmeta">@r.OppgittAntall saker · snitt @KrKort(r.Snitt)</span>
                                <span class="pl-ts">@MnokTall(r.OppgittSum)</span>
                            </div>
                        }
                    </div>
                </div>

                @* Estimert *@
                <div class="pl-sec">
                    <div class="pl-sec-head"><span class="pl-dot" style="background:#1f5fc4"></span><span class="pl-sec-t">Estimert – uten beløp</span><span class="pl-sec-meta">@_pipelineUtenAntall saker</span><span class="pl-sec-sum est">+@Mnok(_pipelineEstimert)</span></div>
                    <div class="pl-kt"><span>B2C <b>@MnokTall(_estB2C)</b></span><span>B2B <b>@MnokTall(_estB2B)</b></span></div>
                    <div class="pl-tab">
                        @foreach (var r in _pipeLaanRader.Where(r => r.UtenAntall > 0))
                        {
                            <div class="pl-tr">
                                <span class="pl-tn"><span class="d" style="background:@LaanetypeFarge(r.Navn)"></span>@r.Navn</span>
                                <span class="pl-tmeta">@r.UtenAntall saker · snitt @KrKort(r.Snitt)</span>
                                <span class="pl-ts est">@MnokTall(r.EstSum)</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="pl-unit">Snitt per sak i kr (k = tusen, M = million)</div>

                @* Fordeling — leadskilde og lånetype flettet inn *@
                <div class="pl-ford">
                    <div class="pl-ford-col">
                        <div class="pl-ford-h">Leadskilde <span>@_kildeSum leads</span></div>
                        <div class="distbar">
                            @foreach (var (navn, antall) in _kildeAlle)
                            {
                                <span style="width:@(((double)antall / Math.Max(1, _kildeSum) * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background:@KildeFarge(navn)" title="@navn: @antall"></span>
                            }
                        </div>
                        <div class="dist-legend">
                            @foreach (var (navn, antall) in _kildeAlle)
                            {
                                <span class="i"><span class="d" style="background:@KildeFarge(navn)"></span>@navn <b>@antall</b> <span class="pct">@(_kildeSum > 0 ? (int)Math.Round((double)antall / _kildeSum * 100) : 0) %</span></span>
                            }
                        </div>
                    </div>
                    <div class="pl-ford-col">
                        <div class="pl-ford-h">Lånetype <span>@_laanSum leads</span></div>
                        <div class="distbar">
                            @foreach (var (navn, antall) in _laanetypeAlle)
                            {
                                <span style="width:@(((double)antall / Math.Max(1, _laanSum) * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background:@LaanetypeFarge(navn)" title="@navn: @antall"></span>
                            }
                        </div>
                        <div class="dist-legend">
                            @foreach (var (navn, antall) in _laanetypeAlle)
                            {
                                <span class="i"><span class="d" style="background:@LaanetypeFarge(navn)"></span>@navn <b>@antall</b> <span class="pct">@(_laanSum > 0 ? (int)Math.Round((double)antall / _laanSum * 100) : 0) %</span></span>
                            }
                        </div>
                        @if (_ukjentKilde.Count > 0)
                        {
                            <div class="pl-ukjent">«Ukjent» = leads uten valgt lånetype · kilde: @string.Join(" · ", _ukjentKilde.Select(x => $"{x.Navn} {x.Antall}"))</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Leads siste 30 dager — hovedtrend øverst *@
    <div class="panel" style="margin-bottom:16px">
        <div class="panel-head">
            <div><h2>Leads siste 30 dager</h2><span class="sub">Søknader per dag · antall og <span style="color:#2f8a3e;font-weight:600">andel med eierskap</span> under hver bar · hold over for status og lånetype</span></div>
            <span class="panel-count">@_dager.Sum(d => d.Total) leads</span>
        </div>
        <div class="daybar-chart daybar-slim daybar-solid">
            @foreach (var dag in _dager)
            {
                <div class="daybar-col">
                    @if (dag.Total > 0)
                    {
                        <div class="daybar-tip">
                            <div class="tip-title">@dag.Label · @dag.Total leads · @dag.MedEier med eierskap</div>
                            <div class="tip-sec">
                                <div class="tip-h">Status</div>
                                @foreach (var st in _statuser)
                                {
                                    var c = dag.PerStatus.GetValueOrDefault(st, 0);
                                    @if (c > 0)
                                    {
                                        <div class="tip-row"><span class="d" style="background:@StatusFarge(st)"></span><span class="tip-n">@st</span><span class="tip-v">@c</span></div>
                                    }
                                }
                            </div>
                            <div class="tip-sec">
                                <div class="tip-h">Lånetype</div>
                                @foreach (var (type, antall) in dag.PerLaanetype.OrderByDescending(x => x.Value))
                                {
                                    <div class="tip-row"><span class="d" style="background:@LaanetypeFarge(type)"></span><span class="tip-n">@type</span><span class="tip-v">@antall</span></div>
                                }
                            </div>
                            <div class="tip-sec">
                                <div class="tip-h">Leadskilde</div>
                                @foreach (var (kilde, antall) in dag.PerKilde.OrderByDescending(x => x.Value))
                                {
                                    <div class="tip-row"><span class="d" style="background:@KildeFarge(kilde)"></span><span class="tip-n">@kilde</span><span class="tip-v">@antall</span></div>
                                }
                            </div>
                        </div>
                    }
                    <div class="daybar-stack">
                        @if (dag.Total > 0)
                        {
                            <div class="daybar-seg" style="height:@(((double)dag.Total / _maxDag * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="daybar-labels">
            @foreach (var dag in _dager)
            {
                <span class="dl" title="@dag.MedEier av @dag.Total med eierskap">
                    <span class="dl-date">@dag.Label</span>
                    <span class="dl-num @(dag.Total == 0 ? "nil" : "")">@dag.Total</span>
                    <span class="dl-eier @(dag.Total == 0 ? "nil" : "")">@(dag.Total > 0 ? (int)Math.Round(dag.MedEier * 100.0 / dag.Total) + " %" : "–")</span>
                </span>
            }
        </div>
    </div>

    @* Trakt — hvor leadsene står i løpet (siste 30 dager) *@
    <div class="panel" style="margin-bottom:16px">
        <div class="panel-head">
            <div><h2>Trakt — siste 30 dager <span class="fn-total">(@_funnelTot totalt)</span></h2><span class="sub">Hvor leadsene står i løpet, fra inngang til utbetaling</span></div>
        </div>
        <div class="funnel">
            @foreach (var steg in _funnel)
            {
                var tot = steg.Subs.Sum(x => _statusCount30.GetValueOrDefault(x, 0));
                var totAll = steg.Subs.Sum(x => _statusCountAll.GetValueOrDefault(x, 0));
                var vol30 = steg.Subs.Sum(x => _statusVolum30.GetValueOrDefault(x, 0m));
                var volAll = steg.Subs.Sum(x => _statusVolumAll.GetValueOrDefault(x, 0m));
                var liggeSum = steg.Subs.Sum(x => _statusLiggetidSum.GetValueOrDefault(x, 0.0));
                var snittLigge = totAll > 0 ? liggeSum / totAll : 0.0;
                var w = Math.Max(56, (int)Math.Round((double)tot / _funnelMax * 100));
                var andel = _funnelTot > 0 ? (int)Math.Round((double)tot / _funnelTot * 100) : 0;
                <div class="fn-step" style="--c:@steg.Farge">
                    <div class="fn-subs">
                        @foreach (var sub in steg.Subs)
                        {
                            var n = _statusCount30.GetValueOrDefault(sub, 0);
                            <span class="fn-sub @(n == 0 ? "nil" : "")"><span class="dot" style="background:@StatusFarge(sub)"></span>@sub <b>@n</b></span>
                        }
                        <div class="fn-vol">
                            <div class="fn-vol-row"><span class="fn-vol-lbl">Lånevolum</span><span class="fn-vol-val">@Mnok(vol30)</span></div>
                            <div class="fn-vol-row"><span class="fn-vol-lbl">Totalt</span><span class="fn-vol-val muted">@Mnok(volAll)</span></div>
                        </div>
                    </div>
                    <div class="fn-barwrap">
                        <div class="fn-steg-navn">@steg.Navn</div>
                        <div class="fn-bar" style="width:@w%">
                            <span class="fn-num">@tot</span>
                            <span class="fn-badges">
                                <span class="fn-pct">@andel %</span>
                                <span class="fn-alltime" title="Totalt gjennom tidene">@totAll totalt</span>
                            </span>
                        </div>
                    </div>
                    <div class="fn-snitt" title="Snitt tid siden sist endring for sakene som står i dette steget nå">
                        <div class="fn-snitt-val">@Liggetid(snittLigge)</div>
                        <div class="fn-snitt-lbl">snitt liggetid</div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<Kundekort> _rows = new();
    private Dictionary<string, int> _statusCount30 = new();
    private List<(string Kilde, int Antall)> _kildeIDag = new();
    private List<(string Type, int Antall)> _laanetype30 = new();
    private List<(string Kilde, int Antall)> _kilde30 = new();
    private List<(string Navn, int Antall)> _kildeAlle = new();
    private List<(string Navn, int Antall)> _laanetypeAlle = new();
    private List<(string Navn, int Antall)> _ukjentKilde = new();

    private static string LaanetypeFarge(string type) => type switch
    {
        "Forbrukslån" => "#6b3fc4",
        "Refinansiering" => "#1f5fc4",
        "Boliglån" => "#266f32",
        "Kredittkort" => "#c2740a",
        "Mellomfinansiering" => "#0e7490",
        _ => "#9aa0a8",
    };

    private static string KildeFarge(string kilde) => kilde switch
    {
        "Rentekutt.no" => "#1f5fc4",
        "Prismatch" => "#6b3fc4",
        "Ukjent" => "#9aa0a8",
        _ => "#0e7490",
    };
    private int _nyeIDag;
    private int _mine;
    private decimal _pipeline, _pipelineSnitt, _pipelineEstimert;
    private int _pipelineUtenAntall, _pipelineMedAntall;
    private decimal _oppgittB2C, _oppgittB2B, _estB2C, _estB2B;
    private record PipeRad(string Navn, int OppgittAntall, decimal OppgittSum, decimal Snitt, int UtenAntall, decimal EstSum);
    private List<PipeRad> _pipeLaanRader = new();

    private static string MnokTall(decimal v) => (v / 1_000_000m).ToString("N1");
    private static string KrKort(decimal v) => v >= 1_000_000m ? (v / 1_000_000m).ToString("N1") + " M" : (v / 1000m).ToString("N0") + " k";
    private bool _loading = true;

    // Pågår hos rådgiver = eide, aktive saker (ikke fullført/avslått).
    private int _eideAktive;
    private TimeSpan _eldsteAlder, _snittAlder;

    // Ferdigbehandlet-andel.
    private int _utbetalt, _avslatt, _ferdigPct;

    // Fullføringsgrad rentekutt.no: påbegynte søknader som er fullført (satt til «Ny søknad» / videre).
    private int _fullfortPct, _fullfortAntall, _fullfortBase;
    private List<UkeBar> _fullfortUker = new();
    private record UkeBar(string Label, int Pct, int Fullfort, int Total);

    // Kun rentekutt.no-leads (både påbegynt-utkast og fullførte får kilde «Rentekutt.no»); ekskluderer Prismatch.
    private static bool ErRentekutt(Kundekort k) => (k.Kilde ?? "").Contains("rentekutt", StringComparison.OrdinalIgnoreCase);
    // Fullført = har passert «Påbegynt søknad» (kunden fullførte skjemaet).
    private static bool ErFullfort(Kundekort k) => k.Status != KundekortService.StatusPaabegynt;

    // Eierskap tatt per dag (siste 30).
    private List<EierBar> _eierDager = new();
    private int _maxEierDag = 1;
    private record EierBar(string Label, int Antall);

    private static string Alder(TimeSpan t) =>
        t.TotalDays >= 1
            ? $"{(int)t.TotalDays} d {t.Hours} t"
            : t.TotalHours >= 1 ? $"{(int)t.TotalHours} t" : $"{(int)t.TotalMinutes} min";

    // Utatte saker = ikke plukket (ingen eier) og ikke ferdigbehandlet.
    private int _utatte, _b2c, _b2b, _tekniskFeil, _timeout;
    private int _medEierskap, _eierskapPct, _eierTattIDag, _eierTattUke, _eierTattMaaned, _eierTattAar;
    private int _nyeDenneUke, _nyeDenneMaaned, _nyeDetteAar;
    private int _ferdigIDag, _ferdigUke, _ferdigMaaned, _ferdigAar;
    private int _ferdigstilt, _ferdigstiltPct;

    private List<DagBar> _dager = new();
    private int _maxDag = 1;
    private record DagBar(string Label, Dictionary<string, int> PerStatus, int Total, int MedEier, Dictionary<string, int> PerLaanetype, Dictionary<string, int> PerKilde);

    private readonly string[] _statuser = KundekortService.Statuser;

    private record FunnelSteg(string Navn, string Farge, string Beskrivelse, string[] Subs);

    // Traktsteg fra inngang (topp) til utbetalt (bunn). Statuser som ikke passer et
    // tidligere steg havner i «Frafall».
    private static readonly FunnelSteg[] _funnel =
    {
        new("Nye søknader", "#1f5fc4", "Nye leads som er kommet inn, men ikke sendt videre ennå.", new[] { "Ny søknad", "Nytt lead", "Påbegynt søknad" }),
        new("Pågår", "#6b3fc4", "Sendt til bank og under behandling hos rådgiver.", new[] { "Sendt til bank", "Pågår - Agent" }),
        new("SBL Signert", "#12805a", "Kunden har signert lånesøknaden (SBL).", new[] { "SBL Signert" }),
        new("Frafall", "#b42318", "Saker som er avslått, kansellert eller feilet.", new[] { "Avslag", "Teknisk feil", "Kansellert", "Sendt til bank - Timeout" }),
        new("Utbetalt / godkjent", "#266f32", "Lånet er innvilget og utbetalt.", new[] { "Utbetalt" }),
    };

    private int _funnelTot, _funnelMax = 1;
    private Dictionary<string, int> _statusCountAll = new();
    private Dictionary<string, decimal> _statusVolum30 = new();
    private Dictionary<string, decimal> _statusVolumAll = new();
    private Dictionary<string, double> _statusLiggetidSum = new();

    private static string Mnok(decimal v) => (v / 1_000_000m).ToString("N1") + " MNOK";

    // Snitt liggetid → kort tekst (min/t/d).
    private static string Liggetid(double timer)
    {
        if (timer <= 0) return "–";
        if (timer < 1) return $"{(int)Math.Round(timer * 60)} min";
        if (timer < 48) return $"{(int)Math.Round(timer)} t";
        return $"{(int)Math.Round(timer / 24)} d";
    }

    private static string StatusFarge(string status) => status switch
    {
        "Påbegynt søknad" => "#e0a800",     // gul
        "Nytt lead" => "#e0a800",           // gul
        "Ny søknad" => "#e0a800",           // gul
        "Oppfølging" => "#d97706",
        "Pågår - Agent" => "#1f5fc4",       // blå
        "Sendt til bank" => "#6b3fc4",   // lilla
        "Sendt til bank - Timeout" => "#b42318", // rød
        "SBL Signert" => "#1f5fc4",             // blå
        "Utbetalt" => "#266f32",            // mørk grønn
        "Avslag" => "#b42318",             // rød
        "Avsluttet" => "#5b6b7f",
        "Kansellert" => "#5b6b7f",          // grå
        "Teknisk feil" => "#b42318",        // rød
        _ => "#9aa0a8"
    };

    private string Fornavn => (Session.UserName ?? "der").Split(' ')[0];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        _rows = await Svc.ListLettAsync();

        var na = DateTime.UtcNow;
        // «Dette døgn» = inneværende kalenderdøgn i norsk tid (ikke rullerende 24 timer).
        var iDagOslo = na.TilOslo().Date;
        var iDag = _rows.Where(k => k.CreatedAt.TilOslo().Date == iDagOslo).ToList();
        _nyeIDag = iDag.Count;
        // Denne uke (mandag→) og denne måned (1. →) i norsk tid.
        var ukeStart = iDagOslo.AddDays(-(((int)iDagOslo.DayOfWeek + 6) % 7));
        var mndStart = new DateTime(iDagOslo.Year, iDagOslo.Month, 1);
        var aarStart = new DateTime(iDagOslo.Year, 1, 1);
        _nyeDenneUke = _rows.Count(k => k.CreatedAt.TilOslo().Date >= ukeStart);
        _nyeDenneMaaned = _rows.Count(k => k.CreatedAt.TilOslo().Date >= mndStart);
        _nyeDetteAar = _rows.Count(k => k.CreatedAt.TilOslo().Date >= aarStart);
        _kildeIDag = iDag
            .GroupBy(k => string.IsNullOrWhiteSpace(k.Kilde) ? "Ukjent" : k.Kilde)
            .Select(g => (g.Key, g.Count()))
            .OrderByDescending(x => x.Item2)
            .ToList();

        _mine = _rows.Count(k => !string.IsNullOrWhiteSpace(Session.Email) && k.Eier == Session.Email);
        var pipeAktiv = _rows.Where(k => k.Status is not (KundekortService.StatusUtbetalt or "Avslag")).ToList();
        _pipeline = pipeAktiv.Sum(k => k.OnsketLaanebelop ?? 0);
        var pipeMedBelop = pipeAktiv.Where(k => (k.OnsketLaanebelop ?? 0) > 0).ToList();
        var pipeUtenBelop = pipeAktiv.Where(k => (k.OnsketLaanebelop ?? 0) <= 0).ToList();
        _pipelineSnitt = pipeMedBelop.Count > 0 ? pipeMedBelop.Average(k => k.OnsketLaanebelop!.Value) : 0m;
        _pipelineUtenAntall = pipeUtenBelop.Count;
        _pipelineMedAntall = pipeMedBelop.Count;

        // Snitt PER lånetype (fra sakene som har oppgitt beløp) → estimer manglende per lånetype.
        string LaanNavn(Kundekort k) => string.IsNullOrWhiteSpace(k.Laanetype) ? "Ukjent" : k.Laanetype;
        var snittPerLaan = pipeMedBelop.GroupBy(LaanNavn)
            .ToDictionary(g => g.Key, g => g.Average(k => k.OnsketLaanebelop!.Value));
        decimal SnittFor(string laan) => snittPerLaan.TryGetValue(laan, out var s) ? s : _pipelineSnitt;

        // Rader per lånetype: oppgitt (sum) + estimert (antall uten × snitt for lånetypen).
        var alleLaan = pipeAktiv.Select(LaanNavn).Distinct();
        _pipeLaanRader = alleLaan.Select(navn =>
        {
            var med = pipeMedBelop.Where(k => LaanNavn(k) == navn).ToList();
            var utenN = pipeUtenBelop.Count(k => LaanNavn(k) == navn);
            var snitt = med.Count > 0 ? med.Average(k => k.OnsketLaanebelop!.Value) : _pipelineSnitt;
            return new PipeRad(navn, med.Count, med.Sum(k => k.OnsketLaanebelop!.Value), snitt, utenN, utenN * snitt);
        }).Where(r => r.OppgittAntall > 0 || r.UtenAntall > 0)
          .OrderByDescending(r => r.OppgittSum + r.EstSum).ToList();

        _pipelineEstimert = _pipeLaanRader.Sum(r => r.EstSum);

        // Kundetype: oppgitt = faktisk sum; estimert = sum av hver manglende saks lånetype-snitt.
        _oppgittB2C = pipeMedBelop.Where(k => k.KundeType == "B2C").Sum(k => k.OnsketLaanebelop!.Value);
        _oppgittB2B = pipeMedBelop.Where(k => k.KundeType == "B2B").Sum(k => k.OnsketLaanebelop!.Value);
        _estB2C = pipeUtenBelop.Where(k => k.KundeType == "B2C").Sum(k => SnittFor(LaanNavn(k)));
        _estB2B = pipeUtenBelop.Where(k => k.KundeType == "B2B").Sum(k => SnittFor(LaanNavn(k)));

        // Utatte: ingen eier + fortsatt aktiv (ikke fullført/avslått).
        _utatte = _rows.Count(k => string.IsNullOrWhiteSpace(k.Eier)
                                   && k.Status is not (KundekortService.StatusUtbetalt or "Avslag"));
        _b2c = _rows.Count(k => k.KundeType == "B2C");
        _b2b = _rows.Count(k => k.KundeType == "B2B");

        // Andel av alle søknader som har fått eierskap (tildelt rådgiver).
        _medEierskap = _rows.Count(k => !string.IsNullOrWhiteSpace(k.Eier));
        _eierskapPct = _rows.Count > 0 ? (int)Math.Round(_medEierskap * 100.0 / _rows.Count) : 0;
        _eierTattIDag = _rows.Count(k => k.EierTattAt.HasValue && k.EierTattAt.Value.TilOslo().Date == iDagOslo);
        _eierTattUke = _rows.Count(k => k.EierTattAt.HasValue && k.EierTattAt.Value.TilOslo().Date >= ukeStart);
        _eierTattMaaned = _rows.Count(k => k.EierTattAt.HasValue && k.EierTattAt.Value.TilOslo().Date >= mndStart);
        _eierTattAar = _rows.Count(k => k.EierTattAt.HasValue && k.EierTattAt.Value.TilOslo().Date >= aarStart);

        // Saker som krever handling: feilet sending + timeout mot bank.
        _tekniskFeil = _rows.Count(k => k.Status == KundekortService.StatusTekniskFeil);
        _timeout = _rows.Count(k => k.Status == KundekortService.StatusSendtBankTimeout);

        // Pågår hos rådgiver: har eier + fortsatt aktiv (ikke fullført/avslått).
        var eideAktive = _rows.Where(k => !string.IsNullOrWhiteSpace(k.Eier)
                                          && k.Status is not (KundekortService.StatusUtbetalt or KundekortService.StatusAvslatt))
                              .ToList();
        _eideAktive = eideAktive.Count;
        if (_eideAktive > 0)
        {
            var aldre = eideAktive.Select(k => na - k.CreatedAt.ToUniversalTime()).ToList();
            _eldsteAlder = aldre.Max();
            _snittAlder = TimeSpan.FromTicks((long)aldre.Average(t => t.Ticks));
        }

        // Ferdigbehandlet-andel (utbetalt + avslått av totalt).
        _utbetalt = _rows.Count(k => k.Status == KundekortService.StatusUtbetalt);
        _avslatt = _rows.Count(k => k.Status == KundekortService.StatusAvslatt);
        _ferdigPct = _rows.Count > 0 ? (int)Math.Round((_utbetalt + _avslatt) * 100.0 / _rows.Count) : 0;

        // Ferdigstilte søknader = alle sluttførte/avsluttede saker (terminale statuser).
        var ferdigStatuser = new[] { KundekortService.StatusUtbetalt, KundekortService.StatusAvslatt, "Kansellert" };
        var ferdige = _rows.Where(k => ferdigStatuser.Contains(k.Status)).ToList();
        _ferdigstilt = ferdige.Count;
        _ferdigstiltPct = _rows.Count > 0 ? (int)Math.Round(_ferdigstilt * 100.0 / _rows.Count) : 0;
        // Ferdigstilt per periode — bruker updated_at (≈ tidspunkt saken ble satt til terminalstatus).
        _ferdigIDag = ferdige.Count(k => k.UpdatedAt.TilOslo().Date == iDagOslo);
        _ferdigUke = ferdige.Count(k => k.UpdatedAt.TilOslo().Date >= ukeStart);
        _ferdigMaaned = ferdige.Count(k => k.UpdatedAt.TilOslo().Date >= mndStart);
        _ferdigAar = ferdige.Count(k => k.UpdatedAt.TilOslo().Date >= aarStart);

        // Fullføringsgrad (kun rentekutt.no): andel påbegynte som har fullført søknaden.
        var rk = _rows.Where(ErRentekutt).ToList();
        _fullfortBase = rk.Count;
        _fullfortAntall = rk.Count(ErFullfort);
        _fullfortPct = _fullfortBase > 0 ? (int)Math.Round(_fullfortAntall * 100.0 / _fullfortBase) : 0;

        var idag = Tid.Naa.Date;

        // Ukentlig trend (siste 12 uker, mandag-basert).
        _fullfortUker = new();
        var tilMandag = ((int)idag.DayOfWeek + 6) % 7;   // mandag = 0
        var denneMandag = idag.AddDays(-tilMandag);
        for (var w = 11; w >= 0; w--)
        {
            var start = denneMandag.AddDays(-7 * w);
            var slutt = start.AddDays(7);
            var kohort = rk.Where(k => { var d = k.CreatedAt.TilOslo().Date; return d >= start && d < slutt; }).ToList();
            var full = kohort.Count(ErFullfort);
            var pct = kohort.Count > 0 ? (int)Math.Round(full * 100.0 / kohort.Count) : 0;
            _fullfortUker.Add(new UkeBar(start.ToString("dd.MM"), pct, full, kohort.Count));
        }

        _dager = new();
        for (var i = 29; i >= 0; i--)
        {
            var d = idag.AddDays(-i);
            var dagLeads = _rows.Where(k => k.CreatedAt.TilOslo().Date == d).ToList();
            var perStatus = dagLeads.GroupBy(k => k.Status).ToDictionary(g => g.Key, g => g.Count());
            var perLaan = dagLeads.GroupBy(k => string.IsNullOrWhiteSpace(k.Laanetype) ? "Ukjent" : k.Laanetype).ToDictionary(g => g.Key, g => g.Count());
            var perKilde = dagLeads.GroupBy(k => string.IsNullOrWhiteSpace(k.Kilde) ? "Ukjent" : k.Kilde).ToDictionary(g => g.Key, g => g.Count());
            var label = i == 0 ? "I dag" : i == 1 ? "I går" : d.ToString("dd.MM");
            var medEier = dagLeads.Count(k => !string.IsNullOrWhiteSpace(k.Eier));
            _dager.Add(new DagBar(label, perStatus, dagLeads.Count, medEier, perLaan, perKilde));
        }
        _maxDag = Math.Max(1, _dager.Max(d => d.Total));

        // Eierskap tatt per dag (siste 30).
        _eierDager = new();
        for (var i = 29; i >= 0; i--)
        {
            var d = idag.AddDays(-i);
            var antall = _rows.Count(k => k.EierTattAt.HasValue && k.EierTattAt.Value.TilOslo().Date == d);
            var label = i == 0 ? "I dag" : i == 1 ? "I går" : d.ToString("dd.MM");
            _eierDager.Add(new EierBar(label, antall));
        }
        _maxEierDag = Math.Max(1, _eierDager.Max(d => d.Antall));

        var fra30 = idag.AddDays(-29);
        var siste30 = _rows.Where(k => k.CreatedAt.TilOslo().Date >= fra30).ToList();
        _statusCount30 = siste30.GroupBy(k => k.Status).ToDictionary(g => g.Key, g => g.Count());
        _statusCountAll = _rows.GroupBy(k => k.Status).ToDictionary(g => g.Key, g => g.Count());
        _statusVolum30 = siste30.GroupBy(k => k.Status).ToDictionary(g => g.Key, g => g.Sum(k => k.OnsketLaanebelop ?? 0));
        _statusVolumAll = _rows.GroupBy(k => k.Status).ToDictionary(g => g.Key, g => g.Sum(k => k.OnsketLaanebelop ?? 0));
        // Snitt liggetid per steg: tid siden sist endring (updated_at) for sakene som står der nå.
        _statusLiggetidSum = _rows.GroupBy(k => k.Status)
            .ToDictionary(g => g.Key, g => g.Sum(k => Math.Max(0, (na - k.UpdatedAt.ToUniversalTime()).TotalHours)));

        // Fordeling på leadskilde og lånetype (alle søknader).
        _kildeAlle = _rows.GroupBy(k => string.IsNullOrWhiteSpace(k.Kilde) ? "Ukjent" : k.Kilde)
                          .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ToList();
        _laanetypeAlle = _rows.GroupBy(k => string.IsNullOrWhiteSpace(k.Laanetype) ? "Ukjent" : k.Laanetype)
                              .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ToList();
        // «Ukjent» lånetype = leads uten valgt lånetype — hvilken kilde kommer de fra?
        _ukjentKilde = _rows.Where(k => string.IsNullOrWhiteSpace(k.Laanetype))
                            .GroupBy(k => string.IsNullOrWhiteSpace(k.Kilde) ? "Ukjent" : k.Kilde)
                            .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ToList();
        _funnelTot = _funnel.Sum(s => s.Subs.Sum(x => _statusCount30.GetValueOrDefault(x, 0)));
        _funnelMax = Math.Max(1, _funnel.Max(s => s.Subs.Sum(x => _statusCount30.GetValueOrDefault(x, 0))));
        _laanetype30 = siste30
            .GroupBy(k => string.IsNullOrWhiteSpace(k.Laanetype) ? "Ukjent" : k.Laanetype)
            .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ToList();
        _kilde30 = siste30
            .GroupBy(k => string.IsNullOrWhiteSpace(k.Kilde) ? "Ukjent" : k.Kilde)
            .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ToList();

        _loading = false;
    }
}
