@page "/crm"
@inject RentkuttCRM.Services.SessionState Session
@inject RentkuttCRM.Services.KundekortService Svc
@inject RentkuttCRM.Services.BankSendingService BankSending
@inject RentkuttCRM.Services.DialerService Dialer
@inject RentkuttCRM.Services.LoggService Logg
@inject RentkuttCRM.Services.SupabaseUserService Brukere
@inject NavigationManager Nav

<PageTitle>Dashbord — Rentekutt</PageTitle>

<div class="dash-head">
    <div>
        <h1 class="page-title">Hei, @Fornavn 👋</h1>
    </div>
</div>

@if (_loading)
{
    <p class="page-sub">Laster…</p>
}
else
{
    @* Nøkkeltall — øverst *@
    <div class="panel" style="margin-bottom:16px">
        <div class="panel-head"><div><h2>Nøkkeltall</h2><span class="sub">Porteføljen i tall</span></div></div>
        <div class="mcards">
            <div class="mcard" style="--a:#1f5fc4">
                <span class="mcard-ic"><svg viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg></span>
                <div style="min-width:0; flex:1">
                    <div class="mcard-lbl" style="margin-bottom:7px">Totalt søknader · @_rows.Count</div>
                    <div class="nk-grid">
                        <div class="nk-gh"></div>
                        <div class="nk-gh">Nye</div>
                        <div class="nk-gh" title="Snitt dager fra sak påbegynnes til den er avklart">Syklus</div>
                        <div class="nk-gh" title="Snitt antall saker per dag der en agent (ikke admin/Konrad) har gjort en statusendring eller ringt">Snitt agent/dag</div>
                        @for (var i = 0; i < 4; i++)
                        {
                            <div class="nk-gk">@PeriodeNavn[i]</div>
                            <div class="nk-gv"><b>+@_pNye[i]</b></div>
                            <div class="nk-gv">@Dager(_pSyklus[i])</div>
                            <div class="nk-gv"><b>@Snitt1(_pSnittDag[i])</b></div>
                        }
                    </div>
                    <div class="mcard-sub" style="margin-top:7px">@_b2c privat · @_b2b bedrift</div>
                </div>
            </div>
            <div class="mcard" style="--a:#c2740a">
                <span class="mcard-ic"><svg viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg></span>
                <div style="min-width:0; flex:1">
                    <div class="nk-head">
                        <span class="mcard-lbl" style="margin:0">Leads · @_leadTotal totalt</span>
                        <select class="nk-period" @bind="_leadsP" @bind:after="RecomputeLeads">
                            <option value="all">All time</option>
                            <option value="uke">Denne uke</option>
                            <option value="maaned">Denne måned</option>
                            <option value="90">Siste 90 dager</option>
                            <option value="aar">I år</option>
                            <option value="custom">Egendefinert…</option>
                        </select>
                    </div>
                    @if (_leadsP == "custom")
                    {
                        <div class="nk-custom"><input type="date" @bind="_leadsFra" @bind:after="RecomputeLeads" /><span>–</span><input type="date" @bind="_leadsTil" @bind:after="RecomputeLeads" /></div>
                    }
                    <div class="nk-line"><span class="nk-k"><span class="nk-dot" style="background:#9aa0a8"></span>Ubehandlet</span><span class="nk-v"><b>@_leadUbeh</b> <span class="nk-pct">@Pct(_leadUbeh, _leadTotal)</span></span></div>
                    <div class="nk-line"><span class="nk-k"><span class="nk-dot" style="background:#1f5fc4"></span>Pågår</span><span class="nk-v"><b>@_leadPaagaar</b> <span class="nk-pct">@Pct(_leadPaagaar, _leadTotal)</span></span></div>
                    <div class="nk-line"><span class="nk-k"><span class="nk-dot" style="background:#266f32"></span>Ferdigstilt</span><span class="nk-v"><b>@_leadFerdig</b> <span class="nk-pct">@Pct(_leadFerdig, _leadTotal)</span></span></div>
                </div>
            </div>
        </div>

        <div class="mcard" style="--a:#1f6e33">
            <span class="mcard-ic"><svg viewBox="0 0 24 24"><line x1="3" y1="21" x2="21" y2="21"/><path d="M5 6l7-3 7 3"/><line x1="4" y1="10" x2="4" y2="21"/><line x1="20" y1="10" x2="20" y2="21"/><line x1="12" y1="10" x2="12" y2="21"/></svg></span>
            <div style="min-width:0; flex:1">
                <div class="nk-head" style="margin-bottom:9px">
                    <span class="mcard-lbl" style="margin:0">Bankresultater</span>
                    <select class="nk-period" @bind="_bankP" @bind:after="RecomputeBank">
                        <option value="all">All time</option>
                        <option value="uke">Denne uke</option>
                        <option value="maaned">Denne måned</option>
                        <option value="90">Siste 90 dager</option>
                        <option value="aar">I år</option>
                        <option value="custom">Egendefinert…</option>
                    </select>
                </div>
                @if (_bankP == "custom")
                {
                    <div class="nk-custom" style="margin-bottom:8px"><input type="date" @bind="_bankFra" @bind:after="RecomputeBank" /><span>–</span><input type="date" @bind="_bankTil" @bind:after="RecomputeBank" /></div>
                }
                <div class="nk-banks">
                    <div class="nk-bankcol">
                        <div class="nk-bankh">Instabank</div>
                        <div class="nk-line"><span class="nk-k">Sendt</span><span class="nk-v"><b>@_ibSendt</b></span></div>
                        <div class="nk-line"><span class="nk-k">Innvilget</span><span class="nk-v"><b>@_ibInnvilget</b> <span class="nk-pct">@Pct(_ibInnvilget, _ibSendt)</span></span></div>
                        <div class="nk-line"><span class="nk-k">Utbetalt</span><span class="nk-v"><b>@_ibUtbetalt</b> <span class="nk-pct">@Pct(_ibUtbetalt, _ibSendt)</span></span></div>
                        <div class="nk-line"><span class="nk-k">Avslått</span><span class="nk-v"><b>@_ibAvslatt</b> <span class="nk-pct">@Pct(_ibAvslatt, _ibSendt)</span></span></div>
                    </div>
                    <div class="nk-bankcol">
                        <div class="nk-bankh">Soknedal</div>
                        <div class="nk-line"><span class="nk-k">Sendt</span><span class="nk-v"><b>@_sokSendt</b></span></div>
                        <div class="nk-line"><span class="nk-k">SBL signert totalt</span><span class="nk-v"><b>@_sokSignert</b> <span class="nk-pct">@Pct(_sokSignert, _sokSendt)</span></span></div>
                        <div class="nk-line"><span class="nk-k">Utbetalt</span><span class="nk-v"><b>@_sokUtbetalt</b> <span class="nk-pct">@Pct(_sokUtbetalt, _sokSendt)</span></span></div>
                        <div class="nk-line"><span class="nk-k">Avslått</span><span class="nk-v"><b>@_sokAvslatt</b> <span class="nk-pct">@Pct(_sokAvslatt, _sokSendt)</span></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Leads siste 30 dager — rett under Nøkkeltall *@
    <div class="panel" style="margin-bottom:16px">
        <div class="panel-head">
            <div><h2>Leads siste 30 dager</h2><span class="sub">Søknader per dag · antall og <span style="color:#2f8a3e;font-weight:600">andel med eierskap</span> under hver bar · hold over for status og lånetype</span></div>
            <span class="panel-count">@_dager.Sum(d => d.Total) leads</span>
        </div>
        <div class="daybar-chart daybar-slim daybar-solid">
            @foreach (var dag in _dager)
            {
                <div class="daybar-col">
                    @if (dag.Total > 0)
                    {
                        <div class="daybar-tip">
                            <div class="tip-title">@dag.Label · @dag.Total leads · @dag.MedEier med eierskap</div>
                            <div class="tip-sec">
                                <div class="tip-h">Status</div>
                                @foreach (var st in _statuser)
                                {
                                    var c = dag.PerStatus.GetValueOrDefault(st, 0);
                                    @if (c > 0)
                                    {
                                        <div class="tip-row"><span class="d" style="background:@StatusFarge(st)"></span><span class="tip-n">@st</span><span class="tip-v">@c</span></div>
                                    }
                                }
                            </div>
                            <div class="tip-sec">
                                <div class="tip-h">Lånetype</div>
                                @foreach (var (type, antall) in dag.PerLaanetype.OrderByDescending(x => x.Value))
                                {
                                    <div class="tip-row"><span class="d" style="background:@LaanetypeFarge(type)"></span><span class="tip-n">@type</span><span class="tip-v">@antall</span></div>
                                }
                            </div>
                            <div class="tip-sec">
                                <div class="tip-h">Leadskilde</div>
                                @foreach (var (kilde, antall) in dag.PerKilde.OrderByDescending(x => x.Value))
                                {
                                    <div class="tip-row"><span class="d" style="background:@KildeFarge(kilde)"></span><span class="tip-n">@kilde</span><span class="tip-v">@antall</span></div>
                                }
                            </div>
                        </div>
                    }
                    <div class="daybar-stack">
                        @if (dag.Total > 0)
                        {
                            <div class="daybar-seg" style="height:@(((double)dag.Total / _maxDag * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="daybar-labels">
            @foreach (var dag in _dager)
            {
                <span class="dl" title="@dag.MedEier av @dag.Total med eierskap">
                    <span class="dl-date">@dag.Label</span>
                    <span class="dl-num @(dag.Total == 0 ? "nil" : "")">@dag.Total</span>
                    <span class="dl-eier @(dag.Total == 0 ? "nil" : "")">@(dag.Total > 0 ? (int)Math.Round(dag.MedEier * 100.0 / dag.Total) + " %" : "–")</span>
                </span>
            }
        </div>
    </div>

    @* Pipeline — eget panel, lukket som standard *@
    <div class="panel" style="margin-bottom:16px">
        <div class="dist-cards">
            @{
                var _kildeSum = _kildeAlle.Sum(x => x.Antall);
                var _laanSum = _laanetypeAlle.Sum(x => x.Antall);
            }
            @{
                var _pipeAnt = _pipelineMedAntall + _pipelineUtenAntall;
                var _pipeTotal = _pipeline + _pipelineEstimert;
                var _oppgPct = _pipeTotal > 0 ? (double)(_pipeline / _pipeTotal) * 100 : 0;
                var _estPct = 100 - _oppgPct;
            }
            <div class="dcard dcard-wide">
                <button type="button" class="dcard-head dcard-toggle" @onclick="() => _pipeApen = !_pipeApen" aria-expanded="@_pipeApen">
                    <span class="mcard-ic" style="--a:#0e7490"><svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></span>
                    <div><div class="dcard-title">Pipeline</div><div class="dcard-sub">Estimert total @Mnok(_pipeTotal) · @_pipeAnt saker</div></div>
                    <span class="dcard-caret @(_pipeApen ? "open" : "")">▸</span>
                </button>
                @if (_pipeApen)
                {
                <div class="pl-splitbar">
                    <span style="width:@_oppgPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; background:#0e7490"></span>
                    <span style="width:@_estPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; background:#1f5fc4"></span>
                </div>
                <div class="pl-splitlegend">
                    <span><span class="d" style="background:#0e7490"></span>Oppgitt <b>@Mnok(_pipeline)</b> · @($"{_oppgPct:0}") %</span>
                    <span><span class="d" style="background:#1f5fc4"></span>Estimert <b>@Mnok(_pipelineEstimert)</b> · @($"{_estPct:0}") %</span>
                </div>

                @* Oppgitt beløp *@
                <div class="pl-sec">
                    <div class="pl-sec-head"><span class="pl-dot" style="background:#0e7490"></span><span class="pl-sec-t">Oppgitt beløp</span><span class="pl-sec-meta">@_pipelineMedAntall saker</span><span class="pl-sec-sum">@Mnok(_pipeline)</span></div>
                    <div class="pl-kt"><span>B2C <b>@MnokTall(_oppgittB2C)</b></span><span>B2B <b>@MnokTall(_oppgittB2B)</b></span></div>
                    <div class="pl-tab">
                        @foreach (var r in _pipeLaanRader.Where(r => r.OppgittAntall > 0))
                        {
                            <div class="pl-tr">
                                <span class="pl-tn"><span class="d" style="background:@LaanetypeFarge(r.Navn)"></span>@r.Navn</span>
                                <span class="pl-tmeta">@r.OppgittAntall saker · snitt @KrKort(r.Snitt)</span>
                                <span class="pl-ts">@MnokTall(r.OppgittSum)</span>
                            </div>
                        }
                    </div>
                </div>

                @* Estimert *@
                <div class="pl-sec">
                    <div class="pl-sec-head"><span class="pl-dot" style="background:#1f5fc4"></span><span class="pl-sec-t">Estimert – uten beløp</span><span class="pl-sec-meta">@_pipelineUtenAntall saker</span><span class="pl-sec-sum est">+@Mnok(_pipelineEstimert)</span></div>
                    <div class="pl-kt"><span>B2C <b>@MnokTall(_estB2C)</b></span><span>B2B <b>@MnokTall(_estB2B)</b></span></div>
                    <div class="pl-tab">
                        @foreach (var r in _pipeLaanRader.Where(r => r.UtenAntall > 0))
                        {
                            <div class="pl-tr">
                                <span class="pl-tn"><span class="d" style="background:@LaanetypeFarge(r.Navn)"></span>@r.Navn</span>
                                <span class="pl-tmeta">@r.UtenAntall saker · snitt @KrKort(r.Snitt)</span>
                                <span class="pl-ts est">@MnokTall(r.EstSum)</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="pl-unit">Snitt per sak i kr (k = tusen, M = million)</div>

                @* Fordeling — leadskilde og lånetype flettet inn *@
                <div class="pl-ford">
                    <div class="pl-ford-col">
                        <div class="pl-ford-h">Leadskilde <span>@_kildeSum leads</span></div>
                        <div class="distbar">
                            @foreach (var (navn, antall) in _kildeAlle)
                            {
                                <span style="width:@(((double)antall / Math.Max(1, _kildeSum) * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background:@KildeFarge(navn)" title="@navn: @antall"></span>
                            }
                        </div>
                        <div class="dist-legend">
                            @foreach (var (navn, antall) in _kildeAlle)
                            {
                                <span class="i"><span class="d" style="background:@KildeFarge(navn)"></span>@navn <b>@antall</b> <span class="pct">@(_kildeSum > 0 ? (int)Math.Round((double)antall / _kildeSum * 100) : 0) %</span></span>
                            }
                        </div>
                    </div>
                    <div class="pl-ford-col">
                        <div class="pl-ford-h">Lånetype <span>@_laanSum leads</span></div>
                        <div class="distbar">
                            @foreach (var (navn, antall) in _laanetypeAlle)
                            {
                                <span style="width:@(((double)antall / Math.Max(1, _laanSum) * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background:@LaanetypeFarge(navn)" title="@navn: @antall"></span>
                            }
                        </div>
                        <div class="dist-legend">
                            @foreach (var (navn, antall) in _laanetypeAlle)
                            {
                                <span class="i"><span class="d" style="background:@LaanetypeFarge(navn)"></span>@navn <b>@antall</b> <span class="pct">@(_laanSum > 0 ? (int)Math.Round((double)antall / _laanSum * 100) : 0) %</span></span>
                            }
                        </div>
                        @if (_ukjentKilde.Count > 0)
                        {
                            <div class="pl-ukjent">«Ukjent» = leads uten valgt lånetype · kilde: @string.Join(" · ", _ukjentKilde.Select(x => $"{x.Navn} {x.Antall}"))</div>
                        }
                    </div>
                </div>
                }
            </div>
        </div>
    </div>

    @* Trakt — hvor leadsene står i løpet (siste 30 dager) *@
    <div class="panel" style="margin-bottom:16px">
        <button type="button" class="panel-head panel-toggle" @onclick="() => _traktApen = !_traktApen" aria-expanded="@_traktApen">
            <div><h2>Trakt — siste 30 dager <span class="fn-total">(@_funnelTot totalt)</span></h2><span class="sub">Hvor leadsene står i løpet, fra inngang til utbetaling</span></div>
            <span class="dcard-caret @(_traktApen ? "open" : "")">▸</span>
        </button>
        @if (_traktApen)
        {
        <div class="funnel">
            @foreach (var steg in _funnel)
            {
                var tot = steg.Subs.Sum(x => _statusCount30.GetValueOrDefault(x, 0));
                var totAll = steg.Subs.Sum(x => _statusCountAll.GetValueOrDefault(x, 0));
                var vol30 = steg.Subs.Sum(x => _statusVolum30.GetValueOrDefault(x, 0m));
                var volAll = steg.Subs.Sum(x => _statusVolumAll.GetValueOrDefault(x, 0m));
                var liggeSum = steg.Subs.Sum(x => _statusLiggetidSum.GetValueOrDefault(x, 0.0));
                var snittLigge = totAll > 0 ? liggeSum / totAll : 0.0;
                var w = Math.Max(56, (int)Math.Round((double)tot / _funnelMax * 100));
                var andel = _funnelTot > 0 ? (int)Math.Round((double)tot / _funnelTot * 100) : 0;
                <div class="fn-step" style="--c:@steg.Farge">
                    <div class="fn-subs">
                        @foreach (var sub in steg.Subs)
                        {
                            var n = _statusCount30.GetValueOrDefault(sub, 0);
                            <span class="fn-sub @(n == 0 ? "nil" : "")"><span class="dot" style="background:@StatusFarge(sub)"></span>@sub <b>@n</b></span>
                        }
                        <div class="fn-vol">
                            <div class="fn-vol-row"><span class="fn-vol-lbl">Lånevolum</span><span class="fn-vol-val">@Mnok(vol30)</span></div>
                            <div class="fn-vol-row"><span class="fn-vol-lbl">Totalt</span><span class="fn-vol-val muted">@Mnok(volAll)</span></div>
                        </div>
                    </div>
                    <div class="fn-barwrap">
                        <div class="fn-steg-navn">@steg.Navn</div>
                        <div class="fn-bar" style="width:@w%">
                            <span class="fn-num">@tot</span>
                            <span class="fn-badges">
                                <span class="fn-pct">@andel %</span>
                                <span class="fn-alltime" title="Totalt gjennom tidene">@totAll totalt</span>
                            </span>
                        </div>
                    </div>
                    <div class="fn-snitt" title="Snitt tid siden sist endring for sakene som står i dette steget nå">
                        <div class="fn-snitt-val">@Liggetid(snittLigge)</div>
                        <div class="fn-snitt-lbl">snitt liggetid</div>
                    </div>
                </div>
            }
        </div>
        }
    </div>
}

@code {
    private List<Kundekort> _rows = new();
    private List<BankSending> _sendingerRaw = new();
    private Dictionary<Guid, (int Antall, DateTime Sist)> _ringRaw = new();
    private List<KundekortLogg> _agentHandlinger = new();   // handlinger (ikke innsyn) i år
    private HashSet<string> _adminAktorer = new(StringComparer.OrdinalIgnoreCase);  // admin/Konrad ekskluderes

    // Reell agent-handling: ikke system, ikke admin/Konrad.
    private bool ErAgentHandling(string? aktor)
        => !string.IsNullOrWhiteSpace(aktor)
           && !aktor.StartsWith("System", StringComparison.OrdinalIgnoreCase)
           && !_adminAktorer.Contains(aktor);

    // Teller kun som aktivitet: statusendring eller ringeaktivitet.
    private static bool ErStatusEllerRing(KundekortLogg h)
        => h.Kategori == "anrop"
           || (h.Kategori == "endring" && (h.Tekst?.StartsWith("Endret status", StringComparison.OrdinalIgnoreCase) ?? false));

    // Periodefilter per boks (default «Hele tiden»). Egendefinert bruker fra/til.
    private string _leadsP = "all", _bankP = "all";
    private DateTime? _leadsFra, _leadsTil, _bankFra, _bankTil;

    // Lead-status (boks 2): ubehandlet / pågår / ferdigstilt.
    private int _leadTotal, _leadUbeh, _leadPaagaar, _leadFerdig;
    // Bank-resultater (boks 3): Instabank (fra per-bank-utfall) og Soknedal (fra kundekortstatus).
    private int _ibSendt, _ibInnvilget, _ibUtbetalt, _ibAvslatt;
    private int _sokSendt, _sokSignert, _sokUtbetalt, _sokAvslatt;
    // Totalt søknader-boks: per periode (I dag/Uke/Måned/År): nye, syklustid og snitt saker/dag.
    private static readonly string[] PeriodeNavn = { "I dag", "Uke", "Måned", "År" };
    private readonly int[] _pNye = new int[4];
    private readonly double[] _pSyklus = new double[4];
    private readonly double[] _pSnittDag = new double[4];

    private static readonly string[] FerdigeStatuser = { "Utbetalt", "Avslag", "Avsluttet", "Kansellert" };
    private static readonly string[] FerskeStatuser =
        { "Ny søknad", "Nytt lead", "Påbegynt søknad", "Oppfølging" };

    // Periodevalg → fra/til (Oslo-dato, inklusive). null = ingen grense (hele tiden).
    private (DateTime? Fra, DateTime? Til) PeriodeRange(string p, DateTime? cFra, DateTime? cTil)
    {
        var iDag = DateTime.UtcNow.TilOslo().Date;
        return p switch
        {
            "uke" => (iDag.AddDays(-(((int)iDag.DayOfWeek + 6) % 7)), null),
            "maaned" => (new DateTime(iDag.Year, iDag.Month, 1), null),
            "90" => (iDag.AddDays(-90), null),
            "aar" => (new DateTime(iDag.Year, 1, 1), null),
            "custom" => (cFra?.Date, cTil?.Date),
            _ => (null, null),
        };
    }
    private static bool IPeriode(DateTime utc, DateTime? fra, DateTime? til)
    { var d = utc.TilOslo().Date; return (fra is null || d >= fra) && (til is null || d <= til); }

    // Lead-status for valgt periode (boks 2). Filtrerer leads på opprettet-dato.
    private void RecomputeLeads()
    {
        var (fra, til) = PeriodeRange(_leadsP, _leadsFra, _leadsTil);
        var rows = _rows.Where(k => IPeriode(k.CreatedAt, fra, til)).ToList();
        _leadTotal = rows.Count;
        var sendtKort = _sendingerRaw.Where(s => s.KundekortId is not null
            && s.Status is SendStatus.Sendt or SendStatus.Manuelt or SendStatus.IKo)
            .Select(s => s.KundekortId!.Value).ToHashSet();
        var ringKort = _ringRaw.Keys.ToHashSet();
        _leadUbeh = _leadPaagaar = _leadFerdig = 0;
        foreach (var k in rows)
        {
            if (FerdigeStatuser.Contains(k.Status)) _leadFerdig++;
            else if (sendtKort.Contains(k.Id) || ringKort.Contains(k.Id) || !FerskeStatuser.Contains(k.Status)) _leadPaagaar++;
            else _leadUbeh++;
        }
    }

    // Bank-resultater for valgt periode (boks 3). Filtrerer sendinger på sendt-dato.
    private void RecomputeBank()
    {
        var (fra, til) = PeriodeRange(_bankP, _bankFra, _bankTil);
        bool ErSendt(BankSending s) => s.Status is SendStatus.Sendt or SendStatus.Manuelt;
        var sendinger = _sendingerRaw.Where(s => IPeriode(s.SendtAt, fra, til)).ToList();

        var ib = sendinger.Where(s => InstabankService.ErInstabankNavn(s.Bank) && ErSendt(s)).ToList();
        _ibSendt = ib.Count;
        _ibInnvilget = ib.Count(s => s.Utfall == SendUtfall.Innvilget);
        _ibUtbetalt = ib.Count(s => s.Utfall == SendUtfall.Utbetalt);
        _ibAvslatt = ib.Count(s => s.Utfall == SendUtfall.Avslatt);

        var statusFor = _rows.GroupBy(k => k.Id).ToDictionary(g => g.Key, g => g.First().Status);
        var sok = sendinger.Where(s => (s.Bank ?? "").Contains("soknedal", StringComparison.OrdinalIgnoreCase) && ErSendt(s)).ToList();
        _sokSendt = sok.Count;
        _sokSignert = _sokUtbetalt = _sokAvslatt = 0;
        foreach (var s in sok)
        {
            var st = s.KundekortId is { } id && statusFor.TryGetValue(id, out var v) ? v : "";
            if (st == KundekortService.StatusUtbetalt) { _sokUtbetalt++; _sokSignert++; }   // utbetalt ⇒ har signert
            else if (st == KundekortService.StatusSignert) _sokSignert++;
            else if (st is "Avslag" or "Avsluttet") _sokAvslatt++;
        }
    }

    // Totalt søknader-boks: per periode (uavhengig av boks-filteret).
    private void BeregnTotaltTabell()
    {
        var iDag = DateTime.UtcNow.TilOslo().Date;
        var starts = new[]
        {
            iDag,
            iDag.AddDays(-(((int)iDag.DayOfWeek + 6) % 7)),
            new DateTime(iDag.Year, iDag.Month, 1),
            new DateTime(iDag.Year, 1, 1),
        };
        var dagerGaatt = new[] { 1, (iDag - starts[1]).Days + 1, iDag.Day, iDag.DayOfYear };
        for (var i = 0; i < 4; i++)
        {
            var s = starts[i];
            _pNye[i] = _rows.Count(k => k.CreatedAt.TilOslo().Date >= s);
            var avkl = _rows.Where(k => FerdigeStatuser.Contains(k.Status) && k.UpdatedAt > k.CreatedAt
                                        && k.UpdatedAt.TilOslo().Date >= s).ToList();
            _pSyklus[i] = avkl.Count > 0 ? avkl.Average(k => (k.UpdatedAt - k.CreatedAt).TotalDays) : 0;
            // Snitt/dag = snitt antall saker per dag der en agent (ikke admin/Konrad/system) har gjort
            // en statusendring eller ringeaktivitet.
            var perDag = _agentHandlinger
                .Where(h => ErAgentHandling(h.Aktor) && ErStatusEllerRing(h) && h.Opprettet.TilOslo().Date >= s)
                .GroupBy(h => h.Opprettet.TilOslo().Date)
                .Sum(g => g.Select(h => h.KundekortId).Distinct().Count());
            _pSnittDag[i] = perDag / (double)Math.Max(1, dagerGaatt[i]);
        }
    }

