    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        _rows = await Svc.ListLettAsync();
        var sendingerTask = BankSending.SisteePerKortOgBankAsync();
        var ringTask = Dialer.HentSammendragAsync();
        var handlingerTask = Logg.HandlingerSidenAsync(new DateTime(DateTime.UtcNow.Year, 1, 1, 0, 0, 0, DateTimeKind.Utc));
        var brukereTask = Brukere.ListUsersAsync();
        await Task.WhenAll(sendingerTask, ringTask, handlingerTask, brukereTask);
        _sendingerRaw = sendingerTask.Result;
        _ringRaw = ringTask.Result;
        _agentHandlinger = handlingerTask.Result;
        _adminAktorer = brukereTask.Result.Where(u => u.Role == "Administrator")
            .SelectMany(u => new[] { u.FullName, u.Email })
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        BeregnTotaltTabell();
        RecomputeLeads();
        RecomputeBank();

        var na = DateTime.UtcNow;
        // «Dette døgn» = inneværende kalenderdøgn i norsk tid (ikke rullerende 24 timer).
        var iDagOslo = na.TilOslo().Date;
        var iDag = _rows.Where(k => k.CreatedAt.TilOslo().Date == iDagOslo).ToList();
        _nyeIDag = iDag.Count;
        // Denne uke (mandag→) og denne måned (1. →) i norsk tid.
        var ukeStart = iDagOslo.AddDays(-(((int)iDagOslo.DayOfWeek + 6) % 7));
        var mndStart = new DateTime(iDagOslo.Year, iDagOslo.Month, 1);
        var aarStart = new DateTime(iDagOslo.Year, 1, 1);
        _nyeDenneUke = _rows.Count(k => k.CreatedAt.TilOslo().Date >= ukeStart);
        _nyeDenneMaaned = _rows.Count(k => k.CreatedAt.TilOslo().Date >= mndStart);
        _nyeDetteAar = _rows.Count(k => k.CreatedAt.TilOslo().Date >= aarStart);
        _kildeIDag = iDag
            .GroupBy(k => string.IsNullOrWhiteSpace(k.Kilde) ? "Ukjent" : k.Kilde)
            .Select(g => (g.Key, g.Count()))
            .OrderByDescending(x => x.Item2)
            .ToList();

        _mine = _rows.Count(k => !string.IsNullOrWhiteSpace(Session.Email) && k.Eier == Session.Email);
        var pipeAktiv = _rows.Where(k => k.Status is not (KundekortService.StatusUtbetalt or "Avslag")).ToList();
        _pipeline = pipeAktiv.Sum(k => k.OnsketLaanebelop ?? 0);
        var pipeMedBelop = pipeAktiv.Where(k => (k.OnsketLaanebelop ?? 0) > 0).ToList();
        var pipeUtenBelop = pipeAktiv.Where(k => (k.OnsketLaanebelop ?? 0) <= 0).ToList();
        _pipelineSnitt = pipeMedBelop.Count > 0 ? pipeMedBelop.Average(k => k.OnsketLaanebelop!.Value) : 0m;
        _pipelineUtenAntall = pipeUtenBelop.Count;
        _pipelineMedAntall = pipeMedBelop.Count;

        // Snitt PER lånetype (fra sakene som har oppgitt beløp) → estimer manglende per lånetype.
        string LaanNavn(Kundekort k) => string.IsNullOrWhiteSpace(k.Laanetype) ? "Ukjent" : k.Laanetype;
        var snittPerLaan = pipeMedBelop.GroupBy(LaanNavn)
            .ToDictionary(g => g.Key, g => g.Average(k => k.OnsketLaanebelop!.Value));
        decimal SnittFor(string laan) => snittPerLaan.TryGetValue(laan, out var s) ? s : _pipelineSnitt;

        // Rader per lånetype: oppgitt (sum) + estimert (antall uten × snitt for lånetypen).
        var alleLaan = pipeAktiv.Select(LaanNavn).Distinct();
        _pipeLaanRader = alleLaan.Select(navn =>
        {
            var med = pipeMedBelop.Where(k => LaanNavn(k) == navn).ToList();
            var utenN = pipeUtenBelop.Count(k => LaanNavn(k) == navn);
            var snitt = med.Count > 0 ? med.Average(k => k.OnsketLaanebelop!.Value) : _pipelineSnitt;
            return new PipeRad(navn, med.Count, med.Sum(k => k.OnsketLaanebelop!.Value), snitt, utenN, utenN * snitt);
        }).Where(r => r.OppgittAntall > 0 || r.UtenAntall > 0)
          .OrderByDescending(r => r.OppgittSum + r.EstSum).ToList();

        _pipelineEstimert = _pipeLaanRader.Sum(r => r.EstSum);

        // Kundetype: oppgitt = faktisk sum; estimert = sum av hver manglende saks lånetype-snitt.
        _oppgittB2C = pipeMedBelop.Where(k => k.KundeType == "B2C").Sum(k => k.OnsketLaanebelop!.Value);
        _oppgittB2B = pipeMedBelop.Where(k => k.KundeType == "B2B").Sum(k => k.OnsketLaanebelop!.Value);
        _estB2C = pipeUtenBelop.Where(k => k.KundeType == "B2C").Sum(k => SnittFor(LaanNavn(k)));
        _estB2B = pipeUtenBelop.Where(k => k.KundeType == "B2B").Sum(k => SnittFor(LaanNavn(k)));

        // Utatte: ingen eier + fortsatt aktiv (ikke fullført/avslått).
        _utatte = _rows.Count(k => string.IsNullOrWhiteSpace(k.Eier)
                                   && k.Status is not (KundekortService.StatusUtbetalt or "Avslag"));
        _b2c = _rows.Count(k => k.KundeType == "B2C");
        _b2b = _rows.Count(k => k.KundeType == "B2B");

        // Andel av alle søknader som har fått eierskap (tildelt rådgiver).
        _medEierskap = _rows.Count(k => !string.IsNullOrWhiteSpace(k.Eier));
        _eierskapPct = _rows.Count > 0 ? (int)Math.Round(_medEierskap * 100.0 / _rows.Count) : 0;
        _eierTattIDag = _rows.Count(k => k.EierTattAt.HasValue && k.EierTattAt.Value.TilOslo().Date == iDagOslo);
        _eierTattUke = _rows.Count(k => k.EierTattAt.HasValue && k.EierTattAt.Value.TilOslo().Date >= ukeStart);
        _eierTattMaaned = _rows.Count(k => k.EierTattAt.HasValue && k.EierTattAt.Value.TilOslo().Date >= mndStart);
        _eierTattAar = _rows.Count(k => k.EierTattAt.HasValue && k.EierTattAt.Value.TilOslo().Date >= aarStart);

        // Saker som krever handling: feilet sending + timeout mot bank.
        _tekniskFeil = _rows.Count(k => k.Status == KundekortService.StatusTekniskFeil);
        _timeout = _rows.Count(k => k.Status == KundekortService.StatusSendtBankTimeout);

        // Pågår hos rådgiver: har eier + fortsatt aktiv (ikke fullført/avslått).
        var eideAktive = _rows.Where(k => !string.IsNullOrWhiteSpace(k.Eier)
                                          && k.Status is not (KundekortService.StatusUtbetalt or KundekortService.StatusAvslatt))
                              .ToList();
        _eideAktive = eideAktive.Count;
        if (_eideAktive > 0)
        {
            var aldre = eideAktive.Select(k => na - k.CreatedAt.ToUniversalTime()).ToList();
            _eldsteAlder = aldre.Max();
            _snittAlder = TimeSpan.FromTicks((long)aldre.Average(t => t.Ticks));
        }

        // Ferdigbehandlet-andel (utbetalt + avslått av totalt).
        _utbetalt = _rows.Count(k => k.Status == KundekortService.StatusUtbetalt);
        _avslatt = _rows.Count(k => k.Status == KundekortService.StatusAvslatt);
        _ferdigPct = _rows.Count > 0 ? (int)Math.Round((_utbetalt + _avslatt) * 100.0 / _rows.Count) : 0;

        // Ferdigstilte søknader = alle sluttførte/avsluttede saker (terminale statuser).
        var ferdigStatuser = new[] { KundekortService.StatusUtbetalt, KundekortService.StatusAvslatt, "Kansellert" };
        var ferdige = _rows.Where(k => ferdigStatuser.Contains(k.Status)).ToList();
        _ferdigstilt = ferdige.Count;
        _ferdigstiltPct = _rows.Count > 0 ? (int)Math.Round(_ferdigstilt * 100.0 / _rows.Count) : 0;
        // Ferdigstilt per periode — bruker updated_at (≈ tidspunkt saken ble satt til terminalstatus).
        _ferdigIDag = ferdige.Count(k => k.UpdatedAt.TilOslo().Date == iDagOslo);
        _ferdigUke = ferdige.Count(k => k.UpdatedAt.TilOslo().Date >= ukeStart);
        _ferdigMaaned = ferdige.Count(k => k.UpdatedAt.TilOslo().Date >= mndStart);
        _ferdigAar = ferdige.Count(k => k.UpdatedAt.TilOslo().Date >= aarStart);

        // Fullføringsgrad (kun rentekutt.no): andel påbegynte som har fullført søknaden.
        var rk = _rows.Where(ErRentekutt).ToList();
        _fullfortBase = rk.Count;
        _fullfortAntall = rk.Count(ErFullfort);
        _fullfortPct = _fullfortBase > 0 ? (int)Math.Round(_fullfortAntall * 100.0 / _fullfortBase) : 0;

        var idag = Tid.Naa.Date;

        // Ukentlig trend (siste 12 uker, mandag-basert).
        _fullfortUker = new();
        var tilMandag = ((int)idag.DayOfWeek + 6) % 7;   // mandag = 0
        var denneMandag = idag.AddDays(-tilMandag);
        for (var w = 11; w >= 0; w--)
        {
            var start = denneMandag.AddDays(-7 * w);
            var slutt = start.AddDays(7);
            var kohort = rk.Where(k => { var d = k.CreatedAt.TilOslo().Date; return d >= start && d < slutt; }).ToList();
            var full = kohort.Count(ErFullfort);
            var pct = kohort.Count > 0 ? (int)Math.Round(full * 100.0 / kohort.Count) : 0;
            _fullfortUker.Add(new UkeBar(start.ToString("dd.MM"), pct, full, kohort.Count));
        }

        _dager = new();
        for (var i = 29; i >= 0; i--)
        {
            var d = idag.AddDays(-i);
            var dagLeads = _rows.Where(k => k.CreatedAt.TilOslo().Date == d).ToList();
            var perStatus = dagLeads.GroupBy(k => k.Status).ToDictionary(g => g.Key, g => g.Count());
            var perLaan = dagLeads.GroupBy(k => string.IsNullOrWhiteSpace(k.Laanetype) ? "Ukjent" : k.Laanetype).ToDictionary(g => g.Key, g => g.Count());
            var perKilde = dagLeads.GroupBy(k => string.IsNullOrWhiteSpace(k.Kilde) ? "Ukjent" : k.Kilde).ToDictionary(g => g.Key, g => g.Count());
            var label = i == 0 ? "I dag" : i == 1 ? "I går" : d.ToString("dd.MM");
            var medEier = dagLeads.Count(k => !string.IsNullOrWhiteSpace(k.Eier));
            _dager.Add(new DagBar(label, perStatus, dagLeads.Count, medEier, perLaan, perKilde));
        }
        _maxDag = Math.Max(1, _dager.Max(d => d.Total));

        // Eierskap tatt per dag (siste 30).
        _eierDager = new();
        for (var i = 29; i >= 0; i--)
        {
            var d = idag.AddDays(-i);
            var antall = _rows.Count(k => k.EierTattAt.HasValue && k.EierTattAt.Value.TilOslo().Date == d);
            var label = i == 0 ? "I dag" : i == 1 ? "I går" : d.ToString("dd.MM");
            _eierDager.Add(new EierBar(label, antall));
        }
        _maxEierDag = Math.Max(1, _eierDager.Max(d => d.Antall));

        var fra30 = idag.AddDays(-29);
        var siste30 = _rows.Where(k => k.CreatedAt.TilOslo().Date >= fra30).ToList();
        _statusCount30 = siste30.GroupBy(k => k.Status).ToDictionary(g => g.Key, g => g.Count());
        _statusCountAll = _rows.GroupBy(k => k.Status).ToDictionary(g => g.Key, g => g.Count());
        _statusVolum30 = siste30.GroupBy(k => k.Status).ToDictionary(g => g.Key, g => g.Sum(k => k.OnsketLaanebelop ?? 0));
        _statusVolumAll = _rows.GroupBy(k => k.Status).ToDictionary(g => g.Key, g => g.Sum(k => k.OnsketLaanebelop ?? 0));
        // Snitt liggetid per steg: tid siden sist endring (updated_at) for sakene som står der nå.
        _statusLiggetidSum = _rows.GroupBy(k => k.Status)
            .ToDictionary(g => g.Key, g => g.Sum(k => Math.Max(0, (na - k.UpdatedAt.ToUniversalTime()).TotalHours)));

        // Fordeling på leadskilde og lånetype (alle søknader).
        _kildeAlle = _rows.GroupBy(k => string.IsNullOrWhiteSpace(k.Kilde) ? "Ukjent" : k.Kilde)
                          .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ToList();
        _laanetypeAlle = _rows.GroupBy(k => string.IsNullOrWhiteSpace(k.Laanetype) ? "Ukjent" : k.Laanetype)
                              .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ToList();
        // «Ukjent» lånetype = leads uten valgt lånetype — hvilken kilde kommer de fra?
        _ukjentKilde = _rows.Where(k => string.IsNullOrWhiteSpace(k.Laanetype))
                            .GroupBy(k => string.IsNullOrWhiteSpace(k.Kilde) ? "Ukjent" : k.Kilde)
                            .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ToList();
        _funnelTot = _funnel.Sum(s => s.Subs.Sum(x => _statusCount30.GetValueOrDefault(x, 0)));
        _funnelMax = Math.Max(1, _funnel.Max(s => s.Subs.Sum(x => _statusCount30.GetValueOrDefault(x, 0))));
        _laanetype30 = siste30
            .GroupBy(k => string.IsNullOrWhiteSpace(k.Laanetype) ? "Ukjent" : k.Laanetype)
            .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ToList();
        _kilde30 = siste30
            .GroupBy(k => string.IsNullOrWhiteSpace(k.Kilde) ? "Ukjent" : k.Kilde)
            .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ToList();

        _loading = false;
    }
