}
}@* /fane detaljer *@
</div>@* /kk-main *@
</div>@* /kk-grid *@
</div>@* /kk *@

@code {
    [SupplyParameterFromQuery] public string? Id { get; set; }

    private Kundekort _k = new();
    private bool _isEdit;
    private bool _saving;
    private bool _ok;
    private string? _msg;
    private bool _confirmDelete;
    private BeregningParametre _berParams = BeregningService.Standard;
    private bool _visBreakdown;

    private List<SmsMal> _smsMaler = new();
    private string _smsTekst = "";
    private string? _smsMsg;
    private bool _smsOk, _smsSending;

    // Notatlogg
    private List<Saksnotat> _notatLogg = new();
    private bool _visNyttNotat;
    private string _nyttNotat = "";
    private bool _notatLagrer;

    private static string Vis(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    // Initialer til avatar i topp-kortet (maks 2 bokstaver).
    private static string Forbokstaver(string? navn)
    {
        if (string.IsNullOrWhiteSpace(navn)) return "—";
        var deler = navn.Trim().Split(new[] { ' ', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (deler.Length == 1) return deler[0][..1].ToUpper();
        return (deler[0][..1] + deler[^1][..1]).ToUpper();
    }

    // Farge på status-chip i topp-kortet.
    private static string StatusFarge(string? s) => s switch
    {
        "Fullført og utbetalt" => "#2f8a3e",
        "Sendt bank" => "#2f8a3e",
        "Tilbud utsendt" => "#1f5fc4",
        "Pågår" => "#1f5fc4",
        "Manuell behandling" => "#c2740a",
        "Avslått" => "#b42318",
        "Feilet i sending" => "#b42318",
        _ => "#767b84",
    };

    // Farge på kundetype-chip: bedrift lilla, privat blågrønn.
    private static string TypeFarge(string? t) => t == "B2B" ? "#6b3fc4" : "#0e7490";

    // Farge på kilde-chip: Prismatch grønn, Rentekutt amber.
    private static string KildeFarge(string? kilde)
    {
        var k = (kilde ?? "").ToLowerInvariant();
        if (k.Contains("prismatch")) return "#2f8a3e";
        if (k.Contains("rentekutt")) return "#b45309";
        return "#767b84";
    }

    // Myk «pill»-stil for chip: tonet bakgrunn + farget tekst.
    private static string ChipStyle(string c) => $"background:{c}1a;color:{c}";

    private static string StatusKlasse(string s) => s switch
    {
        "Åpen" => "st-apen", "Pågår" => "st-pagar", "Manuell behandling" => "st-manuell",
        "Sendt bank" => "st-sendt", "Tilbud utsendt" => "st-tilbud",
        "Feilet i sending" => "st-avslatt",
        "Fullført og utbetalt" => "st-fullfort", "Avslått" => "st-avslatt", _ => "",
    };

    // Hurtiglagring av bank + nåværende rente (mates til Markedsinnsikt).
    private bool _bankRenteLagrer;
    private string? _bankRenteMsg;
    private async Task LagreBankRente()
    {
        if (!KanEndre) return;
        if (_k.Id == Guid.Empty) return;
        _bankRenteLagrer = true;
        _bankRenteMsg = null;
        await Svc.SetBankRenteAsync(_k.Id, _k.NavarendeBank, _k.NaavaerendeRente);
        _bankRenteMsg = "Lagret ✓";
        _bankRenteLagrer = false;
        StateHasChanged();
        await Task.Delay(1600);
        _bankRenteMsg = null;
    }

    private async Task LagreNotat()
    {
        if (!KanEndre) return;
        if (string.IsNullOrWhiteSpace(_nyttNotat) || _k.Id == Guid.Empty) return;
        _notatLagrer = true;
        var ok = await Notater.AddAsync(_k.Id, _nyttNotat,
            Session.Email ?? Session.UserName, Session.UserName ?? Session.Email);
        if (ok)
        {
            _notatLogg = await Notater.ListAsync(_k.Id);
            _nyttNotat = "";
            _visNyttNotat = false;
        }
        _notatLagrer = false;
    }

    private void VelgMal(ChangeEventArgs e)
    {
        var navn = e.Value?.ToString();
        var mal = _smsMaler.FirstOrDefault(m => m.Navn == navn);
        if (mal is not null) _smsTekst = mal.Tekst;
    }

    private async Task SendSms()
    {
        if (!KanEndre) return;
        _smsSending = true;
        _smsMsg = null;
        var (ok, detalj) = await SmsMaler.SendTilKundeAsync(_k.Mobilnummer, _smsTekst, _k.FulltNavn);
        _smsOk = ok;
        _smsMsg = ok ? "SMS sendt ✓" : $"Kunne ikke sende: {detalj}";
        _smsSending = false;
    }

    private async Task Delete()
    {
        if (!KanEndre) return;
        var (ok, error) = await Svc.DeleteAsync(_k.Id);
        if (!ok)
        {
            _confirmDelete = false;
            _ok = false;
            _msg = error ?? "Kunne ikke slette kundekortet.";
            return;
        }
        // Tilbake til markedet kunden hører til — ikke den skjulte Database-fanen.
        Nav.NavigateTo(_k.KundeType == "B2B" ? "/crm/marked/bedrift" : "/crm/marked/person");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/login"); return; }

        // Kortuavhengige oppslag + selve kortet hentes i parallell (var 3–6 sekvensielle
        // rundturer før — hovedårsaken til at kundekort var tregt å åpne).
        var berTask = Beregning.HentParametreAsync();
        var smsTask = SmsMaler.ListAsync();
        var bankerTask = Partners.ListAsync();
        var produktTask = Produkter.ListAsync();
        var kortTask = Guid.TryParse(Id, out var caseId) ? Svc.GetAsync(caseId) : Task.FromResult<Kundekort?>(null);

        await Task.WhenAll(berTask, smsTask, bankerTask, produktTask, kortTask);
        _berParams = berTask.Result;
        _smsMaler = smsTask.Result;
        _banker = bankerTask.Result;
        _produkter = produktTask.Result;
        _regler = await Ruting.ListAsync();

        if (kortTask.Result is { } existing)
        {
            _k = existing; _isEdit = true;
            // Notater + banksendinger + endringslogg avhenger av kort-id — hentes i parallell.
            var notatTask = Notater.ListAsync(_k.Id);
            var sendTask = BankSending.ForKundeAsync(_k.Id);
            var loggTask = Logg.ForKundeAsync(_k.Id);
            await Task.WhenAll(notatTask, sendTask, loggTask);
            _notatLogg = notatTask.Result;
            _sendinger = sendTask.Result;
            _endringslogg = loggTask.Result;
            _harSamtykke = _k.SamtykkeGjeldsregisterKredittsjekk || await Samtykke.HarGyldigAsync(_k.Id, SamtykkeService.FormaalKreditt);
            // Loggfør innsyn (hvem åpnet kundekortet, når) — del av det manipuleringssikre revisjonssporet.
            await Logg.LoggInnsynAsync(_k.Id, Session.UserName ?? Session.Email, "Åpnet kundekortet");
        }
    }

    // ---- Samtykke ----
    private bool _harSamtykke;
    private async Task RegistrerSamtykke()
    {
        await Samtykke.RegistrerAsync(_k.Id, SamtykkeService.FormaalKreditt,
            Session.UserName ?? Session.Email, tekstversjon: "manuelt registrert av rådgiver");
        _harSamtykke = true;
        await Logg.LoggAsync(_k.Id, Session.UserName ?? Session.Email, "Registrerte samtykke (Gjeldsregister og kredittsjekk)");
        _endringslogg = await Logg.ForKundeAsync(_k.Id);
    }

    // ---- Endringslogg + auto-lagring ----
    private List<KundekortLogg> _endringslogg = new();
    private string? _autoMsg;
    private bool _autoOk;

    // Auto-lagring: kalles når et felt endres (onchange bobler opp fra feltene).
    private async Task AutoLagre()
    {
        if (!_isEdit || !KanEndre) return;
        var (ok, error) = await Svc.SaveAsync(_k, strict: false, aktor: Session.UserName ?? Session.Email);
        _autoOk = ok;
        _autoMsg = ok ? "Lagret ✓" : ("Kunne ikke lagre: " + (error ?? "ukjent feil"));
        if (ok) _endringslogg = await Logg.ForKundeAsync(_k.Id);
        StateHasChanged();
        if (ok) { await Task.Delay(1600); _autoMsg = null; StateHasChanged(); }
    }

    // ---- Interne faner ----
    private string _fane = "oversikt";
    private List<Rutingsregel> _regler = new();
    private static readonly string[] FlytSteg = { "Åpen", "Pågår", "Sendt bank", "Tilbud utsendt", "Fullført og utbetalt" };

    // ---- Send til bank ----
    private List<Partner> _banker = new();
    private List<PartnerProdukt> _produkter = new();
    private List<BankSending> _sendinger = new();
    private string _valgtBank = "";
    private string _valgtProduktId = "";
    private bool _sender;
    private string? _sendMsg;
    private bool _sendOk;

    // Aktive produkter for valgt bank som matcher kundens segment (B2B→bedrift, ellers privat).
    private List<PartnerProdukt> ProdukterForValgtBank()
    {
        if (string.IsNullOrWhiteSpace(_valgtBank)) return new();
        var bank = _banker.FirstOrDefault(b => b.Navn == _valgtBank);
        if (bank is null) return new();
        var segment = PartnerProdukt.SegmentFor(_k.KundeType);
        return _produkter
            .Where(p => p.PartnerId == bank.Id && p.Aktiv && string.Equals(p.Segment, segment, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Sortering).ThenBy(p => p.Navn)
            .ToList();
    }

    private void OnBankValgt(ChangeEventArgs e)
    {
        _valgtBank = e.Value?.ToString() ?? "";
        _valgtProduktId = AutoValgtProduktId();   // forhåndsvelg produkt ut fra lånetype
    }

    // Auto-valg: hvis nøyaktig ett produkt (i valgt bank + kundens segment) er eksplisitt
    // knyttet til kundens lånetype, forhåndsvelges det. Ellers lar vi rådgiver velge selv.
    private string AutoValgtProduktId()
    {
        var treff = ProdukterForValgtBank().Where(p => p.GjelderLaanetype(_k.Laanetype)).ToList();
        return treff.Count == 1 ? treff[0].Id.ToString() : "";
    }

    private bool ErAutoValgt => !string.IsNullOrWhiteSpace(_valgtProduktId) && _valgtProduktId == AutoValgtProduktId();

    private async Task SendTilBank()
    {
        if (!KanEndre) return;
        if (_k.Id == Guid.Empty || string.IsNullOrWhiteSpace(_valgtBank)) return;
        // Har banken produkter for kundens segment, må ett være valgt.
        var valgbare = ProdukterForValgtBank();
        if (valgbare.Count > 0 && string.IsNullOrWhiteSpace(_valgtProduktId)) return;
        var valgtProdukt = valgbare.FirstOrDefault(p => p.Id.ToString() == _valgtProduktId);

        // GDPR-sperre: ikke send til bank uten gyldig samtykke.
        if (!_harSamtykke)
        {
            _sendOk = false;
            _sendMsg = "Mangler samtykke (Gjeldsregister og kredittsjekk). Registrer samtykke i Oversikt-fanen før sending.";
            return;
        }

        _sender = true;
        _sendMsg = null;
        var avsender = Session.UserName ?? Session.Email ?? "ukjent";

        // Legges i sikker sendekø — en throttlet bakgrunnsarbeider sender til bank,
        // så vi aldri bombarderer API-et. Status oppdateres når den er behandlet.
        var s = new BankSending
        {
            KundekortId = _k.Id,
            KundeNavn = _k.FulltNavn,
            Bank = _valgtBank,
            Produkt = valgtProdukt?.Navn,
            ProduktKode = valgtProdukt?.Kode,
            SendtAv = avsender,
            Status = SendStatus.IKo,
            Detalj = "Lagt i sendekø.",
        };
        var (lagret, feil) = await BankSending.LoggAsync(s);
        if (feil is not null)
        {
            _sendOk = false;
            _sendMsg = "Kunne ikke legge søknaden i sendekø: " + feil;
            _sender = false;
            return;
        }
        _sendinger.Insert(0, lagret);
        await Logg.LoggAsync(_k.Id, avsender, $"Sendt til sendekø: {_valgtBank}{(valgtProdukt is null ? "" : $" · {valgtProdukt.Navn}")}");

        // Speil valget i «Delegert til bank» på kundekortet.
        if (string.IsNullOrWhiteSpace(_k.DelegertBank))
        {
            _k.DelegertBank = _valgtBank;
            await Svc.SetDelegertBankAsync(_k.Id, _valgtBank);
        }

        // Manuell sending: sett status «Sendt bank», og gi agenten eierskap automatisk
        // (tar saken hvis den er ueid; ellers beholdes eksisterende eier).
        _k.Status = KundekortService.StatusSendtBank;
        var eier = Session.Email ?? Session.UserName ?? "ukjent";
        if (string.IsNullOrWhiteSpace(_k.Eier))
        {
            _k.Eier = eier;
            _k.EierNavn = Session.UserName ?? eier;
            _k.EierTattAt = DateTime.UtcNow;
            await Svc.SetEierAsync(_k.Id, eier, _k.EierNavn, KundekortService.StatusSendtBank);
        }
        else
        {
            await Svc.SetStatusAsync(_k.Id, KundekortService.StatusSendtBank, avsender);
        }
        _endringslogg = await Logg.ForKundeAsync(_k.Id);

        _sendOk = true;
        _sendMsg = $"{_valgtBank}{(valgtProdukt is null ? "" : $" · {valgtProdukt.Navn}")}: lagt i kø — sendes automatisk ✓";
        _valgtProduktId = "";
        _sender = false;
    }

    private static string SendtKlasse(string? status) => status switch
    {
        SendStatus.Feilet => "err",
        SendStatus.IKo => "pending",
        _ => "on",
    };

    // Feltene er låst på et eksisterende kundekort — dobbeltklikk for å redigere.

    // Endringsrett: admin kan alltid; ellers må saken være uten eier eller eid av deg.
    // Eies saken av en annen, er den skrivebeskyttet (kun lesing).
    private bool EierAnnen => _isEdit && !string.IsNullOrWhiteSpace(_k.Eier)
        && !string.Equals(_k.Eier, Session.Email, StringComparison.OrdinalIgnoreCase)
        && !string.Equals(_k.Eier, Session.UserName, StringComparison.OrdinalIgnoreCase);
    private bool KanEndre => Session.IsAdmin || !EierAnnen;

    // Lukk saken og gå tilbake til oversikten agenten kom fra.
    private async Task Tilbake()
    {
        try { await JS.InvokeVoidAsync("history.back"); }
        catch { Nav.NavigateTo("/crm/database"); }
    }

    private string Behovssammendrag
    {
        get
        {
            var deler = new List<string>();
            deler.Add(_k.KundeType == "B2B" ? "Bedrift" : "Privatperson");
            if (!string.IsNullOrWhiteSpace(_k.Laanetype)) deler.Add($"ønsker {_k.Laanetype.ToLower()}");
            if (_k.OnsketLaanebelop is > 0) deler.Add($"på {_k.OnsketLaanebelop:N0} kr");
            if (_k.OnsketLopetidMnd is > 0) deler.Add($"over {_k.OnsketLopetidMnd} mnd");
            var s = string.Join(" ", deler) + ".";
            if (!string.IsNullOrWhiteSpace(_k.NavarendeBank)) s += $" Nåværende bank: {_k.NavarendeBank}.";
            return s;
        }
    }

    private async Task Save()
    {
        if (!KanEndre) return;
        _saving = true;
        _msg = null;
        // B2B: orgnr er egen kolonne, men kunde_id speiler det for gruppering.
        if (_k.KundeType == "B2B" && !string.IsNullOrWhiteSpace(_k.Orgnr))
        {
            _k.Orgnr = new string(_k.Orgnr.Where(char.IsDigit).ToArray());
            if (string.IsNullOrWhiteSpace(_k.KundeId)) _k.KundeId = _k.Orgnr;
        }
        // B2C: bruk fødselsnummer som gruppe-id når det er oppgitt (ellers faller vi tilbake på mobil).
        if (_k.KundeType == "B2C" && string.IsNullOrWhiteSpace(_k.KundeId) && !string.IsNullOrWhiteSpace(_k.Foedselsnummer))
            _k.KundeId = new string(_k.Foedselsnummer.Where(char.IsDigit).ToArray());
        // Tillat enten fødselsnr/orgnr eller mobilnummer som identifikator.
        if (string.IsNullOrWhiteSpace(_k.KundeId) && !string.IsNullOrWhiteSpace(_k.Mobilnummer))
            _k.KundeId = new string(_k.Mobilnummer.Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(_k.KundeId))
        {
            _ok = false;
            _msg = "Oppgi fødselsnummer/orgnr eller mobilnummer.";
            _saving = false;
            return;
        }
        if (_k.Id == Guid.Empty && string.IsNullOrWhiteSpace(_k.Kilde)) _k.Kilde = "Manuell";
        var (ok, error) = await Svc.SaveAsync(_k, strict: false, aktor: Session.UserName ?? Session.Email);
        _ok = ok;
        if (ok)
        {
            _msg = "Kundekort lagret.";
            _isEdit = true;
        }
        else
        {
            _msg = error ?? "Kunne ikke lagre.";
        }
        _saving = false;
    }
}
