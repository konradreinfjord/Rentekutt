@page "/crm/oppfolging"
@using RentkuttCRM.Services
@inject RentkuttCRM.Services.SessionState Session
@inject RentkuttCRM.Services.KundekortService Svc
@inject RentkuttCRM.Services.PartnerService Partners
@inject RentkuttCRM.Services.RutingsregelService Ruting
@inject RentkuttCRM.Services.BankSendingService BankSending
@inject RentkuttCRM.Services.OppfolgingService Oppf
@inject RentkuttCRM.Services.DialerService Dialer
@inject RentkuttCRM.Services.ArbeidslisteService Arbeidsliste
@inject RentkuttCRM.Services.SakerUiState Ui
@inject NavigationManager Nav

<PageTitle>Saker — Rentekutt</PageTitle>

<div class="wide-page"></div>

<h1 class="page-title">Saker</h1>
<p class="page-sub">Nye saker venter på å plukkes. Sakene du har plukket ligger under «Mine saker».</p>

<div class="db-stats" style="margin-bottom:18px">
    <div class="db-box click db-box--alle @(_delegertFilter == "" && !_kunOppgaver ? "on" : "")" @onclick='() => VelgDelegert("")'>
        <span class="db-box-num">@AktivBasis.Count()</span><span class="db-box-lbl">Alle saker</span>
    </div>
    @if (_arbeidsRegler.Count > 0)
    {
        <div class="db-box click ab-box @(_kunOppgaver ? "on" : "")" @onclick="VelgOppgaver">
            <span class="db-box-num">@AktivBasis.Count(HarOppgave)</span><span class="db-box-lbl">Har arbeidsoppgave</span>
        </div>
    }
    <div class="db-box click db-box--ingen @(_delegertFilter == "__ingen__" && !_kunOppgaver ? "on" : "")" @onclick='() => VelgDelegert("__ingen__")'>
        <span class="db-box-num">@AktivBasis.Count(k => string.IsNullOrWhiteSpace(k.DelegertBank))</span><span class="db-box-lbl">Ikke sendt til bank</span>
    </div>
    @foreach (var bank in _delegertBanker)
    {
        <div class="db-box click db-box--bank @(_delegertFilter == bank && !_kunOppgaver ? "on" : "")" @onclick="() => VelgDelegert(bank)">
            <span class="db-box-num">@AktivBasis.Count(k => string.Equals(k.DelegertBank, bank, StringComparison.OrdinalIgnoreCase))</span>
            <span class="db-box-lbl">Sendt til @bank</span>
        </div>
    }
</div>

<div class="kk-tabs" style="margin-bottom:16px">
    <button class="@(_tab == "alle" ? "active" : "")" @onclick='() => _tab = "alle"'>Alle saker (@_alleSaker.Count)</button>
    <button class="@(_tab == "nye" ? "active" : "")" @onclick='() => _tab = "nye"'>Nye saker (@_nyeSaker.Count)</button>
    <button class="@(_tab == "pagar" ? "active" : "")" @onclick='() => _tab = "pagar"'>Mine saker (@_rows.Count)</button>
    <button class="@(_tab == "oppfolginger" ? "active" : "")" @onclick='() => _tab = "oppfolginger"'>Oppfølginger (@_mineOppf.Count)</button>
</div>

@if (_tab == "alle")
{
    <div class="tf-bar">
        <div class="tf-seg">
            <button class="@(_alleType == "" ? "on" : "")" @onclick='() => _alleType = ""'>Alle</button>
            <button class="@(_alleType == "B2C" ? "on" : "")" @onclick='() => _alleType = "B2C"'>B2C</button>
            <button class="@(_alleType == "B2B" ? "on" : "")" @onclick='() => _alleType = "B2B"'>B2B</button>
        </div>
        @LaanetypeSeg
            @StatusSeg
        <span class="tf-count">@AlleVist.Count saker</span>
    </div>
    <div class="section">
        @if (_loading) { <p class="page-sub">Laster…</p> }
        else
        {
            <div class="table-scroll table-tall">
            <table class="data-table">
                <thead>@KundeThead</thead>
                <tbody>
                    @if (AlleVist.Count == 0)
                    {
                        <tr><td colspan="12" class="empty-row">Ingen saker i valgt filter.</td></tr>
                    }
                    @foreach (var k in AlleVist.OrderByDescending(k => k.CreatedAt))
                    {
                        <tr class="row-link" @onclick="() => Open(k.Id)">
                            @FellesCeller(k)
                            <td @onclick:stopPropagation="true"><button class="btn-sec btn-sm" @onclick="() => Open(k.Id)">Åpne</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (_tab == "nye")
{
    <div class="tf-bar">
        <div class="tf-seg">
            <button class="@(_nyeType == "" ? "on" : "")" @onclick='() => _nyeType = ""'>Alle</button>
            <button class="@(_nyeType == "B2C" ? "on" : "")" @onclick='() => _nyeType = "B2C"'>B2C</button>
            <button class="@(_nyeType == "B2B" ? "on" : "")" @onclick='() => _nyeType = "B2B"'>B2B</button>
        </div>
        @LaanetypeSeg
            @StatusSeg
        <span class="tf-count">@NyeVist.Count nye saker</span>
    </div>
    <div class="section">
        @if (_loading) { <p class="page-sub">Laster…</p> }
        else
        {
            <div class="table-scroll table-tall">
            <table class="data-table">
                <thead>@KundeThead</thead>
                <tbody>
                    @if (NyeVist.Count == 0)
                    {
                        <tr><td colspan="12" class="empty-row">Ingen nye saker akkurat nå — alle er plukket. 🎉</td></tr>
                    }
                    @foreach (var k in NyeVist.OrderByDescending(k => k.CreatedAt))
                    {
                        <tr class="row-link" @onclick="() => Open(k.Id)">
                            @FellesCeller(k)
                            <td @onclick:stopPropagation="true"><button class="btn-primary btn-sm" @onclick="() => Plukk(k)">Ta eierskap</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (_tab == "oppfolginger")
{
    <div class="section">
        <p class="page-sub" style="margin-top:0">Dine planlagte oppfølginger på tvers av søknader — forfalte først. Opprett dem på hver søknad under Oversikt → Oppfølginger.</p>
        <div class="tf-bar">
            <div class="tf-seg">
                <button class="@(_oppfType == "" ? "on" : "")" @onclick='() => _oppfType = ""'>Alle</button>
                <button class="@(_oppfType == "B2C" ? "on" : "")" @onclick='() => _oppfType = "B2C"'>B2C</button>
                <button class="@(_oppfType == "B2B" ? "on" : "")" @onclick='() => _oppfType = "B2B"'>B2B</button>
            </div>
            <div class="tf-seg">
                <button class="@(_oppfFilter == "" ? "on" : "")" @onclick='() => _oppfFilter = ""'>Alle <span class="n">@_mineOppf.Count</span></button>
                <button class="@(_oppfFilter == "forfalt" ? "on" : "")" @onclick='() => _oppfFilter = "forfalt"'>Forfalt <span class="n red">@_mineOppf.Count(o => o.Forfaller.Date < Tid.IDag)</span></button>
                <button class="@(_oppfFilter == "idag" ? "on" : "")" @onclick='() => _oppfFilter = "idag"'>I dag <span class="n">@_mineOppf.Count(o => o.Forfaller.Date == Tid.IDag)</span></button>
                <button class="@(_oppfFilter == "uke" ? "on" : "")" @onclick='() => _oppfFilter = "uke"'>Uke <span class="n">@_mineOppf.Count(o => ErInnen(o, 7))</span></button>
                <button class="@(_oppfFilter == "maaned" ? "on" : "")" @onclick='() => _oppfFilter = "maaned"'>Måned <span class="n">@_mineOppf.Count(o => ErInnen(o, 31))</span></button>
                <button class="@(_oppfFilter == "custom" ? "on" : "")" @onclick='() => _oppfFilter = "custom"'>Egendefinert</button>
            </div>
            @LaanetypeSeg
            @StatusSeg
            @if (_oppfFilter == "custom")
            {
                <div class="tf-custom">
                    <input type="date" class="tf-date" @bind="_oppfFra" />
                    <span class="tf-dash">–</span>
                    <input type="date" class="tf-date" @bind="_oppfTil" />
                </div>
            }
            <span class="tf-count">@OppfVist.Count oppfølginger</span>
        </div>
        @if (_loading)
        {
            <p class="page-sub">Laster…</p>
        }
        else if (OppfVist.Count == 0)
        {
            <p class="notat-empty">@(_mineOppf.Count == 0 ? "Ingen åpne oppfølginger. Opprett en på en søknad (Oversikt → Oppfølginger)." : "Ingen oppfølginger i valgt filter.")</p>
        }
        else
        {
            <div class="table-scroll table-tall">
            <table class="data-table">
                <thead>@KundeThead</thead>
                <tbody>
                    @foreach (var o in OppfVist)
                    {
                        var kort = KortFor(o.KundekortId);
                        <tr class="row-link" @onclick="() => Open(o.KundekortId)">
                            @if (kort is not null)
                            {
                                @FellesCeller(kort, OppfBadge(o))
                            }
                            else
                            {
                                <td>@o.Forfaller.ToString("dd.MM.yyyy HH:mm")</td><td>—</td><td>—</td><td>—</td><td>—</td>
                                <td>(ukjent søknad)@OppfBadge(o)</td><td>—</td><td>—</td><td>—</td><td>—</td><td>—</td>
                            }
                            <td @onclick:stopPropagation="true"><button class="btn-sec btn-sm" @onclick="() => FullforOppf(o)" title="Marker fullført">✓ Fullfør</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (_tab == "pagar")
{
<div class="tf-bar">
    <div class="tf-seg">
        <button class="@(_typeFilter == "" ? "on" : "")" @onclick='() => _typeFilter = ""'>Alle</button>
        <button class="@(_typeFilter == "B2C" ? "on" : "")" @onclick='() => _typeFilter = "B2C"'>B2C</button>
        <button class="@(_typeFilter == "B2B" ? "on" : "")" @onclick='() => _typeFilter = "B2B"'>B2B</button>
    </div>
    @LaanetypeSeg
            @StatusSeg
    @if (Session.IsAdmin)
    {
        <label class="page-sub" style="margin:0 0 0 4px; font-weight:600">Vis saker for:</label>
        <select class="db-select" @bind="_selectedEier" @bind:after="ApplyFilter">
            <option value="__mine__">Mine saker</option>
            <option value="__alle__">Alle rådgivere</option>
            @foreach (var o in _owners)
            {
                <option value="@o.Eier">@o.Navn (@o.Antall)</option>
            }
        </select>
    }
    <span class="tf-count">@Vist.Count saker</span>
</div>

<div class="section">
    @if (_loading)
    {
        <p class="page-sub">Laster…</p>
    }
    else
    {
        <div class="table-scroll table-tall">
        <table class="data-table">
            <thead>@KundeThead</thead>
            <tbody>
                @if (Vist.Count == 0)
                {
                    <tr><td colspan="12" class="empty-row">@(_selectedEier == "__mine__" ? "Du har ingen saker ennå — plukk en sak under Nye saker." : "Ingen saker på valgt rådgiver.")</td></tr>
                }
                @foreach (var k in Vist.OrderBy(SortNokkel))
                {
                    <tr class="row-link" @onclick="() => Open(k.Id)">
                        @FellesCeller(k)
                        <td @onclick:stopPropagation="true"><button class="btn-sec btn-sm" @onclick="() => Open(k.Id)">Åpne</button></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>
}

@code {
    private List<Kundekort> _rows = new();
    private bool _loading = true;
    private string _tab { get => Ui.Tab; set => Ui.Tab = value; }   // "alle" | "nye" | "pagar" | "oppfolginger"
    private List<OppfolgingOppgave> _mineOppf = new();          // mine åpne oppfølginger på tvers av søknader

    // Tidsromfilter for oppfølginger: "" = alle, forfalt, idag, uke, maaned, custom.
    private string _oppfFilter { get => Ui.OppfFilter; set => Ui.OppfFilter = value; }
    private string _oppfType { get => Ui.OppfType; set => Ui.OppfType = value; }   // kundetypefilter på oppfølgingsfanen
    private DateTime? _oppfFra { get => Ui.OppfFra; set => Ui.OppfFra = value; }
    private DateTime? _oppfTil { get => Ui.OppfTil; set => Ui.OppfTil = value; }
    private static bool ErInnen(OppfolgingOppgave o, int dager) => o.Forfaller.Date >= Tid.IDag && o.Forfaller.Date <= Tid.IDag.AddDays(dager);
    // Filtrert + sortert: forfalte øverst (eldst først), deretter kommende etter dato.
    private List<OppfolgingOppgave> OppfFiltrert => _mineOppf
        .Where(o => _oppfFilter switch
        {
            "forfalt" => o.Forfaller.Date < Tid.IDag,
            "idag" => o.Forfaller.Date == Tid.IDag,
            "uke" => ErInnen(o, 7),
            "maaned" => ErInnen(o, 31),
            "custom" => (_oppfFra is null || o.Forfaller.Date >= _oppfFra.Value.Date)
                        && (_oppfTil is null || o.Forfaller.Date <= _oppfTil.Value.Date),
            _ => true,
        })
        .OrderBy(o => o.Forfaller)
        .ToList();

    // Oppfølginger etter alle aktive filtre (tidsrom + kundetype + delegert bank).
    private List<OppfolgingOppgave> OppfVist => OppfFiltrert.Where(o =>
    {
        var kk = KortFor(o.KundekortId);
        if (kk is null) return !_kunOppgaver && _delegertFilter.Length == 0 && _oppfType.Length == 0 && _laanetypeFilter.Length == 0 && _statusFilter.Length == 0;
        return MatchDelegert(kk) && MatchLaan(kk) && MatchStatus(kk) && MatchOppgave(kk) && (_oppfType.Length == 0 || kk.KundeType == _oppfType);
    }).ToList();

    // Alle saker = hele basen (uansett eier/status).
    private List<Kundekort> _alleSaker = new();
    private string _alleType { get => Ui.AlleType; set => Ui.AlleType = value; }
    private List<Kundekort> AlleVist => (_alleType.Length == 0 ? _alleSaker : _alleSaker.Where(k => k.KundeType == _alleType))
        .Where(MatchDelegert).Where(MatchLaan).Where(MatchStatus).Where(MatchOppgave).ToList();

    // Nye saker = ingen eier + fortsatt aktiv (ikke fullført/avslått) — venter på å plukkes.
    private List<Kundekort> _nyeSaker = new();
    private string _nyeType { get => Ui.NyeType; set => Ui.NyeType = value; }

    // Delegert-bank-filter: "" = alle, "__ingen__" = ikke sendt, ellers banknavn. Filtrerer den aktive fanen.
    private string _delegertFilter { get => Ui.DelegertFilter; set => Ui.DelegertFilter = value; }
    private List<string> _delegertBanker = new();

    // Lånetypefilter (delt på tvers av fanene): "" = alle, ellers lånetypenavn.
    private string _laanetypeFilter { get => Ui.LaanetypeFilter; set => Ui.LaanetypeFilter = value; }
    private List<string> _laanetyper = new();
    private bool MatchLaan(Kundekort k) => _laanetypeFilter.Length == 0
        || string.Equals(string.IsNullOrWhiteSpace(k.Laanetype) ? "Ukjent" : k.Laanetype, _laanetypeFilter, StringComparison.OrdinalIgnoreCase);

    // Statusfilter (delt på tvers av fanene): "" = alle, ellers statusnavn.
    private string _statusFilter { get => Ui.StatusFilter; set => Ui.StatusFilter = value; }
    private bool _visStatus { get => Ui.VisStatus; set => Ui.VisStatus = value; }   // status-kategoriene er skjult til man trykker «Status»

    // Arbeidsliste: regler → arbeidsoppgaver pr. sak, og filter «Har arbeidsoppgave».
    private List<ArbeidsRegel> _arbeidsRegler = new();
    private Dictionary<string, Dictionary<string, OppgaveTilstand>> _oppgaveTilstander = new();
    private bool _kunOppgaver { get => Ui.KunOppgaver; set => Ui.KunOppgaver = value; }
    // Boksene øverst er gjensidig utelukkende: å velge en delegert-boks løsner «Har arbeidsoppgave», og omvendt.
    private void VelgDelegert(string b) { _delegertFilter = b; _kunOppgaver = false; }
    private void VelgOppgaver() { _kunOppgaver = !_kunOppgaver; if (_kunOppgaver) _delegertFilter = ""; }
    private List<string> Oppgaver(Kundekort k) =>
        ArbeidslisteService.AktiveOppgaver(k, _arbeidsRegler, _oppgaveTilstander, DateTime.UtcNow).Select(o => o.Oppgave).ToList();
    private bool HarOppgave(Kundekort k) => _arbeidsRegler.Count > 0 && Oppgaver(k).Count > 0;
    private bool MatchOppgave(Kundekort k) => !_kunOppgaver || HarOppgave(k);

    // «Status» (skjult) ⇄ «Alle statuser» (vist). Å trykke «Alle statuser» nullstiller filteret og lukker igjen.
    private void ToggleStatus()
    {
        if (_visStatus) { _statusFilter = ""; _visStatus = false; }
        else _visStatus = true;
    }
    private List<string> _statusValg = new();
    private bool MatchStatus(Kundekort k) => _statusFilter.Length == 0 || k.Status == _statusFilter;

    // Badge-farge per status (samme som Marked/Database/kundekort).
    private static string StatusKlasse(string s) => s switch
    {
        "Påbegynt søknad" => "st-gul", "Nytt lead" => "st-gul", "Ny søknad" => "st-gul",
        "Oppfølging" => "st-oppfolging", "Pågår - Agent" => "st-pagar", "Sendt til bank" => "st-sendt",
        "Sendt til bank - Timeout" => "st-avslatt", "SBL Signert" => "st-pagar",
        "Utbetalt" => "st-fullfort", "Avslag" => "st-avslatt", "Avsluttet" => "st-kansellert", "Kansellert" => "st-kansellert",
        "Teknisk feil" => "st-avslatt", _ => "on",
    };

    // Gruppert rekkefølge på status-knappene.
    private static readonly (string Gruppe, string[] Statuser)[] StatusGrupper =
    {
        ("Ny", new[] { "Påbegynt søknad", "Nytt lead", "Ny søknad" }),
        ("Pågår", new[] { "SBL Signert", "Sendt til bank", "Teknisk feil", "Oppfølging", "Pågår - Agent", "Sendt til bank - Timeout" }),
        ("Ferdig", new[] { "Utbetalt", "Avslag", "Kansellert" }),
    };
    // Statuser som alltid vises i sin gruppe (også med 0 treff), så kategoriene aldri er «skjult» før data er lastet.
    private static readonly HashSet<string> KjerneStatuser = new()
    {
        "Påbegynt søknad", "Nytt lead", "Ny søknad",
        "SBL Signert", "Sendt til bank", "Teknisk feil", "Oppfølging",
        "Utbetalt", "Avslag", "Kansellert",
    };
    private bool MatchDelegert(Kundekort k) => _delegertFilter switch
    {
        "" => true,
        "__ingen__" => string.IsNullOrWhiteSpace(k.DelegertBank),
        var b => string.Equals(k.DelegertBank, b, StringComparison.OrdinalIgnoreCase),
    };

    // Grunnlaget for den aktive fanen (før delegert-filter) — brukes til boks-tellingene.
    private IEnumerable<Kundekort> AktivBasis => _tab switch
    {
        "alle" => (_alleType.Length == 0 ? _alleSaker : _alleSaker.Where(k => k.KundeType == _alleType)).Where(MatchLaan).Where(MatchStatus),
        "nye" => (_nyeType.Length == 0 ? _nyeSaker : _nyeSaker.Where(k => k.KundeType == _nyeType)).Where(MatchLaan).Where(MatchStatus),
        "pagar" => TypeBasis.Where(MatchLaan).Where(MatchStatus),
        "oppfolginger" => OppfFiltrert.Select(o => KortFor(o.KundekortId)).Where(k => k is not null && (_oppfType.Length == 0 || k.KundeType == _oppfType) && MatchLaan(k) && MatchStatus(k))!,
        _ => Enumerable.Empty<Kundekort>(),
    };

    private List<Kundekort> NyeVist => (_nyeType.Length == 0 ? _nyeSaker : _nyeSaker.Where(k => k.KundeType == _nyeType))
        .Where(MatchDelegert).Where(MatchLaan).Where(MatchStatus).Where(MatchOppgave).ToList();

    // Aktiv fanes rader med alle filtre UNNTATT status — brukes til antall i status-knappene.
    private List<Kundekort> StatusTellBasis()
    {
        IEnumerable<Kundekort> b = _tab switch
        {
            "alle" => _alleType.Length == 0 ? _alleSaker : _alleSaker.Where(k => k.KundeType == _alleType),
            "nye" => _nyeType.Length == 0 ? _nyeSaker : _nyeSaker.Where(k => k.KundeType == _nyeType),
            "pagar" => TypeBasis,
            "oppfolginger" => OppfFiltrert.Select(o => KortFor(o.KundekortId)).Where(k => k is not null && (_oppfType.Length == 0 || k!.KundeType == _oppfType))!,
            _ => Enumerable.Empty<Kundekort>(),
        };
        return b.Where(MatchDelegert).Where(MatchLaan).ToList();
    }

    // Delt status-filter (knapper) — inline, gruppert med små etiketter (Ny/Pågår/Ferdig) + antall.
    private RenderFragment StatusSeg =>
        @<text>
        @{ var tell = StatusTellBasis(); var rest = _statusValg.Where(s => !StatusGrupper.Any(g => g.Statuser.Contains(s))).ToList(); }
        <div class="tf-statusgrp">
            <div class="tf-seg tf-alle">
                <button class="@(_visStatus ? "on" : "")" @onclick="ToggleStatus">
                    @(_visStatus ? "Alle statuser" : "Status")
                    @if (!_visStatus && _statusFilter != "") { <span class="n">1</span> }
                    else if (_visStatus) { <span class="n">@tell.Count</span> }
                </button>
            </div>
            @if (_visStatus)
            {
            @foreach (var g in StatusGrupper)
            {
                var present = g.Statuser.Where(s => _statusValg.Contains(s) || KjerneStatuser.Contains(s)).ToList();
                @if (present.Count > 0)
                {
                    <div class="tf-group tf-group-@g.Gruppe.ToLower()">
                        <span class="tf-grouplbl">@g.Gruppe</span>
                        <div class="tf-seg">
                            @foreach (var s in present)
                            {
                                <button class="@(_statusFilter == s ? "on" : "")" @onclick="() => _statusFilter = s">@s <span class="n">@tell.Count(k => k.Status == s)</span></button>
                            }
                        </div>
                    </div>
                }
            }
            @if (rest.Count > 0)
            {
                <div class="tf-group">
                    <span class="tf-grouplbl">Annet</span>
                    <div class="tf-seg">
                        @foreach (var s in rest)
                        {
                            <button class="@(_statusFilter == s ? "on" : "")" @onclick="() => _statusFilter = s">@s <span class="n">@tell.Count(k => k.Status == s)</span></button>
                        }
                    </div>
                </div>
            }
            }
        </div>
        </text>;

    // Delt lånetype-filter (knapper) — vises i alle fanene.
    private RenderFragment LaanetypeSeg =>
        @<div class="tf-seg">
            <button class="@(_laanetypeFilter == "" ? "on" : "")" @onclick='() => _laanetypeFilter = ""'>Alle lån</button>
            @foreach (var t in _laanetyper)
            {
                <button class="@(_laanetypeFilter == t ? "on" : "")" @onclick="() => _laanetypeFilter = t">@t</button>
            }
        </div>;

    // Felles kolonner for alle tabellene (nye saker / mine saker / oppfølging).
    private RenderFragment KundeThead =>
        @<tr><th>Opprettet</th><th>Arbeidsoppgave</th><th>Status</th><th>Sendt til bank</th><th>Ringelogg</th><th>Navn</th><th>Type</th><th>Telefon</th><th>Lånetype</th><th>Ønsket beløp</th><th>Leadskilde</th><th>Handling</th></tr>;

    // Forfaller-merke i Navn-kolonnen på oppfølgingsfanen: rød «Forfalt N d» eller kommende dato.
    private RenderFragment OppfBadge(OppfolgingOppgave o) =>
        @<text>@if (o.Forfaller.Date < Tid.IDag)
        {
            <span class="forfalt-badge">Forfalt @((Tid.IDag - o.Forfaller.Date).Days) d</span>
        }
        else
        {
            <span class="opf-date @OppfKlasse(o)" style="margin-left:8px; font-weight:600">Forfaller @o.Forfaller.ToString("dd.MM")</span>
        }</text>;

    private RenderFragment FellesCeller(Kundekort k, RenderFragment? navnBadge = null) =>
        @<text>
            <td>@k.CreatedAt.TilOslo().ToString("dd.MM.yyyy HH:mm")</td>
            <td>
                @{ var oppg = Oppgaver(k); }
                @if (oppg.Count == 0) { <span class="muted">—</span> }
                else { @foreach (var o in oppg) { <span class="arbeidsoppgave-badge" title="@o">@o</span> } }
            </td>
            <td><span class="status @StatusKlasse(k.Status)">@k.Status</span>@if (!string.IsNullOrWhiteSpace(k.AvslagGrunn)) { <div class="avslag-grunn" title="@k.AvslagGrunn">@k.AvslagGrunn</div> }</td>
            <td>@if (string.IsNullOrWhiteSpace(k.DelegertBank)) { <span class="muted">—</span> } else { <span>@k.DelegertBank</span> }</td>
            <td>
                @if (_ringelogg.TryGetValue(k.Id, out var rl))
                {
                    <span class="ringelogg-badge" title="@rl.Antall ringeforsøk · sist @RingSiden(rl.Sist)">
                        <svg viewBox="0 0 24 24" width="12" height="12"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <b>@rl.Antall</b><span class="rl-sist">@RingSiden(rl.Sist)</span>
                    </span>
                }
                else { <span class="muted">—</span> }
            </td>
            <td>@(string.IsNullOrWhiteSpace(k.FulltNavn) ? "—" : k.FulltNavn)@navnBadge</td>
            <td><span class="type-tag @(k.KundeType == "B2C" ? "lead" : "bank")">@k.KundeType</span></td>
            <td class="mono-cell">@(string.IsNullOrWhiteSpace(k.Mobilnummer) ? "—" : k.Mobilnummer)</td>
            <td>@(string.IsNullOrWhiteSpace(k.Laanetype) ? "—" : k.Laanetype)</td>
            <td>@(k.OnsketLaanebelop.HasValue ? $"{k.OnsketLaanebelop:N0} kr" : "—")</td>
            <td>@if (string.IsNullOrWhiteSpace(k.Kilde)) { <span class="muted">—</span> } else { <span class="kilde-badge @KundekortService.KildeBadgeKlasse(k.Kilde)">@k.Kilde</span> }</td>
        </text>;

    private Kundekort? KortFor(Guid id) => _rows.FirstOrDefault(k => k.Id == id) ?? _alleEide.FirstOrDefault(k => k.Id == id);

    private static string OppfKlasse(OppfolgingOppgave o)
    {
        if (o.Forfaller.Date < Tid.IDag) return "opf-rod";
        if (o.Forfaller.Date == Tid.IDag) return "opf-amber";
        return "";
    }

    private async Task FullforOppf(OppfolgingOppgave o)
    {
        await Oppf.FullforAsync(o.Id, o.KundekortId);
        _mineOppf = await Oppf.AapneForEierAsync(MittEier);
    }

    // Admin kan bytte hvilken rådgivers saker som vises.
    private string _selectedEier { get => Ui.SelectedEier; set => Ui.SelectedEier = value; }
    private List<Kundekort> _alleEide = new();
    private List<(string Eier, string Navn, int Antall)> _owners = new();
    private string MittEier => Session.Email ?? Session.UserName ?? "";
    // Vis rådgiver-kolonne når admin ser andres/alle saker.
    private bool VisEier => Session.IsAdmin && _selectedEier != "__mine__";

    // Skille B2B/B2C: "" = begge, ellers "B2C"/"B2B".
    private string _typeFilter { get => Ui.TypeFilter; set => Ui.TypeFilter = value; }
    // Sendt-til-bank-hurtigfilter: "" = alle, "sendt" = sendt til bank, "ikke" = ikke sendt.
    private string _sendtFilter { get => Ui.SendtFilter; set => Ui.SendtFilter = value; }

    // Type-filtrert grunnlag (før sendt-filter) — brukes til hurtigknapp-tellingene.
    private IEnumerable<Kundekort> TypeBasis => _typeFilter.Length == 0 ? _rows : _rows.Where(k => k.KundeType == _typeFilter);

    private List<Kundekort> Vist
    {
        get
        {
            var q = TypeBasis.Where(MatchDelegert).Where(MatchLaan).Where(MatchStatus).Where(MatchOppgave);
            if (_sendtFilter == "sendt") q = q.Where(ErSendtTilBank);
            else if (_sendtFilter == "ikke") q = q.Where(k => !ErSendtTilBank(k));
            return q.ToList();
        }
    }

    // «Sendt til bank» = det finnes en sending som er levert (Sendt) eller registrert manuelt.
    // I kø / feilet regnes ikke som sendt.
    private bool ErSendtTilBank(Kundekort k)
    {
        var s = SendtFor(k);
        return s is not null && (s.Status == SendStatus.Sendt || s.Status == SendStatus.Manuelt);
    }

    private string TypeLabel => _typeFilter switch { "B2C" => "Privatsaker", "B2B" => "Bedriftssaker", _ => VisEier ? "Saker i visning" : "Mine saker" };

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        if (Session.IsAdmin)
        {
            // Admin: last alle eide saker én gang, bygg rådgiverliste, vis egne som standard.
            _alleEide = (await Svc.ListLettAsync()).Where(k => !string.IsNullOrWhiteSpace(k.Eier)).ToList();
            _owners = _alleEide
                .GroupBy(k => k.Eier!)
                .Select(g => (Eier: g.Key, Navn: g.First().EierNavn ?? g.Key, Antall: g.Count()))
                .OrderByDescending(x => x.Antall).ThenBy(x => x.Navn)
                .ToList();
            ApplyFilter();
        }
        else
        {
            _rows = await Svc.ListByEierAsync(MittEier);
        }

        // Hele basen + nye saker (ingen eier + fortsatt aktiv — felles kø alle kan plukke fra).
        _alleSaker = await Svc.ListLettAsync();
        _nyeSaker = _alleSaker
            .Where(k => string.IsNullOrWhiteSpace(k.Eier)
                        && k.Status is not (KundekortService.StatusUtbetalt or KundekortService.StatusAvslatt
                                            or KundekortService.StatusAvsluttet or "Kansellert"))
            .ToList();

        // For «Forslag til bank» (rutingsregler) og «Sendt til bank» (sendestatus).
        _partnere = await Partners.ListAsync();
        _regler = await Ruting.ListAsync();
        _sendtPerKort = await BankSending.SisteePerKundekortAsync();
        _mineOppf = await Oppf.AapneForEierAsync(MittEier);
        _ringelogg = await Dialer.HentSammendragAsync();
        _arbeidsRegler = await Arbeidsliste.HentAsync();
        _oppgaveTilstander = await Arbeidsliste.HentTilstanderAsync();

        // Delegert-bank-filterbokser: distinkte banker på tvers av alle sakene i visningen.
        _delegertBanker = _alleSaker
            .Select(k => k.DelegertBank)
            .Where(b => !string.IsNullOrWhiteSpace(b))
            .Select(b => b!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(b => b)
            .ToList();
        _laanetyper = _alleSaker
            .Select(k => string.IsNullOrWhiteSpace(k.Laanetype) ? "Ukjent" : k.Laanetype!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t)
            .ToList();
        // Statuser som faktisk finnes i basen, i kanonisk rekkefølge.
        var finnes = _alleSaker.Select(k => k.Status).Where(s => !string.IsNullOrWhiteSpace(s)).ToHashSet();
        _statusValg = KundekortService.Statuser.Where(finnes.Contains)
            .Concat(finnes.Where(s => !KundekortService.Statuser.Contains(s)))
            .ToList();

        _loading = false;
    }

    private Dictionary<Guid, (int Antall, DateTime Sist)> _ringelogg = new();
    private static string RingSiden(DateTime utc)
    {
        var d = DateTime.UtcNow - utc.ToUniversalTime();
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes} min";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours} t";
        if (d.TotalDays < 30) return $"{(int)d.TotalDays} d";
        return utc.TilOslo().ToString("dd.MM.yyyy");
    }

    // Ta eierskap til en ny sak → flytt «Ny søknad» til «Pågår - Agent», åpne kortet.
    private async Task Plukk(Kundekort k)
    {
        var eier = MittEier;
        var nyStatus = k.Status == KundekortService.StatusNySoknad ? KundekortService.StatusPagaarAgent : null;
        await Svc.SetEierAsync(k.Id, eier, Session.UserName ?? eier, nyStatus);
        _nyeSaker.RemoveAll(x => x.Id == k.Id);
        Open(k.Id);
    }

    private List<Partner> _partnere = new();
    private List<Rutingsregel> _regler = new();
    private Dictionary<Guid, BankSending> _sendtPerKort = new();

    private List<string> ForslagBank(Kundekort k) => RutingEval.ForeslaBanker(_regler, k, _partnere);
    private BankSending? SendtFor(Kundekort k) => _sendtPerKort.TryGetValue(k.Id, out var s) ? s : null;

    private static string SendtStatusKlasse(string? status) => status switch
    {
        SendStatus.Feilet => "err",
        SendStatus.IKo => "pending",
        _ => "on",
    };

    // Filtrer admin-visningen etter valgt rådgiver (kun admin bruker denne).
    private void ApplyFilter()
    {
        _rows = _selectedEier switch
        {
            "__alle__" => _alleEide.ToList(),
            "__mine__" => _alleEide.Where(k => k.Eier == MittEier).ToList(),
            var e => _alleEide.Where(k => k.Eier == e).ToList(),
        };
    }

    // Sortér: forfalt/manglende oppfølging øverst, deretter etter neste oppfølging.
    private static DateTime SortNokkel(Kundekort k) => k.NesteOppfolging ?? DateTime.MinValue;

    // Snitt tid per sak = snittalder (nå − opprettet) på sakene i visning.
    private string SnittTid => Vist.Count == 0
        ? "—"
        : Alder(TimeSpan.FromTicks((long)Vist.Average(k => (DateTime.UtcNow - k.CreatedAt.ToUniversalTime()).Ticks)));

    private static string Alder(TimeSpan t) =>
        t.TotalDays >= 1
            ? $"{(int)t.TotalDays} d {t.Hours} t"
            : t.TotalHours >= 1 ? $"{(int)t.TotalHours} t" : $"{(int)t.TotalMinutes} min";

    // ---- Neste oppfølging ----
    private static string OppfolgingKlasse(Kundekort k)
    {
        if (k.NesteOppfolging is not { } n) return "";
        if (n.Date < Tid.IDag) return "opf-rod";
        if (n.Date == Tid.IDag) return "opf-amber";
        return "";
    }

    private async Task SetOppfolging(Kundekort k, ChangeEventArgs e)
    {
        DateTime? dato = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;
        k.NesteOppfolging = dato;
        await Svc.SetNesteOppfolgingAsync(k.Id, dato);
    }

    private void Open(Guid id) => Nav.NavigateTo($"/crm/ny-kunde?id={id}");
}
