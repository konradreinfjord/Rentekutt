@page "/crm/admin"
@inject RentkuttCRM.Services.SessionState Session
@inject RentkuttCRM.Services.CustomerFieldCatalog Catalog
@inject RentkuttCRM.Services.SupabaseUserService Users
@inject RentkuttCRM.Services.WebhookService Webhooks
@inject RentkuttCRM.Services.WebhookPayloadService Payloads
@inject RentkuttCRM.Services.LeadMottakService LeadMottak
@inject RentkuttCRM.Services.LinkMobilityService LinkMobility
@inject RentkuttCRM.Services.SettingsService Settings
@inject RentkuttCRM.Services.EventService Events
@inject RentkuttCRM.Services.PartnerService Partners
@inject RentkuttCRM.Services.PartnerProduktService Produkter
@inject RentkuttCRM.Services.SmsMalService SmsMaler
@inject RentkuttCRM.Services.InstabankService Instabank
@inject RentkuttCRM.Services.GjeldsregisterService Gjeld
@inject RentkuttCRM.Services.BankSendingService BankSending
@inject RentkuttCRM.Services.RutingsregelService Ruting
@inject RentkuttCRM.Services.MerknadsregelService Merknad
@inject RentkuttCRM.Services.BeregningService Beregning
@inject RentkuttCRM.Services.GdprService Gdpr
@inject RentkuttCRM.Services.KundekortService Kunder
@inject RentkuttCRM.Services.CryptoService Krypto
@inject RentkuttCRM.Services.DatabaseMigrator Migrator
@inject RentkuttCRM.Services.AlarmService Alarm
@inject RentkuttCRM.Services.ZissonService Zisson
@inject Microsoft.Extensions.Hosting.IHostEnvironment Env
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Admin — Rentekutt</PageTitle>

<h1 class="page-title">Admin</h1>
<p class="page-sub">Brukere, tilgang, integrasjoner og personvern.</p>

<div class="tabs">
    @foreach (var t in _tabs)
    {
        <button class="tab @(t == _active ? "active" : "")" @onclick="() => SettFane(t)">@t</button>
    }
</div>

@if (_active == "Generelt")
{
    <div class="section">
        <h2>SLA-frister</h2>
        <table class="data-table">
            <thead><tr><th>Hendelse</th><th>Frist</th></tr></thead>
            <tbody>
                @foreach (var s in _slas)
                {
                    <tr><td>@s.Label</td><td><input class="inline-input" value="@s.Hours" /> t</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="section">
        <h2>Sending til bank — timeout</h2>
        <p class="page-sub" style="margin:-4px 0 12px">
            Når en sak (privat eller bedrift) settes til <strong>«Sendt bank»</strong>, settes den automatisk til
            <strong>«Sendt til bank - Timeout»</strong> etter angitt antall dager. <strong>0 = av.</strong>
        </p>
        <div class="rule-builder" style="align-items:flex-end">
            <div class="rb-field rb-op" style="max-width:190px">
                <label>Antall dager før timeout</label>
                <input class="rb-input" type="number" min="0" @bind="_timeoutDager" />
            </div>
            <button class="btn-primary rb-add" @onclick="LagreTimeout">Lagre</button>
        </div>
        @if (!string.IsNullOrEmpty(_timeoutMsg)) { <p class="page-sub" style="margin:8px 0 0; font-size:12px">@_timeoutMsg</p> }
    </div>
}
else if (_active == "Partnere")
{
    <div class="section">
        <h2>Bankpartnere & provisjonssatser <span class="pill pill-warn">@_banks.Count</span></h2>
        <p class="page-sub" style="margin:-4px 0 14px">Postnummer-dekning og automatisk sending styres under <strong>Logikk-matrise</strong>.</p>
        <table class="data-table">
            <thead><tr><th>Bank</th><th>Provisjon %</th><th>Engangssum per godkjent søknad (kr)</th></tr></thead>
            <tbody>
                @if (_banks.Count == 0)
                {
                    <tr><td colspan="3" class="empty-row">Ingen bankpartnere ennå — legg til under.</td></tr>
                }
                @foreach (var b in _banks)
                {
                    <tr>
                        <td>@b.Navn</td>
                        <td @ondblclick="() => _compUnlocked.Add(b.Id)">
                            @if (_compUnlocked.Contains(b.Id))
                            {
                                <input class="inline-input" value="@b.Provisjon" @onchange="e => SaveProvisjon(b, e)" /> <span>%</span>
                            }
                            else
                            {
                                <span class="locked-comp" title="Dobbeltklikk for å endre">🔒 @(string.IsNullOrWhiteSpace(b.Provisjon) ? "0" : b.Provisjon) %</span>
                            }
                        </td>
                        <td @ondblclick="() => _compUnlocked.Add(b.Id)">
                            @if (_compUnlocked.Contains(b.Id))
                            {
                                <input class="inline-input" style="width:90px" value="@b.Engangssum" @onchange="e => SaveEngangssum(b, e)" /> <span>kr</span>
                                <button class="btn-sm" @onclick="() => _compUnlocked.Remove(b.Id)">Lås</button>
                            }
                            else
                            {
                                <span class="locked-comp" title="Dobbeltklikk for å endre">🔒 @(string.IsNullOrWhiteSpace(b.Engangssum) ? "0" : b.Engangssum) kr</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="section">
        <h2>Produkter per bank</h2>
        <p class="page-sub" style="margin:-4px 0 14px">Provisjon og engangssum settes per produkt. <strong>Segment</strong> styrer om produktet vises for privat (B2C) eller bedrift (B2B) på kundekortet. Banker uten produkter bruker bank-nivå provisjon over. Instabank-produktene har faste API-koder.</p>
        @if (!string.IsNullOrEmpty(_prodMsg))
        {
            <p class="page-sub" style="margin:-6px 0 14px; font-size:12.5px; color:@(_prodOk ? "var(--green-dark)" : "var(--danger, #b42318)")">@_prodMsg</p>
        }
        @if (_banks.Count == 0)
        {
            <p class="page-sub" style="margin:0">Legg til en bankpartner først.</p>
        }
        @foreach (var b in _banks)
        {
            var prod = ProdukterFor(b.Id);
            <div style="margin-bottom:20px">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px">
                    <h3 class="ww-h" style="margin:0">@b.Navn @(InstabankService.ErInstabankNavn(b.Navn) ? "(API)" : "")</h3>
                    @if (_addProduktForBank != b.Id)
                    {
                        <button class="btn-sm" @onclick="() => ApneAddProdukt(b.Id)">+ Produkt</button>
                    }
                </div>
                @if (prod.Count == 0 && _addProduktForBank != b.Id)
                {
                    <p class="page-sub" style="margin:0; font-size:12.5px">Ingen produkter — vises uten produktvalg ved sending.</p>
                }
                else if (prod.Count > 0)
                {
                    <table class="data-table">
                        <thead><tr><th>Produkt</th><th>Segment</th><th>Kode</th><th>Lånetyper (auto-valg)</th><th>Provisjon %</th><th>Engangssum (kr)</th><th>Aktiv</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in prod)
                            {
                                <tr>
                                    <td>
                                        @if (_editProduktId == p.Id)
                                        { <input class="inline-input" style="width:130px" @bind="_epNavn" /> }
                                        else
                                        { @p.Navn }
                                    </td>
                                    <td>
                                        @if (_editProduktId == p.Id)
                                        {
                                            <select class="inline-input" @bind="_epSegment"><option value="privat">Privat</option><option value="bedrift">Bedrift</option></select>
                                        }
                                        else
                                        { <span class="type-tag">@(p.ErBedrift ? "Bedrift" : "Privat")</span> }
                                    </td>
                                    <td class="mono-cell">
                                        @if (_editProduktId == p.Id)
                                        { <input class="inline-input" style="width:60px" @bind="_epKode" placeholder="—" /> }
                                        else
                                        { @(p.Kode?.ToString() ?? "—") }
                                    </td>
                                    <td><input class="inline-input" style="width:160px" value="@p.Laanetyper" @onchange="e => SaveProduktLaanetyper(p, e)" placeholder="alle (ingen auto)" title="Komma-separerte lånetyper produktet auto-velges for" /></td>
                                    <td @ondblclick="() => _prodCompUnlocked.Add(p.Id)">
                                        @if (_prodCompUnlocked.Contains(p.Id))
                                        { <input class="inline-input" style="width:70px" value="@p.Provisjon" @onchange="e => SaveProduktProvisjon(p, e)" /> }
                                        else
                                        { <span class="locked-comp" title="Dobbeltklikk for å endre">🔒 @(string.IsNullOrWhiteSpace(p.Provisjon) ? "0" : p.Provisjon) %</span> }
                                    </td>
                                    <td @ondblclick="() => _prodCompUnlocked.Add(p.Id)">
                                        @if (_prodCompUnlocked.Contains(p.Id))
                                        { <input class="inline-input" style="width:90px" value="@p.Engangssum" @onchange="e => SaveProduktEngangssum(p, e)" /> }
                                        else
                                        { <span class="locked-comp" title="Dobbeltklikk for å endre">🔒 @(string.IsNullOrWhiteSpace(p.Engangssum) ? "0" : p.Engangssum) kr</span> }
                                    </td>
                                    <td><button class="btn-sm @(p.Aktiv ? "" : "btn-danger")" @onclick="() => ToggleProduktAktiv(p)">@(p.Aktiv ? "På" : "Av")</button></td>
                                    <td>
                                        @if (_editProduktId == p.Id)
                                        {
                                            <button class="btn-sm btn-primary" @onclick="() => LagreEndretProdukt(p)">Lagre</button>
                                            <button class="btn-sm" @onclick="() => _editProduktId = null">Avbryt</button>
                                        }
                                        else
                                        {
                                            <button class="btn-sm" @onclick="() => StartEndreProdukt(p)">Endre</button>
                                            <button class="btn-sm btn-danger" @onclick="() => SlettProdukt(p)">Slett</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (_addProduktForBank == b.Id)
                {
                    <div class="rule-builder" style="margin-top:10px">
                        <div class="rb-field"><label>Produktnavn</label><input class="rb-input" @bind="_npNavn" placeholder="f.eks. Forbrukslån" /></div>
                        <div class="rb-field rb-op" style="max-width:130px"><label>Segment</label>
                            <select class="rb-input" @bind="_npSegment"><option value="privat">Privat</option><option value="bedrift">Bedrift</option></select>
                        </div>
                        <div class="rb-field rb-op" style="max-width:110px"><label>Kode (API)</label><input class="rb-input" @bind="_npKode" placeholder="valgfri" /></div>
                        <div class="rb-field" style="max-width:180px"><label>Lånetyper (auto-valg)</label><input class="rb-input" @bind="_npLaanetyper" placeholder="f.eks. Forbrukslån,Refinansiering" /></div>
                        <div class="rb-field rb-op" style="max-width:110px"><label>Provisjon %</label><input class="rb-input" @bind="_npProvisjon" placeholder="0,00" /></div>
                        <div class="rb-field rb-op" style="max-width:130px"><label>Engangssum</label><input class="rb-input" @bind="_npEngangssum" placeholder="0" /></div>
                        <button class="btn-primary rb-add" @onclick="() => LagreNyttProdukt(b.Id)">Legg til</button>
                        <button class="btn-logout rb-add" @onclick="() => _addProduktForBank = null">Avbryt</button>
                    </div>
                }
            </div>
        }
    </div>

    <div class="section">
        <h2>Ny partner</h2>
        <div class="rule-builder">
            <div class="rb-field"><label>Banknavn</label><input class="rb-input" @bind="_nbName" placeholder="f.eks. DNB" /></div>
            <div class="rb-field rb-op" style="max-width:130px"><label>Provisjon %</label><input class="rb-input" @bind="_nbRate" placeholder="1,20" /></div>
            <div class="rb-field rb-op" style="max-width:170px"><label>Engangssum (kr)</label><input class="rb-input" @bind="_nbEngangssum" placeholder="0" /></div>
            <button class="btn-primary rb-add" @onclick="AddBank">Legg til partner</button>
        </div>
        @if (!string.IsNullOrEmpty(_nbMsg))
        {
            <p class="page-sub" style="margin-top:10px">@_nbMsg</p>
        }
    </div>
}
else if (_active == "Brukere")
{
    <div class="section">
        <h2>Brukere <span class="pill pill-warn">@_userRows.Count</span></h2>
        @if (_loadingUsers)
        {
            <p class="page-sub">Laster brukere…</p>
        }
        else
        {
            <table class="data-table">
                <thead><tr><th>Navn</th><th>E-post</th><th>Mobil (2FA)</th><th>Rolle</th><th>2FA</th><th>Nytt passord</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var u in _userRows)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(u.FullName) ? "—" : u.FullName)</td>
                            <td class="mono-cell">@u.Email</td>
                            <td>
                                <span class="token-row">
                                    <input class="inline-input" style="width:110px" placeholder="+47…"
                                           value="@MobilInput(u)" @onchange="e => SetMobilInput(u.Id, e)" />
                                    <button class="btn-sm" @onclick="() => SaveMobil(u)">Lagre</button>
                                </span>
                            </td>
                            <td>
                                <select class="inline-select" @onchange="e => ChangeRole(u, e)">
                                    @foreach (var r in SupabaseUserService.Roles)
                                    {
                                        <option value="@r" selected="@(r == u.Role)">@r</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <button class="btn-sm @(u.TwoFactorEnabled ? "" : "btn-danger")" @onclick="() => ToggleTwoFactor(u)">
                                    @(u.TwoFactorEnabled ? "På" : "Av")
                                </button>
                            </td>
                            <td>
                                <span class="token-row">
                                    <input class="inline-input" type="password" style="width:96px" placeholder="nytt"
                                           value="@PwInput(u.Id)" @onchange="e => SetPwInput(u.Id, e)" />
                                    <button class="btn-sm" @onclick="() => SetPassword(u)">Sett</button>
                                </span>
                            </td>
                            <td><span class="status @(u.Active ? "on" : "off")">@(u.Active ? "Aktiv" : "Deaktivert")</span></td>
                            <td><button class="btn-sm btn-danger" @onclick="() => ToggleActive(u)">@(u.Active ? "Deaktiver" : "Aktiver")</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (!string.IsNullOrEmpty(_pwMsg))
    {
        <p class="page-sub" style="margin:-8px 0 18px">@_pwMsg</p>
    }

    <div class="section">
        <h2>Ny bruker</h2>
        <div class="rule-builder">
            <div class="rb-field"><label>Navn</label><input class="rb-input" @bind="_nuName" placeholder="Fullt navn" /></div>
            <div class="rb-field"><label>E-post</label><input class="rb-input" @bind="_nuEmail" placeholder="navn@rentekutt.no" /></div>
            <div class="rb-field"><label>Mobilnummer (2FA)</label><input class="rb-input" @bind="_nuMobil" placeholder="+47 …" /></div>
            <div class="rb-field rb-op" style="max-width:160px">
                <label>Rolle</label>
                <select class="rb-input" @bind="_nuRole">
                    @foreach (var r in SupabaseUserService.Roles) { <option value="@r">@r</option> }
                </select>
            </div>
            <div class="rb-field"><label>Midlertidig passord</label><input class="rb-input" type="password" @bind="_nuPassword" placeholder="••••••" /></div>
            <button class="btn-primary rb-add" @onclick="CreateUser" disabled="@_creating">@(_creating ? "Oppretter…" : "Opprett bruker")</button>
        </div>
        @if (!string.IsNullOrEmpty(_userMsg))
        {
            <p class="page-sub" style="margin-top:10px">@_userMsg</p>
        }
        @if (!Users.IsConfigured)
        {
            <p class="page-sub" style="margin-top:6px; font-size:12px">⚠️ Supabase ikke koblet til — endringer er midlertidige (staging).</p>
        }
    </div>

    <div class="section">
        <h2>Roller og tilgang</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Rettighet</th>
                    @foreach (var r in _roles) { <th>@r</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var perm in _permissions)
                {
                    <tr>
                        <td>@perm.Name</td>
                        @foreach (var allowed in perm.Access)
                        {
                            <td>@if (allowed) { <span class="check">✓</span> } else { <span class="muted">—</span> }</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="section">
        <h2>Tilgang — IP-whitelist</h2>
        <p class="page-sub" style="margin:-4px 0 10px">Begrens hvilke IP-adresser brukere kan logge inn fra (komma-/linjeseparert). Tom = ingen begrensning.</p>
        <div class="rule-builder">
            <div class="rb-field" style="flex:1; min-width:260px"><label>Tillatte IP-er</label><input class="rb-input" @bind="_loginIpList" placeholder="f.eks. 84.208.0.10, 51.120.0.5" /></div>
            <button class="btn-primary rb-add" @onclick="SaveLoginIp">Lagre</button>
        </div>
        @if (!string.IsNullOrEmpty(_loginIpMsg))
        {
            <p class="page-sub" style="margin-top:10px">@_loginIpMsg</p>
        }
    </div>
}
else if (_active == "Dialer")
{
    <div class="section">
        <h2>Dialer <span class="status @(_zKonfigurert ? "on" : "off")">@(_zKonfigurert ? "Konfigurert" : "Mangler credentials")</span></h2>
        <p class="page-sub">Klikk-og-ring fra kundekortet via Zisson. <strong>Click-to-call ringer agentens egen telefon først</strong>, og kobler den så til kunden. Ringehistorikk logges på søknaden.</p>
        <div class="rule-builder">
            <div class="rb-field" style="max-width:120px"><label>Aktiv</label>
                <button class="btn-sm @(_zEnabled ? "" : "btn-danger")" @onclick="ToggleZisson">@(_zEnabled ? "På" : "Av")</button>
            </div>
            <div class="rb-field" style="max-width:150px"><label>Auto-svar agent</label>
                <button class="btn-sm @(_zAutoAnswer ? "" : "btn-danger")" @onclick="ToggleAutoAnswer" title="Softphone: agentens klient svarer automatisk. Fysisk telefon: sett Av så telefonen ringer.">@(_zAutoAnswer ? "På" : "Av")</button>
            </div>
            <div class="rb-field" style="max-width:340px"><label>customerGuid (Zisson-konto)</label>
                <span class="token-row">
                    <input class="inline-input" style="width:250px" placeholder="kundens Zisson-guid"
                           value="@_zCustomerGuid" @onchange="e => _zCustomerGuid = e.Value?.ToString()" />
                    <button class="btn-sm" @onclick="SaveCustomerGuid">Lagre</button>
                </span>
            </div>
            <div class="rb-field" style="max-width:300px"><label>Utgående visningsnummer (callerId)</label>
                <select class="rb-input" @onchange="ChangeCallerId">
                    <option value="">— Zisson-standard —</option>
                    @foreach (var n in _zNumre) { <option value="@n.Nummer" selected="@(n.Nummer == _zCallerId)">@(string.IsNullOrWhiteSpace(n.Navn) ? n.Nummer : $"{n.Navn} ({n.Nummer})")</option> }
                    @if (!string.IsNullOrWhiteSpace(_zCallerId) && !_zNumre.Any(n => n.Nummer == _zCallerId)) { <option value="@_zCallerId" selected>@_zCallerId</option> }
                </select>
            </div>
            <div class="rb-field" style="max-width:230px"><label>Nummerformat (utgående)</label>
                <select class="rb-input" @onchange="ChangeNummerFormat">
                    <option value="e164" selected="@(_zNummerFormat == "e164")">E.164 (+4799…)</option>
                    <option value="0047" selected="@(_zNummerFormat == "0047")">0047 (004799…)</option>
                    <option value="nasjonalt" selected="@(_zNummerFormat == "nasjonalt")">Nasjonalt (8 siffer)</option>
                </select>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_zCustomerMsg)) { <p class="page-sub" style="margin-top:6px">@_zCustomerMsg</p> }
        @if (!_zKonfigurert)
        {
            <p class="page-sub" style="margin-top:6px">Sett customerGuid over og <code>Zisson__RefreshToken</code> i Azure-konfigurasjonen for å aktivere ringing.</p>
        }
        <div style="margin-top:10px">
            <button class="btn-sm" @onclick="HentAgenter" disabled="@_zHenter">@(_zHenter ? "Henter…" : "Hent agenter fra Zisson")</button>
            @if (!string.IsNullOrEmpty(_zHentMsg)) { <span class="page-sub" style="margin-left:10px">@_zHentMsg</span> }
        </div>
        @if (_zAgenter.Count > 0)
        {
            <table class="data-table" style="margin-top:10px">
                <thead><tr><th>Navn</th><th>Bruker-id (til Agent-kobling)</th><th>Brukernavn</th><th>Guid (felles/avtale)</th></tr></thead>
                <tbody>
                    @foreach (var a in _zAgenter)
                    {
                        <tr>
                            <td>@a.Navn</td>
                            <td>@(a.LoginId ?? "—")</td>
                            <td>@(a.Username ?? "—")</td>
                            <td class="mono-cell">@a.Guid</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="section">
        <h2>Agent-kobling</h2>
        <p class="page-sub">Velg hver CRM-brukers <strong>Zisson-bruker</strong> fra lista. Lagres automatisk ved valg.
        @if (_dialerLaster) { <text>Laster fra Zisson…</text> }</p>
        @if (!_dialerLaster && _zAgenter.Count == 0)
        {
            <p class="page-sub">Fant ingen Zisson-brukere å velge fra (agentlista kunne ikke hentes). Bruk «Hent agenter fra Zisson» over, eller sjekk tilkoblingen.</p>
        }
        <table class="data-table">
            <thead><tr><th>CRM-bruker</th><th>E-post</th><th>Zisson-bruker</th><th></th><th></th></tr></thead>
            <tbody>
                @foreach (var u in _userRows.Where(x => x.Active))
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(u.FullName) ? "—" : u.FullName)</td>
                        <td class="mono-cell">@u.Email</td>
                        <td>
                            @if (_zAgenter.Count > 0)
                            {
                                @* value-styrt (ikke selected) så select-en HUSKER valgt bruker etter lagring/relasting.
                                   Kun dropdown = umulig å skrive inn feil verdi. *@
                                <select class="inline-select" style="min-width:240px" value="@ValgtVerdi(u)" @onchange="e => VelgAgent(u, e)">
                                    <option value="">— velg Zisson-bruker —</option>
                                    @foreach (var a in _zAgenter)
                                    {
                                        <option value="@AgentVerdi(a)">@a.Navn@(AgentKode(a) is { } k ? $" ({k})" : "")</option>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(u.ZissonAgentGuid) && !_zAgenter.Any(a => AgentErValgt(u, a)))
                                    {
                                        <option value="@u.ZissonAgentGuid">@u.ZissonAgentGuid (ukjent i lista)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="page-sub">— agentliste ikke hentet —</span>
                            }
                        </td>
