            @if (!_grKonfigurert)
            {
                <p class="page-sub" style="margin:0 0 16px; font-size:12px; color:var(--danger, #b42318)">Mangler konfigurasjon — sett minst BaseUrl + Username + Password i Azure.</p>
            }

            <h3 class="ww-h">Rate-grenser</h3>
            <div class="rule-builder" style="margin-bottom:8px; align-items:flex-end">
                <div class="rb-field rb-op" style="max-width:150px"><label>Maks oppslag per time</label><input class="rb-input" type="number" min="0" @bind="_grMaxTime" /></div>
                <div class="rb-field rb-op" style="max-width:150px"><label>Maks oppslag per døgn</label><input class="rb-input" type="number" min="0" @bind="_grMaxDogn" /></div>
                <button class="btn-primary rb-add" @onclick="SaveGjeldGrenser">Lagre grenser</button>
            </div>
            <p class="page-sub" style="margin:0 0 16px; font-size:12px">0 = ingen grense. @(string.IsNullOrEmpty(_grGrenseMsg) ? "" : _grGrenseMsg)</p>

            <h3 class="ww-h">Konfigurasjon (Azure App Settings)</h3>
            <pre class="code-block">Gjeldsregisteret__TokenUrl      = &lt;OAuth2 token-endepunkt&gt;
Gjeldsregisteret__BaseUrl       = &lt;API-base for oppslaget&gt;
Gjeldsregisteret__ClientId      = &lt;client-id&gt;
Gjeldsregisteret__ClientSecret  = &lt;client-secret&gt;
Gjeldsregisteret__Username      = &lt;partner-brukernavn&gt;
Gjeldsregisteret__Password      = &lt;partner-passord&gt;

# Samtykkebasert innsynstjeneste (OAuth2) — ikke sertifikat/mTLS.</pre>
            <p class="page-sub" style="margin:12px 0 0; font-size:12px">
                🔒 Autentisering er mutual-TLS (sertifikat), ikke passord/token. Miljø og på/av lagres i innstillinger; sertifikat leses kun fra server-config.
                Oppslag skjer <strong>kun</strong> på fnr fra kundekort med gyldig 2FA-samtykke — ellers avvises og logges det.
            </p>
        </div>
    }
    else if (_apiTab == "Eiendomsverdi")
    {
        @IntegrasjonsKort(
