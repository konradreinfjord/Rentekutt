                            @foreach (var v in nf.Options) { <option value="@v">@v</option> }
                        </select>
                    }
                    else
                    {
                        <div class="input-unit">
                            <input class="rb-input" @bind="_newValue" placeholder="@(nf?.Placeholder ?? "Verdi")" />
                            @if (!string.IsNullOrEmpty(nf?.Unit)) { <span class="unit-suffix">@nf.Unit</span> }
                        </div>
                    }
                </div>
            }
            <div class="rb-arrow">→</div>
            <div class="rb-field rb-banks">
                <label>Send til bank(er) — velg én eller flere</label>
                <div class="bank-chips">
                    @foreach (var b in BankNames)
                    {
                        <button type="button" class="bank-chip @(_newBanks.Contains(b) ? "sel" : "")" @onclick="() => ToggleNewBank(b)">@b</button>
                    }
                </div>
            </div>
            @if (_newBanks.Count > 0)
            {
                <div class="rb-field rb-banks">
                    <label>Produkt(er) per bank — valgfritt (tomt = alle produkter)</label>
                    @foreach (var bankNavn in _newBanks)
                    {
                        var bankObj = _banks.FirstOrDefault(x => x.Navn == bankNavn);
                        var bankProd = bankObj is null ? new List<PartnerProdukt>() : ProdukterFor(bankObj.Id).Where(p => p.Aktiv).ToList();
                        if (bankProd.Count > 0)
                        {
                            <div style="margin-bottom:6px; display:flex; align-items:center; gap:8px; flex-wrap:wrap">
                                <span class="page-sub" style="font-size:12px; margin:0; min-width:90px">@bankNavn:</span>
                                <div class="bank-chips">
                                    @foreach (var p in bankProd)
                                    {
                                        <button type="button" class="bank-chip @(ErProduktValgt(bankNavn, p.Id) ? "sel" : "")" @onclick="() => ToggleNyttProdukt(bankNavn, p.Id)">@p.Navn@(p.ErBedrift ? " (bedrift)" : "")</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
        <button class="btn-primary rb-add-row" @onclick="AddRule">Legg til regel</button>
        @if (!string.IsNullOrEmpty(_regelMsg))
        {
            <p class="page-sub" style="margin:12px 0 0; font-size:12.5px; color:@(_regelOk ? "var(--green-dark)" : "var(--danger, #b42318)")">@_regelMsg</p>
        }
        <p class="page-sub" style="margin:14px 0 0; font-size:12px">
            💡 Aktive felt mot søknadsdata: postnummer, poststed, kommune, fylke, lånetype, formål, lånebeløp,
            løpetid, årsinntekt, sivilstatus, ansettelse, boligstatus, nåværende bank. Øvrige felt (PSD2/scoring)
            aktiveres når kildene kobles til.
        </p>
    </div>

    <div class="section">
        <h2>Automatisk sending</h2>
        <p class="page-sub" style="margin:-4px 0 14px">
            Kun banker med ferdig konfigurert sending. Er sending <strong>PÅ</strong> rutes matchende søknader
            automatisk til banken; er den <strong>AV</strong> vises banken som <strong>foreslått bank</strong> i
            person-/bedriftsmarkedet. Hvilke søknader som treffer styres av rutingsreglene over (f.eks. postnummer).
        </p>
        @{ var hardkodet = _banks.Where(b => InstabankService.ErInstabankNavn(b.Navn)).ToList(); }
        <table class="data-table" style="max-width:520px">
            <thead><tr><th>Bank</th><th>Automatisk sending</th></tr></thead>
            <tbody>
                @if (hardkodet.Count == 0)
                {
                    <tr><td colspan="2" class="empty-row">Ingen banker med konfigurert sending ennå — kun Instabank støttes.</td></tr>
                }
                @foreach (var b in hardkodet)
                {
                    <tr>
                        <td><strong>@b.Navn</strong></td>
                        <td>
                            <div class="seg onoff">
                                <button class="@(!b.AutoSend ? "active av" : "")" @onclick="() => SettAutoSend(b, false)">AV</button>
                                <button class="@(b.AutoSend ? "active" : "")" @onclick="() => SettAutoSend(b, true)">PÅ</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_active == "Merknad lån")
{
    <div class="section">
        <h2>Merknadsregler <span class="pill pill-warn">@_merknadsregler.Count(r => r.Aktiv) aktive</span></h2>
        <p class="page-sub" style="margin:-4px 0 14px">
            Gir kundekort en fargebadge i «Merknad»-kolonnen i Person-/Bedriftsmarked når betingelsen matcher.
            Bruk alle kundedata (@Catalog.Fields.Count felter) — f.eks. <strong>alder</strong> (utledet fra
            fødselsnummer) &lt; 34 → «Boliglån UNG», eller <strong>årsinntekt</strong> &gt; 999999 → «Grønt boliglån».
            Alle matchende badges vises.
        </p>
        <table class="data-table">
            <thead>
                <tr><th>#</th><th>Parameter</th><th>Operator</th><th>Verdi</th><th>Merknad (badge)</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @if (_merknadsregler.Count == 0)
                {
                    <tr><td colspan="7" class="empty-row">Ingen merknadsregler ennå — legg til under.</td></tr>
                }
                @foreach (var r in _merknadsregler.OrderBy(r => r.Prioritet))
                {
                    <tr>
                        <td class="mono-cell">@r.Prioritet</td>
                        <td>@LabelFor(r.FeltNokkel)</td>
                        <td class="mono-cell">@r.Operator</td>
                        <td>@r.Verdi</td>
                        <td>@MerknadBadge(r.BadgeTekst, r.BadgeFarge)</td>
                        <td>
                            <label class="toggle">
                                <input type="checkbox" checked="@r.Aktiv" @onchange="e => ToggleMerknad(r, (bool)e.Value!)" />
                                <span class="status @(r.Aktiv ? "on" : "off")">@(r.Aktiv ? "Aktiv" : "Av")</span>
                            </label>
                        </td>
                        <td><button class="btn-sm btn-danger" @onclick="() => RemoveMerknad(r)">Slett</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="section">
        <h2>Ny merknadsregel</h2>
        <div class="rule-builder">
            <div class="rb-field">
                <label>Felt (kundedata)</label>
                <select class="rb-input" value="@_mkFieldKey" @onchange="OnMkFieldChanged">
                    @foreach (var cat in Catalog.Categories)
                    {
                        <optgroup label="@cat">
                            @foreach (var f in Catalog.InCategory(cat)) { <option value="@f.Key">@f.Label</option> }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="rb-field rb-op">
                <label>Operator</label>
                <select class="rb-input" @bind="_mkOp">
                    @foreach (var o in MkOperators) { <option value="@o">@o</option> }
                </select>
            </div>
            @{ var mnf = MkField; }
            @if (_mkOp == "mellom")
            {
                <div class="rb-field rb-op" style="max-width:130px">
                    <label>Fra</label>
                    <div class="input-unit"><input class="rb-input" @bind="_mkFra" placeholder="fra" />@if (!string.IsNullOrEmpty(mnf?.Unit)) { <span class="unit-suffix">@mnf.Unit</span> }</div>
                </div>
                <div class="rb-field rb-op" style="max-width:130px">
                    <label>Til</label>
                    <div class="input-unit"><input class="rb-input" @bind="_mkTil" placeholder="til" />@if (!string.IsNullOrEmpty(mnf?.Unit)) { <span class="unit-suffix">@mnf.Unit</span> }</div>
                </div>
            }
            else
            {
                <div class="rb-field">
                    <label>Verdi</label>
                    @if (mnf?.Type == FieldType.Enum && mnf.Options is not null)
                    {
                        <select class="rb-input" @bind="_mkValue">@foreach (var v in mnf.Options) { <option value="@v">@v</option> }</select>
                    }
                    else
                    {
                        <div class="input-unit"><input class="rb-input" @bind="_mkValue" placeholder="@(mnf?.Placeholder ?? "Verdi")" />@if (!string.IsNullOrEmpty(mnf?.Unit)) { <span class="unit-suffix">@mnf.Unit</span> }</div>
                    }
                </div>
            }
            <div class="rb-arrow">→</div>
            <div class="rb-field">
                <label>Merknad-tekst (badge)</label>
                <input class="rb-input" @bind="_mkBadgeTekst" placeholder="f.eks. Boliglån UNG" />
            </div>
            <div class="rb-field rb-op">
                <label>Farge</label>
                <select class="rb-input" @bind="_mkFarge">
                    @foreach (var f in MerknadEval.Farger) { <option value="@f.Key">@f.Navn</option> }
                </select>
            </div>
            <div class="rb-field" style="align-self:flex-end">
                <label>Forhåndsvisning</label>
                @MerknadBadge(string.IsNullOrWhiteSpace(_mkBadgeTekst) ? "Merknad" : _mkBadgeTekst, _mkFarge)
            </div>
        </div>
        <button class="btn-primary rb-add-row" @onclick="AddMerknad">Legg til merknadsregel</button>
        @if (!string.IsNullOrEmpty(_mkMsg))
        {
            <p class="page-sub" style="margin:12px 0 0; font-size:12.5px; color:@(_mkOk ? "var(--green-dark)" : "var(--danger, #b42318)")">@_mkMsg</p>
        }
    </div>
}
else if (_active == "Beregningsmodell")
{
    <div class="form-card">
        <h2>Beregningsmodell — parametere</h2>
        <p class="page-sub" style="margin:0 0 16px">
            Finansieringsevne-/likviditetsmodell: progressiv lønnsskatt (2024-satser), SIFO-levekostnader
            og stresstestet gjeldsbetjening. Disse forutsetningene driver beregningen på hvert kundekort,
            som bruker alle innkomne søknadsfelt (inntekt, medsøker, husholdning, gjeld, refinansiering, boligverdi).
        </p>
        <div class="form-grid">
            <div class="ff"><label>Nominell rente (%)</label><input type="number" step="0.01" @bind="_berRente" /></div>
            <div class="ff"><label>Løpetid (år)</label><input type="number" @bind="_berLopetid" /></div>
            <div class="ff"><label>Stresstest-påslag (prosentpoeng)</label><input type="number" step="0.1" @bind="_berStress" /></div>
            <div class="ff"><label>SIFO voksen — fallback uten fnr (kr/mnd)</label><input type="number" @bind="_berSifoVoksen" /></div>
            <div class="ff"><label>SIFO individkostnad per barn (kr/mnd)</label><input type="number" @bind="_berSifoBarn" /></div>
        </div>
        <button class="btn-primary" style="margin-top:14px" @onclick="SaveBeregning">Lagre</button>
        @if (!string.IsNullOrEmpty(_berMsg))
        {
            <p class="page-sub" style="margin-top:10px">@_berMsg</p>
        }
    </div>

    <div class="form-card">
        <h2>Slik beregnes hvert kundekort</h2>
        <ol class="flow-steps">
            <li><strong>Netto månedsinntekt</strong> = progressiv skatt (trygdeavgift, minstefradrag, personfradrag, alminnelig 22 % og trinnskatt) beregnet per person på søker + medsøker, ÷ 12</li>
            <li><strong>Levekostnad (SIFO)</strong> = individkostnad per voksen etter <em>alder + kjønn</em> (utledet av fødselsnummer) + barns individkostnad + husholdsfelleskostnad og bilkostnad etter husstandsstørrelse</li>
            <li><strong>Gjeldsbetjening</strong> = annuitet av (eksisterende gjeld − refinansiert beløp + ønsket lån) ved <em>stresstestet</em> rente, over ønsket løpetid</li>
            <li><strong>Likviditet</strong> = netto inntekt − levekostnad − boligkostnad − barnebidrag − gjeldsbetjening</li>
            <li><strong>Belåningsgrad</strong> = (boliggjeld + ønsket lån) ÷ boligverdi</li>
            <li><strong>Maks lån</strong> = beløpet som gir likviditet = 0</li>
        </ol>
    </div>

    <div class="form-card">
        <h2>Feltmapping — hvilke søknadsfelt brukes</h2>
        <table class="breakdown-tbl">
            <thead><tr><th>Modellkomponent</th><th>Kildefelt (kundekort)</th><th>Formel / behandling</th></tr></thead>
            <tbody>
                <tr><td>Netto inntekt</td><td>aarsinntekt_brutto, medsoker_inntekt (ev. ektefelle_inntekt), andre_inntekter</td><td>progressiv skatt per person ÷ 12</td></tr>
                <tr><td>Individkostnad voksne</td><td>foedselsnummer, medsoker_foedselsnummer</td><td>alder + kjønn → SIFO sum 1-5</td></tr>
                <tr><td>Barnekostnad</td><td>antall_barn_under_18</td><td>antall × SIFO-barn (param)</td></tr>
                <tr><td>Husholdsfelleskostnad</td><td>utledet husstandsstørrelse (voksne + barn)</td><td>SIFO-tabell per antall personer</td></tr>
                <tr><td>Bilkostnad</td><td>antall_biler</td><td>antall × SIFO bildrift per husstand</td></tr>
                <tr><td>Faste bokostnader</td><td>boligkostnad_mnd, barnebidrag_betalt_mnd</td><td>trekkes direkte</td></tr>
                <tr><td>Gjeld</td><td>boliggjeld, studielaan, billaan, forbruksgjeld, refinansieres_belop, onsket_laanebelop</td><td>eksisterende − refi + ønsket</td></tr>
                <tr><td>Gjeldsbetjening</td><td>onsket_lopetid_mnd</td><td>annuitet ved rente + stresstest</td></tr>
                <tr><td>Belåningsgrad</td><td>boliggjeld, onsket_laanebelop, boligverdi</td><td>(boliggjeld + ønsket) ÷ boligverdi</td></tr>
            </tbody>
        </table>
        <p class="page-sub" style="margin-top:10px">Åpne et kundekort og trykk «Vis full breakdown» for å se den linje-for-linje med faktiske tall.</p>
    </div>

    <div class="form-card">
        <h2>SIFO-referansetabeller <span class="page-sub" style="font-weight:400">(fra Beregningsmodell.xlsx)</span></h2>
        <h3 style="margin:14px 0 6px">Individkostnad pr. mnd — sum 1-5 (mat, klær, helse, fritid, reise)</h3>
        <table class="breakdown-tbl">
            <thead>
                <tr><th>Alder fra</th>
                    @foreach (var a in BeregningService.SifoAldersTerskel) { <th class="num">@a år</th> }
                </tr>
            </thead>
            <tbody>
                <tr><td>Kvinne</td>@foreach (var v in BeregningService.SifoIndivKvinne) { <td class="num">@($"{v:N0}")</td> }</tr>
                <tr><td>Mann</td>@foreach (var v in BeregningService.SifoIndivMann) { <td class="num">@($"{v:N0}")</td> }</tr>
            </tbody>
        </table>

        <h3 style="margin:18px 0 6px">Husholds- og bilkostnad pr. mnd — etter antall personer</h3>
        <table class="breakdown-tbl">
            <thead>
                <tr><th>Antall personer</th>@for (var i = 1; i <= 7; i++) { <th class="num">@i</th> }</tr>
            </thead>
            <tbody>
                <tr><td>Husholdsfelleskostnad</td>@foreach (var v in BeregningService.SifoHushold) { <td class="num">@($"{v:N0}")</td> }</tr>
                <tr><td>Bilkostnad (per bil)</td>@foreach (var v in BeregningService.SifoBil) { <td class="num">@($"{v:N0}")</td> }</tr>
            </tbody>
        </table>

        <h3 style="margin:18px 0 6px">Progressiv inntektsskatt (2024)</h3>
        <ul class="page-sub" style="margin:0; padding-left:18px; line-height:1.7">
            <li>Trygdeavgift 7,8 % av brutto</li>
            <li>Minstefradrag 46 % (maks 109 950) + personfradrag 88 250</li>
            <li>Alminnelig inntektsskatt 22 % av grunnlag</li>
            <li>Trinnskatt: 1,7 % (208 050) · 4,0 % (292 850) · 13,6 % (670 000) · 16,6 % (937 900) · 17,6 % (1 350 000+)</li>
        </ul>
    </div>
}
else if (_active == "GDPR")
{
    <div class="form-card">
        <h2>Personvern & oppbevaring</h2>
        <p class="page-sub" style="margin:0 0 16px">
            For å etterleve GDPR (dataminimering og lagringsbegrensning) behandles søknadsdata i to trinn,
            regnet fra da søknaden ble opprettet. Først <strong>anonymisering</strong> — identifiserende data
            (navn, fødselsnummer, kontaktinfo, notater) fjernes, mens anonym statistikk (lånetype, beløp, status, dato)
            beholdes. Deretter <strong>sletting</strong> — hele kundekortet fjernes permanent.
            Jobben kjører <strong>automatisk hvert døgn</strong>.
        </p>

        <table class="data-table">
            <thead><tr><th>Trinn</th><th>Hva skjer</th><th>Beholdes</th><th>Etter</th></tr></thead>
            <tbody>
                <tr>
                    <td><span class="type-tag lead">Anonymisering</span></td>
                    <td>Fjerner navn, fødselsnummer, mobil, e-post, adresse, kontonummer, medsøker-data og notater (også i notat-/endringslogg)</td>
                    <td>Anonym statistikk: lånetype, beløp, status, kilde, kommune/fylke, datoer</td>
                    <td><input class="inline-input" type="number" min="1" max="120" @bind="_gdprAnonMonths" /> mnd</td>
                </tr>
                <tr>
                    <td><span class="type-tag">Sletting</span></td>
                    <td>Sletter hele kundekortet permanent (inkl. banksending, notat og logg)</td>
                    <td class="muted">Ingenting</td>
                    <td><input class="inline-input" type="number" min="1" max="240" @bind="_gdprDeleteMonths" /> mnd</td>
                </tr>
            </tbody>
        </table>
        <div style="display:flex; gap:10px; align-items:center; margin-top:14px; flex-wrap:wrap">
            <button class="btn-primary" @onclick="SaveGdpr">Lagre</button>
            <button class="btn-sm" @onclick="ForhaandsvisGdpr" disabled="@_gdprKjorer">@(_gdprKjorer ? "…" : "Forhåndsvis (tørrkjør)")</button>
            @if (!_gdprBekreft)
            {
                <button class="btn-sm btn-danger" @onclick="() => _gdprBekreft = true" disabled="@_gdprKjorer">Kjør GDPR-jobb nå</button>
            }
            else
            {
                <span class="confirm-text">Irreversibelt — sikker?</span>
                <button class="btn-danger-solid btn-sm" @onclick="KjorGdprNaa" disabled="@_gdprKjorer">@(_gdprKjorer ? "Kjører…" : "Ja, kjør")</button>
                <button class="btn-sm" @onclick="() => _gdprBekreft = false">Avbryt</button>
            }
        </div>
        @if (!Gdpr.IsConfigured)
        {
            <p class="page-sub" style="margin:8px 0 0; color:var(--danger, #b42318)">⚠ ConnectionStrings__Postgres må være satt i Azure for at jobben skal kunne kjøre.</p>
        }
        @if (!string.IsNullOrEmpty(_gdprMsg))
        {
            <p class="page-sub" style="margin-top:10px">@_gdprMsg</p>
        }
    </div>

    <div class="form-card">
        <h2>Slik ser en anonymisert søknad ut</h2>
        <p class="page-sub" style="margin:0">
            Etter @_gdprAnonMonths måneder beholdes f.eks. kun anonym statistikk:
            «En <strong>forbrukslånsøknad på 450 000 kr</strong>, status <strong>Fullført</strong>, opprettet
            <strong>12.03.2026</strong> fra <strong>Prismatch</strong> i <strong>Bergen</strong>» —
            <strong>uten</strong> navn, fødselsnummer eller kontaktinfo.
        </p>
    </div>

    <div class="form-card">
        <h2>Feltnivåkryptering av fødselsnummer</h2>
        <p class="page-sub" style="margin:0 0 12px">
            Fødselsnummer, medsøkers fødselsnummer og kunde-id krypteres i ro (AES-256-GCM) når
            nøkkelen <strong>Gdpr__FieldKey</strong> er satt i Azure. Et søkbart HMAC-felt gjør at
            innsyn/sletting fortsatt kan finne personen uten å lagre fnr i klartekst.
        </p>
        @if (Kunder.KrypteringPaa)
        {
            <div class="samtykke-status ok" style="margin-bottom:12px">✓ Kryptering er PÅ. Nye og endrede kundekort krypteres automatisk.</div>
            <p class="page-sub" style="margin:0 0 10px">
                Eksisterende rader som fortsatt ligger i klartekst må bakfylles én gang:
            </p>
            <button class="btn-primary" @onclick="KrypterBackfill" disabled="@_krypterKjorer">
                @(_krypterKjorer ? "Krypterer…" : "Krypter eksisterende data")
            </button>
        }
        else
        {
            <div class="samtykke-status mangler">⚠ Kryptering er AV — Gdpr__FieldKey er ikke satt. Fødselsnummer lagres i klartekst.</div>
            <p class="page-sub" style="margin:10px 0 0">
                Sett en 32-byte nøkkel (base64) eller en passfrase i app-innstillingen <strong>Gdpr__FieldKey</strong> og start appen på nytt.
            </p>
        }
        @if (!string.IsNullOrEmpty(_krypterMsg))
        {
            <p class="page-sub" style="margin-top:10px">@_krypterMsg</p>
        }

        <div style="margin-top:16px; border-top:1px solid var(--border); padding-top:14px">
            <h3 style="margin:0 0 8px; font-size:14px">Opprydding — mobilnummer feilaktig lagret som fødselsnummer</h3>
            <p class="page-sub" style="margin:0 0 10px">
                Tidligere ble mobilnummeret speilet inn i fødselsnummer-feltet på enkelte leads (bl.a. prismatch).
                Denne engangsjobben blanker fnr-feltet <strong>kun</strong> der verdien ikke er et gyldig fødselsnummer
                og er identisk med mobilnummeret. Gyldige fødselsnumre røres aldri.
            </p>
            <button class="btn-primary" @onclick="RyddMobilIFnr" disabled="@_ryddKjorer">
                @(_ryddKjorer ? "Rydder…" : "Rydd mobil-i-fnr")
            </button>
            @if (!string.IsNullOrEmpty(_ryddMsg))
            {
                <p class="page-sub" style="margin-top:10px">@_ryddMsg</p>
            }
        </div>

        <div style="margin-top:16px; border-top:1px solid var(--border); padding-top:14px">
            <h3 style="margin:0 0 8px; font-size:14px">Diagnose — lest fra kjørende prosess / live database</h3>
            @{ var (fieldKeyLastet, selvtestOk) = KrypteringStatus(); }
            <ul class="page-sub" style="margin:0; padding-left:18px; line-height:1.9">
                <li>Gdpr__FieldKey lastet i kjørende prosess:
                    <strong>@(fieldKeyLastet ? "Ja" : "Nei")</strong></li>
                <li>Selvtest kryptering (krypter→dekrypter i kjørende prosess):
                    <strong>@(fieldKeyLastet ? (selvtestOk ? "OK" : "Feilet") : "— (kryptering AV)")</strong></li>
                <li>Miljøvariabel-navn i prosessen som matcher «FieldKey»/«Gdpr» (kun navn, aldri verdi):
                    <strong>@EnvNoekkelFunn()</strong></li>
                <li>HMAC-nøkkel: <strong>avledet fra Gdpr__FieldKey (domenetagg «hmac-v1»)</strong></li>
                @if (_diagKjort)
                {
                    <li>Rader med fødselsnummer uten <code>enc:1:</code>-format:
                        <strong style="@(_diagUkryptert > 0 ? "color:var(--danger,#b42318)" : "")">@_diagUkryptert</strong></li>
                    <li>Rader med fødselsnummer satt men <code>fnr_hmac</code> = null:
                        <strong style="@(_diagManglerHmac > 0 ? "color:var(--danger,#b42318)" : "")">@_diagManglerHmac</strong></li>
                }
                @if (_dekTestKjort)
                {
                    <li><strong>Dekrypteringstest av eksisterende data (nåværende nøkkel):</strong>
                        @_dekMedFnr med fnr · <strong style="color:var(--green,#2f7d4f)">@_dekOk dekryptert OK</strong> ·
                        <strong style="@(_dekFeil > 0 ? "color:var(--danger,#b42318)" : "")">@_dekFeil kunne IKKE dekrypteres</strong>
                        @if (_dekFeil > 0)
                        {
                            <span style="color:var(--danger,#b42318)"> ← nøkkelen er en ANNEN enn dataene ble kryptert med</span>
                        }
                    </li>
                }
            </ul>
            <button class="btn-sm" style="margin-top:10px" @onclick="KjorKryptDiagnose" disabled="@_diagKjorer">
                @(_diagKjorer ? "Teller…" : "Kjør databasetelling (live)")
            </button>
            @if (!string.IsNullOrEmpty(_diagFeil))
            {
                <p class="page-sub" style="margin-top:8px; color:var(--danger,#b42318)">@_diagFeil</p>
            }
            <p class="page-sub" style="margin:8px 0 0; font-size:11.5px">Status leses direkte fra kjørende konfigurasjon og databasen — ikke fra en lagret innstilling. Nøkkelverdier vises aldri.</p>
        </div>
    </div>

    <div class="form-card">
        <h2>Innsyn &amp; sletting per person</h2>
        <p class="page-sub" style="margin:0 0 12px">
            Registrertes rettigheter (GDPR art. 15 og 17): søk opp en person på fødselsnummer, mobilnummer
            eller e-post for å <strong>eksportere</strong> alt vi har lagret (innsyn), eller <strong>slette</strong> alt permanent.
        </p>
        <div class="rule-builder" style="margin-bottom:12px">
            <div class="rb-field" style="flex:1; min-width:240px">
                <label>Fødselsnummer / mobil / e-post</label>
                <input class="rb-input" @bind="_dsrSok" @bind:event="oninput" placeholder="f.eks. 12079330599 eller 93904919" />
            </div>
            <button class="btn-primary rb-add" @onclick="SokPerson" disabled="@_dsrKjorer">@(_dsrKjorer ? "…" : "Søk")</button>
        </div>

        @if (!Gdpr.IsConfigured)
        {
            <p class="page-sub" style="margin:0; color:var(--danger, #b42318)">⚠ ConnectionStrings__Postgres må være satt for at innsyn/sletting skal virke.</p>
        }
        @if (_dsrSokt && _dsrTreff.Count == 0)
        {
            <p class="page-sub" style="margin:0">Ingen kundekort funnet for søket.</p>
        }
        @if (_dsrTreff.Count > 0)
        {
            <table class="tbl">
                <thead><tr><th>Navn</th><th>Fnr</th><th>Mobil</th><th>Status</th><th>Opprettet</th></tr></thead>
                <tbody>
                    @foreach (var t in _dsrTreff)
                    {
                        <tr>
                            <td>@(t.Anonymisert ? "(anonymisert)" : (t.Navn ?? "—"))</td>
                            <td>@(t.Fnr ?? "—")</td>
                            <td>@(t.Mobil ?? "—")</td>
                            <td>@(t.Status ?? "—")</td>
                            <td>@t.OpprettetAt.TilOslo().ToString("dd.MM.yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="rule-builder" style="margin-top:12px">
                <button class="btn-sm" @onclick="EksporterPerson" disabled="@_dsrKjorer">Last ned innsyn (JSON)</button>
                @if (!_dsrSlettBekreft)
                {
                    <button class="btn-sm btn-danger" @onclick="() => _dsrSlettBekreft = true" disabled="@_dsrKjorer">Slett all data om personen</button>
                }
                else
                {
                    <span class="page-sub" style="margin:0 8px 0 0; color:var(--danger, #b42318)">Slette @_dsrTreff.Count kundekort permanent?</span>
                    <button class="btn-danger-solid btn-sm" @onclick="SlettPerson" disabled="@_dsrKjorer">@(_dsrKjorer ? "Sletter…" : "Ja, slett alt")</button>
                    <button class="btn-sm" @onclick="() => _dsrSlettBekreft = false">Avbryt</button>
                }
            </div>
        }
        @if (!string.IsNullOrEmpty(_dsrMsg))
        {
            <p class="page-sub" style="margin-top:10px">@_dsrMsg</p>
        }
    </div>

    <div class="form-card">
        <h2>Sikkerhetskopier og sletting fra backup</h2>
        <p class="page-sub" style="margin:0">
            Databasen sikkerhetskopieres av Supabase (plattformadministrert). Når data slettes
            eller anonymiseres i portalen, forsvinner det fra de aktive dataene umiddelbart, og fra
            sikkerhetskopiene når disse rulleres ut etter Supabases oppbevaringstid (styres i
            Supabase-prosjektets backup-innstillinger, ikke i denne koden). Ved en gjenoppretting
            fra backup må sletting/anonymisering kjøres på nytt for data som lå i den gjenopprettede
            perioden.
        </p>
    </div>

    <div class="form-card">
        <h2>Innlogging — brute-force-sperre</h2>
        <p class="page-sub" style="margin:0 0 12px">Maks antall feilede innloggingsforsøk per bruker før kontoen midlertidig sperres.</p>
        <div class="rule-builder">
            <div class="rb-field rb-op" style="max-width:150px"><label>Maks feil per time</label><input class="rb-input" type="number" min="1" @bind="_loginMaxFailHour" /></div>
            <div class="rb-field rb-op" style="max-width:150px"><label>Maks feil per 24t</label><input class="rb-input" type="number" min="1" @bind="_loginMaxFail24h" /></div>
            <button class="btn-primary rb-add" @onclick="SaveLoginLimits">Lagre</button>
        </div>
        @if (!string.IsNullOrEmpty(_loginLimitMsg))
        {
            <p class="page-sub" style="margin-top:10px">@_loginLimitMsg</p>
        }
    </div>

    <div class="form-card">
        <h2>Tofaktor-autentisering (2FA)</h2>
        <p class="page-sub" style="margin:0 0 12px">
            Når påkrevd må alle ansatte bekrefte innlogging med SMS-kode. Brukere uten mobilnummer
            får et selvbetjent oppsett ved neste innlogging (ingen blir utestengt). Krever at
            LinkMobility (SMS) er konfigurert.
        </p>
        <label class="toggle-row" style="display:flex; align-items:center; gap:10px">
            <input type="checkbox" @bind="_require2fa" />
            <span>Krev 2FA for alle ansattkontoer</span>
        </label>
        <button class="btn-primary" style="margin-top:12px" @onclick="SaveRequire2fa">Lagre</button>
        @if (!string.IsNullOrEmpty(_require2faMsg))
        {
            <p class="page-sub" style="margin-top:10px">@_require2faMsg</p>
        }
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        // Kun administratorer har tilgang til admin-panelet (brukeradmin, tokens, integrasjoner).
        if (!Session.IsAdmin) { Nav.NavigateTo("/crm"); return; }
        // Hent uavhengige kilder i parallell.
        var usersTask = Users.ListUsersAsync();
        var banksTask = Partners.ListAsync();
        var produktTask = Produkter.ListAsync();
        var webhookTask = Webhooks.GetInboundAsync();
        var webhookPrismatchTask = Webhooks.GetByNameAsync(WebhookService.PrismatchName);
        var webhookVippsTask = Webhooks.GetByNameAsync(WebhookService.VippsName);
        var webhookBankIdTask = Webhooks.GetByNameAsync(WebhookService.BankIdName);
        var eventsTask = Events.ListAsync(100);
        await Task.WhenAll(usersTask, banksTask, produktTask, webhookTask, webhookPrismatchTask, webhookVippsTask, webhookBankIdTask, eventsTask);
        _userRows = usersTask.Result;
        _loadingUsers = false;   // brukerlista er hentet – vis tabellen (ellers står den på «Laster …»)
        _banks = banksTask.Result;
        _produkter = produktTask.Result;

        // Selvhelbredende: garanter at alle Instabank-partnere har standardproduktene
        // (uavhengig av om seed-migrasjonen rakk partneren). Idempotent — legger kun til det som mangler.
        var lagtTil = 0;
        foreach (var ib in _banks.Where(b => InstabankService.ErInstabankNavn(b.Navn)))
            lagtTil += await Produkter.EnsureInstabankStandardAsync(ib.Id, _produkter);
        if (lagtTil > 0) _produkter = await Produkter.ListAsync();
        _webhook = webhookTask.Result;
        _webhookPrismatch = webhookPrismatchTask.Result;
        _webhookVipps = webhookVippsTask.Result;
        _webhookBankId = webhookBankIdTask.Result;
        _inboundWebhooks = new[] { _webhook, _webhookPrismatch, _webhookVipps, _webhookBankId }.Where(w => w is not null).Select(w => w!).ToList();
        _events = eventsTask.Result;
        await SjekkTilkoblingerAsync();   // live-test API + direkte Postgres, alarm ved manglende kontakt
        // Innstillingene deler én cachet bulk-henting (første kall laster alt).
        _smsMaxHour = await Settings.GetIntAsync(TwoFactorService.KeyMaxPerHour, TwoFactorService.DefaultMaxPerHour);
        _smsMax24h = await Settings.GetIntAsync(TwoFactorService.KeyMaxPer24h, TwoFactorService.DefaultMaxPer24h);
        _gdprAnonMonths = await Settings.GetIntAsync("gdpr_anonymize_months", 12);
        _gdprDeleteMonths = await Settings.GetIntAsync("gdpr_delete_months", 24);
        _timeoutDager = await Settings.GetIntAsync(KundekortService.KeySendtBankTimeoutDager, 0);
        _loginIpList = await Settings.GetAsync("login_ip_allowlist") ?? "";
        _loginMaxFailHour = await Settings.GetIntAsync(SupabaseUserService.KeyMaxFailHour, SupabaseUserService.DefaultMaxFailHour);
        _loginMaxFail24h = await Settings.GetIntAsync(SupabaseUserService.KeyMaxFail24h, SupabaseUserService.DefaultMaxFail24h);
        _require2fa = await Settings.GetBoolAsync(TwoFactorService.KeyRequireAll, true);
        _smsMaler = await SmsMaler.ListAsync();
        _autoEnabled = (await Settings.GetAsync(SmsMalService.KeyAutoEnabled)) == "true";
        _autoMal = await Settings.GetAsync(SmsMalService.KeyAutoMal) ?? "";
        _tpToken = await Settings.GetAsync(TredjepartController.KeyToken) ?? "";
        _tpEnabled = (await Settings.GetAsync(TredjepartController.KeyEnabled)) == "true";
        _ibEnabled = await Instabank.AktivertAsync();
        _ibMiljo = await Instabank.MiljoAsync();
        _ibKonfigurert = await Instabank.ErKonfigurertAsync();
        _grEnabled = await Gjeld.AktivertAsync();
        _grMiljo = await Gjeld.MiljoAsync();
        _grKonfigurert = Gjeld.ErKonfigurert;
        _grBaseUrl = Gjeld.BaseUrl ?? "";
        _grMaxTime = await Gjeld.MaxPerTimeAsync();
        _grMaxDogn = await Gjeld.MaxPerDognAsync();
        _sisteSendinger = await BankSending.SisteAsync(25);
        _rules = await Ruting.ListAsync();
        _merknadsregler = await Merknad.ListAsync();
        var bp = await Beregning.HentParametreAsync();
        _berRente = bp.Rente; _berLopetid = bp.LopetidAar;
        _berStress = bp.Stresstest; _berSifoVoksen = bp.SifoVoksen; _berSifoBarn = bp.SifoBarn;
    }

    // ---- Beregningsmodell ----
    private decimal _berRente, _berStress, _berSifoVoksen, _berSifoBarn;
    private int _berLopetid;
    private string? _berMsg;
    private async Task SaveBeregning()
    {
        await Beregning.LagreParametreAsync(new BeregningParametre(_berRente, _berLopetid, _berStress, _berSifoVoksen, _berSifoBarn));
        _berMsg = "Lagret.";
    }

    private string _loginIpList = "";
    private string? _loginIpMsg;
    private async Task SaveLoginIp()
    {
        await Settings.SetAsync("login_ip_allowlist", _loginIpList);
        _loginIpMsg = "IP-whitelist lagret.";
    }

    private int _smsMaxHour = TwoFactorService.DefaultMaxPerHour;
    private int _smsMax24h = TwoFactorService.DefaultMaxPer24h;
    private string? _smsMsg;
    private async Task SaveSmsLimits()
    {
        if (_smsMaxHour < 1) _smsMaxHour = 1;
        if (_smsMax24h < 1) _smsMax24h = 1;
        await Settings.SetAsync(TwoFactorService.KeyMaxPerHour, _smsMaxHour.ToString());
        await Settings.SetAsync(TwoFactorService.KeyMaxPer24h, _smsMax24h.ToString());
        _smsMsg = "Rategrense lagret.";
    }

    // ---- SMS-maler + automatikk ----
    private List<SmsMal> _smsMaler = new();
    private string _nyMalNavn = "", _nyMalTekst = "";
    private string? _malMsg;
    private bool _autoEnabled;
    private string _autoMal = "";
    private string? _autoMsg;

    private async Task LeggTilMal()
    {
        var (ok, error) = await SmsMaler.AddAsync(_nyMalNavn, _nyMalTekst);
        _malMsg = ok ? "Mal lagt til." : error;
        if (ok) { _nyMalNavn = ""; _nyMalTekst = ""; _smsMaler = await SmsMaler.ListAsync(); }
    }

    private async Task SlettMal(Guid id)
    {
        await SmsMaler.DeleteAsync(id);
        _smsMaler = await SmsMaler.ListAsync();
    }

    private async Task LagreAutomatikk()
    {
        await Settings.SetAsync(SmsMalService.KeyAutoEnabled, _autoEnabled ? "true" : "false");
        await Settings.SetAsync(SmsMalService.KeyAutoMal, _autoMal);
        _autoMsg = "Automatikk lagret.";
    }

    // ---- Tilkoblingsstatus (live-test av API + direkte Postgres) ----
    private bool _apiOk;
    private string? _apiDetalj;
    private bool _dbOk;
    private string? _dbDetalj;

    // Live-tester begge databasetilkoblingene og reiser en kritisk alarm ved manglende kontakt,
    // så feil (f.eks. utdatert DB-passord) blir synlig i alarmlista, ikke bare her.
    private async Task SjekkTilkoblingerAsync()
    {
        var (apiOk, apiDetalj) = await Kunder.TestApiAsync();
        _apiOk = apiOk; _apiDetalj = apiDetalj;
        var (dbOk, dbDetalj) = await Migrator.TestTilkoblingAsync();
        _dbOk = dbOk; _dbDetalj = dbDetalj;

        // Alarmene reises KUN fra prod. Lokal/dev når ikke direkte-Postgres (passordet ligger bare i
        // Azure), så uten denne guarden ville hver lokale Admin-åpning skrevet falske «Postgres nede»-
        // alarmer til den delte prod-lista. Status vises fortsatt lokalt (_apiOk/_dbOk) – bare ikke reist.
        if (!Env.IsProduction()) return;

        var naa = DateTime.UtcNow.TilOslo().ToString("dd.MM.yyyy HH:mm:ss");
        if (!apiOk)
            await Alarm.RaiseAsync("API", "Ingen kontakt med Supabase API (PostgREST)",
                $"Tidspunkt: {naa}. {apiDetalj}", AlarmService.Alvorlighet.Kritisk, "API", "db-api-nede");
        else
            await Alarm.LosOppNoekkelAsync("db-api-nede", "System (kontakt gjenopprettet)");

        if (!dbOk)
            await Alarm.RaiseAsync("Database", "Ingen kontakt med direkte database (Postgres)",
                $"Tidspunkt: {naa}. {dbDetalj} — migrasjoner og GDPR-jobber stopper til tilkoblingen (passord i ConnectionStrings:Postgres) er riktig.",
                AlarmService.Alvorlighet.Kritisk, "Database", "db-direkte-nede");
        else
            await Alarm.LosOppNoekkelAsync("db-direkte-nede", "System (kontakt gjenopprettet)");
    }

    // ---- Inbound webhooks + status + hendelser ----
    private Webhook? _webhook;
    private Webhook? _webhookPrismatch;
    private Webhook? _webhookVipps;
    private Webhook? _webhookBankId;
    private List<Webhook> _inboundWebhooks = new();
    private List<Hendelse> _events = new();
    private string WebhookUrl => $"{Nav.BaseUri}api/webhook/soknad";
    private string WebhookUrlVipps => $"{Nav.BaseUri}api/webhook/vipps";
    private string WebhookUrlBankId => $"{Nav.BaseUri}api/webhook/bankid";

    private bool _visPayloads;
    private bool _payloadsLaster;
    private List<WebhookPayload> _sistePayloads = new();
    private async Task VisPayloads()
    {
        _payloadsLaster = true;
        _sistePayloads = await Payloads.SisteAsync(50);
        _visPayloads = true;
        _payloadsLaster = false;
    }

    // Re-kjør en lagret payload → opprett lead på nytt (for feilede mottak).
    private Guid? _rekjorId;
    private Guid? _rekjorMsgId;
    private string? _rekjorMsg;
    private bool _rekjorOk;
    private async Task ReKjorPayload(WebhookPayload p)
    {
        _rekjorId = p.Id; _rekjorMsg = null;
        var r = await LeadMottak.ReprosseserAsync(p.Id, Session.UserName ?? Session.Email);
        _rekjorOk = r.Ok;
        _rekjorMsgId = p.Id;
        _rekjorMsg = r.Ok ? $"Opprettet {r.Opprettet} lead ✓" : ("Feilet: " + r.Feil);
        _rekjorId = null;
