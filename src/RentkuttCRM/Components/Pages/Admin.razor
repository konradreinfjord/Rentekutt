    // Produktvalg per bank i regelbyggeren: banknavn → valgte produkt-Id-er.
    private readonly Dictionary<string, HashSet<string>> _newProdukter = new();

    private bool ErProduktValgt(string bankNavn, Guid produktId) =>
        _newProdukter.TryGetValue(bankNavn, out var set) && set.Contains(produktId.ToString());

    private void ToggleNyttProdukt(string bankNavn, Guid produktId)
    {
        if (!_newProdukter.TryGetValue(bankNavn, out var set)) { set = new(); _newProdukter[bankNavn] = set; }
        if (!set.Remove(produktId.ToString())) set.Add(produktId.ToString());
    }

    // Produktnavn valgt for en bank i en lagret regel (for visning i regel-tabellen).
    private List<string> RegelProduktNavn(Rutingsregel r, string bankNavn)
    {
        if (!r.ProdukterMap.TryGetValue(bankNavn, out var ids) || ids.Count == 0) return new();
        return ids
            .Select(id => _produkter.FirstOrDefault(p => p.Id.ToString() == id)?.Navn)
            .Where(n => !string.IsNullOrWhiteSpace(n)).Select(n => n!)
            .ToList();
    }

    private void ToggleNewBank(string bank)
    {
        if (!_newBanks.Remove(bank)) _newBanks.Add(bank);
        else _newProdukter.Remove(bank);   // fjernet bank ⇒ dropp dens produktvalg
    }

    private async Task AddRule()
    {
        _regelMsg = null;
        // «mellom» ⇒ bygg verdien fra Fra/Til.
        var verdi = _newOp == "mellom" ? $"{_newFra.Trim()}-{_newTil.Trim()}" : _newValue?.Trim() ?? "";

        if (_newBanks.Count == 0) { _regelMsg = "Velg minst én bank."; _regelOk = false; return; }
        if (_newOp == "mellom" ? (string.IsNullOrWhiteSpace(_newFra) || string.IsNullOrWhiteSpace(_newTil)) : string.IsNullOrWhiteSpace(verdi))
        { _regelMsg = "Fyll inn verdi (Fra/Til for intervall)."; _regelOk = false; return; }

        // Serialiser produktvalg (kun for valgte banker med minst ett produkt).
        var produkterMap = _newProdukter
            .Where(kv => _newBanks.Contains(kv.Key) && kv.Value.Count > 0)
            .ToDictionary(kv => kv.Key, kv => kv.Value.ToList());
        string? produkterJson = produkterMap.Count > 0 ? Newtonsoft.Json.JsonConvert.SerializeObject(produkterMap) : null;

        var prioritet = _rules.Count == 0 ? 1 : _rules.Max(r => r.Prioritet) + 1;
        var (lagret, feil) = await Ruting.AddAsync(prioritet, _newFieldKey, _newOp, verdi, _newBanks.OrderBy(b => b), produkterJson);
        if (lagret is not null)
        {
            _rules = await Ruting.ListAsync();   // hent frisk liste fra DB (bekrefter lagring)
            _regelMsg = $"Regel lagret: {LabelFor(_newFieldKey)} {_newOp} {verdi} → {string.Join(", ", _newBanks.OrderBy(b => b))}";
            _regelOk = true;
            _newFra = _newTil = "";
            _newProdukter.Clear();
        }
        else { _regelMsg = "Kunne ikke lagre regelen: " + (feil ?? "ukjent databasefeil"); _regelOk = false; }
    }

