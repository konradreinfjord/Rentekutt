                        <button class="@(_grMiljo == "prod" ? "active" : "")" @onclick='() => SettGjeldMiljo("prod")'>Produksjon</button>
                    </div>
                </div>
                <button class="btn-primary rb-add" @onclick="TestGjeld" disabled="@_grTester">@(_grTester ? "Tester…" : "Test tilkobling")</button>
            </div>
            @if (!string.IsNullOrEmpty(_grTestResultat))
            {
                <pre class="code-block" style="margin:0 0 16px; white-space:pre-wrap; max-height:260px; overflow:auto; border-left:3px solid @(_grTestOk ? "var(--green,#16a34a)" : "var(--danger,#b42318)")">@_grTestResultat</pre>
