                <span class="status on">Sendt</span> = levert til bank (se tidspunkt/referanse),
                <span class="status err">Feilet</span> = se årsak.
            </p>
            @{ var koAntall = _sisteSendinger.Count(s => s.Status == SendStatus.IKo);
               var feiletAntall = _sisteSendinger.Count(s => s.Status == SendStatus.Feilet); }
            <div class="db-stats" style="margin:0 0 12px">
                <div class="db-box"><span class="db-box-num">@_sisteSendinger.Count(s => s.Status == SendStatus.Sendt)</span><span class="db-box-lbl">Sendt ✓</span></div>
                <div class="db-box accent-amber"><span class="db-box-num">@koAntall</span><span class="db-box-lbl">I kø</span></div>
                <div class="db-box"><span class="db-box-num">@feiletAntall</span><span class="db-box-lbl">Feilet</span></div>
            </div>
            <table class="data-table">
                <thead><tr><th>Tidspunkt</th><th>Kunde</th><th>Bank</th><th>Produkt</th><th>Status</th><th>Årsak / detalj</th><th>Referanse</th><th>Sendt av</th></tr></thead>
                <tbody>
                    @if (_sisteSendinger.Count == 0)
                    {
                        <tr><td colspan="8" class="empty-row">Ingen søknader sendt til bank ennå.</td></tr>
                    }
                    @foreach (var s in _sisteSendinger)
                    {
                        var feilet = s.Status == SendStatus.Feilet;
                        <tr>
                            <td class="mono-cell">@s.SendtAt.TilOslo().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(s.KundeNavn) ? "—" : s.KundeNavn)</td>
                            <td>@s.Bank</td>
                            <td>@(string.IsNullOrWhiteSpace(s.Produkt) ? "—" : s.Produkt)</td>
                            <td><span class="status @(feilet ? "err" : s.Status == SendStatus.IKo ? "pending" : "on")">@s.Status</span></td>
                            <td style="@(feilet ? "color:var(--danger, #b42318); font-weight:600" : "")">@(string.IsNullOrWhiteSpace(s.Detalj) ? "—" : s.Detalj)</td>
                            <td class="mono-cell">@(string.IsNullOrWhiteSpace(s.EksternRef) ? "—" : s.EksternRef)</td>
                            <td>@(string.IsNullOrWhiteSpace(s.SendtAv) ? "—" : s.SendtAv)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_apiTab == "LinkMobility")
