            <div class="rule-builder">
                <div class="rb-field" style="max-width:280px">
                    <label>Mal som sendes</label>
                    <select class="rb-input" @bind="_autoMal">
                        <option value="">— velg mal —</option>
                        @foreach (var m in _smsMaler) { <option value="@m.Navn">@m.Navn</option> }
                    </select>
                </div>
                <button class="btn-primary rb-add" @onclick="LagreAutomatikk">Lagre</button>
            </div>
            @if (!string.IsNullOrEmpty(_autoMsg)) { <p class="page-sub" style="margin:8px 0 0; font-size:12px">@_autoMsg</p> }
        </div>
    }
    else if (_apiTab == "Bank ID")
    {
        @IntegrasjonsKort(
            "BankID",
