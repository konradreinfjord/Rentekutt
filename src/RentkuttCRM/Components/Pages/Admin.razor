    private string? _zCallerId;
    private string? _zCustomerGuid;
    private string? _zCustomerMsg;
    private string _zNummerFormat = "e164";
    private List<ZissonService.ZAgent> _zAgenter = new();
    private List<ZissonService.ZNummer> _zNumre = new();
