                <div class="bw-titles">
                    <div class="bw-title">Gjeldsregisteret <span class="ww-tag">via Infotorg</span></div>
                    <div class="bw-sub">Oppslag på usikret gjeld — mutual-TLS med virksomhetssertifikat. Kun på fnr med gyldig 2FA-samtykke.</div>
                </div>
                <span class="bw-status status @(_grKonfigurert && _grEnabled ? "on" : "off")">@(_grKonfigurert && _grEnabled ? "Aktiv" : "Av")</span>
            </div>

            <div class="kv-list" style="margin-bottom:16px">
                <span class="k">Søkeavtale</span>
                <span class="v">Signert ✓</span>
                <span class="k">OAuth2-legitimasjon</span>
                <span class="v">@(_grKonfigurert ? "Satt ✓" : "Mangler — sett Gjeldsregisteret__TokenUrl/BaseUrl/ClientId/ClientSecret/Username/Password")</span>
                <span class="k">Miljø</span>
                <span class="v">@(_grMiljo == "prod" ? "Produksjon" : "Test")</span>
                <span class="k">Base-URL</span>
                <span class="v mono">@(string.IsNullOrWhiteSpace(_grBaseUrl) ? "—" : _grBaseUrl)</span>
                <span class="k">Samtykke-sperre</span>
                <span class="v">Oppslag krever gyldig 2FA-samtykke på kundekortet (teknisk barriere)</span>
            </div>

            <h3 class="ww-h">Styring</h3>
            <div class="rule-builder" style="margin-bottom:8px; align-items:flex-end">
