    // Diagnose lest fra KJØRENDE prosess (ikke lagret innstilling): er nøkkelen lastet, og
    // fungerer krypteringen faktisk (rundtur via CryptoService' offentlige API — ingen kodeendring der).
    // Viser NAVNET på miljøvariabler i prosessen som inneholder «FieldKey»/«Gdpr» (aldri verdien).
    // Avslører feilplassering: «Gdpr__FieldKey» = riktig app-setting; «CUSTOMCONNSTR_…»/«SQLCONNSTR_…»
    // = lagt under Connection strings (feil); ingen treff = når ikke prosessen (feil navn/slot).
    private string EnvNoekkelFunn()
    {
        try
        {
            var treff = Environment.GetEnvironmentVariables().Keys.Cast<string>()
                .Where(k => k.Contains("FieldKey", StringComparison.OrdinalIgnoreCase)
                            || k.Contains("Gdpr", StringComparison.OrdinalIgnoreCase))
                .OrderBy(k => k).ToList();
            return treff.Count == 0
                ? "INGEN — nøkkelen når ikke prosessen (sjekk navn/slot/seksjon i Azure)"
                : string.Join(", ", treff);
        }
        catch { return "(kunne ikke lese miljøvariabler)"; }
    }

    private (bool lastet, bool selvtestOk) KrypteringStatus()
    {
        var lastet = Krypto.IsEnabled;
        bool ok = false;
        try
        {
            const string proeve = "12345678901";
            var kryptert = Krypto.Beskytt(proeve);
            ok = Krypto.ErBeskyttet(kryptert) && Krypto.Avdekk(kryptert) == proeve;
        }
        catch { ok = false; }
        return (lastet, ok);
    }

