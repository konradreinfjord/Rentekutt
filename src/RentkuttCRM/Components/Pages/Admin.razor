    }
    private string TredjepartUrl => $"{Nav.BaseUri}api/tredjepart/status";

    // ---- Tredjepart-API (GET status på mobilnummer) ----
    private string _tpToken = "";
    private bool _tpEnabled;
    private string? _tpMsg;
    private async Task LagreTredjepart()
    {
        if (!Session.IsAdmin) return;   // server-side vern (defence-in-depth)
        await Settings.SetAsync(TredjepartController.KeyToken, _tpToken?.Trim());
        await Settings.SetAsync(TredjepartController.KeyEnabled, _tpEnabled ? "true" : "false");
        await Events.LogAsync("Tredjepart-API", _tpEnabled ? "Aktivert / token oppdatert" : "Deaktivert", "Admin");
        _tpMsg = "Lagret.";
    }
    private static bool WebhookFresh(Webhook w) => w.Active && w.LastReceivedAt is { } t && t > DateTime.UtcNow.AddDays(-7);
    // Lampe: grønn hvis det er mottatt data siste 3 døgn.
    private static bool DataSiste3Dogn(DateTime? last) => last is { } t && t > DateTime.UtcNow.AddDays(-3);

    // Siste gang det ble utvekslet data med en bank (siste sending). null = ingen sendinger i utvalget.
    private DateTime? SisteSendtBank(string bankNavn)
    {
        var tider = _sisteSendinger
            .Where(s => string.Equals(s.Bank, bankNavn, StringComparison.OrdinalIgnoreCase))
            .Select(s => s.SendtAt).ToList();
        return tider.Count == 0 ? (DateTime?)null : tider.Max();
    }

    // «Siste oppdatert»-celle: tidspunkt for siste datautveksling. Rød hvis over 3 døgn, ellers grønn.
    private RenderFragment SisteOppdatertCelle(DateTime? t) =>@<td>
        @if (t is null)
        {
            <span class="muted">—</span>
        }
        else
        {
            <span style="font-weight:600; color:@((DateTime.UtcNow - t.Value.ToUniversalTime()).TotalDays > 3 ? "var(--danger,#c0392b)" : "var(--green-dark,#15803d)")">@t.Value.TilOslo().ToString("dd.MM.yyyy HH:mm")</span>
        }
    </td>;

    // ---- Brukeradministrasjon ----
    private List<UserRow> _userRows = new();
