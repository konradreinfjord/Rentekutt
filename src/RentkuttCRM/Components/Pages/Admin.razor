    private async Task AddMerknad()
    {
        _mkMsg = null;
        var verdi = _mkOp == "mellom" ? $"{_mkFra.Trim()}-{_mkTil.Trim()}" : _mkValue?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(_mkBadgeTekst)) { _mkMsg = "Fyll inn merknad-tekst (badge)."; _mkOk = false; return; }
