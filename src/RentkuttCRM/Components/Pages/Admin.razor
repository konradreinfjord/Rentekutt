                    <label>Integrasjon</label>
                    <div class="seg onoff">
                        <button class="@(!_grEnabled ? "active av" : "")" @onclick="() => SettGjeldAktivert(false)">AV</button>
                        <button class="@(_grEnabled ? "active" : "")" @onclick="() => SettGjeldAktivert(true)">PÅ</button>
                    </div>
