    private async Task SlaaOppSamtale()
    {
        if (string.IsNullOrWhiteSpace(_zLookupZid)) return;
        _zLookupKjorer = true; _zLookupResultat = null; StateHasChanged();
        try { _zLookupResultat = await Zisson.SlaaOppSamtaleAsync(_zLookupZid!.Trim()); }
