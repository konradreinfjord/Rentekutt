    private string? _zAgentSjekk;
    private bool _zAgentKjorer;
    private async Task SjekkAgentStatus()
    {
        var agent = string.IsNullOrWhiteSpace(_zAgentSjekk)
            ? await Users.ZissonAgentGuidAsync(Session.UserId)
            : _zAgentSjekk!.Trim();
        if (string.IsNullOrWhiteSpace(agent)) { _zLookupResultat = "Ingen agent å sjekke (skriv inn, eller koble deg selv)."; return; }
        _zAgentKjorer = true; _zLookupResultat = null; StateHasChanged();
        try { _zLookupResultat = await Zisson.AgentStatusAsync(agent!); }
        finally { _zAgentKjorer = false; }
    }

    private string? _zTestAgent;
    private async Task TestRing()
    {
        _zTestSender = true; _zTestMsg = null; StateHasChanged();
        try
        {
            // Bruk overstyrt agent-guid hvis fylt inn, ellers den innloggede brukerens kobling.
            var agent = string.IsNullOrWhiteSpace(_zTestAgent)
                ? await Users.ZissonAgentGuidAsync(Session.UserId)
                : _zTestAgent!.Trim();
            if (string.IsNullOrWhiteSpace(agent))
            {
                _zTestMsg = "Ingen agent å ringe med: lim inn en agent-guid over, eller koble deg selv under Agent-kobling.";
                return;
            }
            var r = await Zisson.ClickToCallAsync(agent, _zTestNummer ?? "");
            _zTestMsg = (r.Ok ? "✓ " : $"✗ (kode {r.Kode}) ") + r.Melding;
        }
        finally { _zTestSender = false; }
    }
