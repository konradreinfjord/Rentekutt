    private async Task SettFane(string t)
    {
        _active = t;
        if (t == "Dialer" && !_dialerLastet) await LastDialerData();
        if (t == "Duplikater" && _duplikater.Count == 0 && !_duplikaterLaster) await LastDuplikater();
    }

    private List<KundekortService.DuplikatGruppe> _duplikater = new();
    private bool _duplikaterLaster;
    private async Task LastDuplikater()
    {
        _duplikaterLaster = true; StateHasChanged();
        try { _duplikater = await Kunder.FinnDuplikaterAsync(); }
        finally { _duplikaterLaster = false; }
    }

    private async Task LastDialerData()
    {
        _dialerLaster = true;
        _dialerLastet = true;   // unngå gjentatt lasting selv om kallet feiler
        StateHasChanged();
        try
        {
            // Dialer-innstillinger lastes her (ikke i den store OnInitializedAsync) så fanen alltid
            // får ferske verdier når den åpnes, uavhengig av resten av admin-initialiseringen.
            _zKonfigurert = await Zisson.ErKonfigurertAsync();
            _zEnabled = await Zisson.AktivertAsync();
            _zAutoAnswer = await Zisson.AutoAnswerAsync();
            _zCallerId = await Zisson.DefaultCallerIdAsync();
            _zCustomerGuid = await Zisson.CustomerGuidAsync();
            _zNummerFormat = await Zisson.NummerFormatAsync();
            _zAgenter = await Zisson.HentAgenterAlleAsync();
            _zNumre = await Zisson.HentVisningsnumreAsync();
            _zTestNummer ??= _userRows.FirstOrDefault(u => u.Id == Session.UserId)?.Mobilnummer;
        }
        finally { _dialerLaster = false; StateHasChanged(); }
    }

    private async Task SaveCustomerGuid()
    {
        await Zisson.SettCustomerGuidAsync(_zCustomerGuid);
        _zKonfigurert = await Zisson.ErKonfigurertAsync();
        _zCustomerMsg = "customerGuid lagret.";
    }

    private bool _zHenter;
    private string? _zHentMsg;
    private async Task HentAgenter()
    {
        _zHenter = true; _zHentMsg = null; StateHasChanged();
        try
        {
            if (!await Zisson.ErKonfigurertAsync()) { _zHentMsg = "Zisson er ikke konfigurert (mangler customerGuid/refreshToken)."; return; }
            _zAgenter = await Zisson.HentAgenterAlleAsync();
            // Vis alltid faktisk HTTP-status per endepunkt (skiller «404/ikke tilgjengelig» fra «tomt»).
            var diag = await Zisson.DiagnostikkAsync();
            _zHentMsg = _zAgenter.Count > 0
                ? $"Hentet {_zAgenter.Count} agent(er). Kopier riktig guid til Agent-kobling under. — {diag}"
                : $"Ingen agenter hentet. Diagnostikk: {diag}";
        }
        finally { _zHenter = false; StateHasChanged(); }
    }

    private async Task ToggleZisson() { _zEnabled = !_zEnabled; await Zisson.SettAktivertAsync(_zEnabled); }
    private async Task ToggleAutoAnswer() { _zAutoAnswer = !_zAutoAnswer; await Zisson.SettAutoAnswerAsync(_zAutoAnswer); }

    private async Task ChangeCallerId(ChangeEventArgs e)
    {
        _zCallerId = e.Value?.ToString();
        await Zisson.SettDefaultCallerIdAsync(_zCallerId);
    }

    private async Task ChangeNummerFormat(ChangeEventArgs e)
    {
        _zNummerFormat = e.Value?.ToString() ?? "e164";
        await Zisson.SettNummerFormatAsync(_zNummerFormat);
    }

    private string? _agentMsg;

    // Dropdown: verdien vi lagrer (bruker-kode/brukernavn, ellers guid), visning og valgt-sjekk.
    private static string AgentVerdi(ZissonService.ZAgent a) => a.LoginId ?? a.Username ?? a.Guid;
    private static string? AgentKode(ZissonService.ZAgent a) => a.LoginId ?? a.Username;
    private static bool AgentErValgt(UserRow u, ZissonService.ZAgent a)
    {
        var s = u.ZissonAgentGuid;
        return !string.IsNullOrWhiteSpace(s) && (
            string.Equals(s, a.LoginId, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(s, a.Username, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(s, a.Guid, StringComparison.OrdinalIgnoreCase));
    }

    // Verdien select-en skal vise for en bruker: den matchende agentens kanoniske verdi (så den
    // huskes selv om lagret verdi er en annen form, f.eks. guid), ellers råverdien.
    private string? ValgtVerdi(UserRow u)
    {
        var a = _zAgenter.FirstOrDefault(x => AgentErValgt(u, x));
        return a is not null ? AgentVerdi(a) : u.ZissonAgentGuid;
    }

