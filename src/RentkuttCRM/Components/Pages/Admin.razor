    // ---- GDPR: anonymisering + sletting ----
    private int _gdprAnonMonths = 12;
    private int _gdprDeleteMonths = 24;
    private string? _gdprMsg;

    // Brute-force-sperre på login
    private int _loginMaxFailHour = SupabaseUserService.DefaultMaxFailHour;
    private int _loginMaxFail24h = SupabaseUserService.DefaultMaxFail24h;
    private string? _loginLimitMsg;
    private async Task SaveLoginLimits()
    {
        if (_loginMaxFailHour < 1) _loginMaxFailHour = 1;
        if (_loginMaxFail24h < 1) _loginMaxFail24h = 1;
        await Settings.SetAsync(SupabaseUserService.KeyMaxFailHour, _loginMaxFailHour.ToString());
        await Settings.SetAsync(SupabaseUserService.KeyMaxFail24h, _loginMaxFail24h.ToString());
        _loginLimitMsg = "Lagret.";
    }

    private bool _require2fa = true;
    private string? _require2faMsg;
    private async Task SaveRequire2fa()
    {
        await Settings.SetAsync(TwoFactorService.KeyRequireAll, _require2fa ? "true" : "false");
        _require2faMsg = _require2fa
            ? "Lagret. 2FA er nå påkrevd for alle ansatte."
            : "Lagret. 2FA er valgfritt (styres per bruker).";
    }
    private async Task SaveGdpr()
    {
        if (_gdprAnonMonths < 1) _gdprAnonMonths = 1;
        if (_gdprDeleteMonths < 1) _gdprDeleteMonths = 1;
        await Settings.SetAsync("gdpr_anonymize_months", _gdprAnonMonths.ToString());
        await Settings.SetAsync("gdpr_delete_months", _gdprDeleteMonths.ToString());
        _gdprMsg = "Lagret.";
    }

    private bool _gdprKjorer;
    private bool _gdprBekreft;

    private async Task ForhaandsvisGdpr()
    {
        _gdprKjorer = true;
        _gdprMsg = null;
        var (anon, slett, feil) = await Gdpr.KjorAsync(_gdprAnonMonths, _gdprDeleteMonths, torrkjor: true);
        _gdprMsg = feil is null
            ? $"Tørrkjør: ville anonymisert {anon} og slettet {slett} kundekort (ingen data endret)."
