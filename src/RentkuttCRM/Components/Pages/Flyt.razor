@page "/crm/flyt"
@implements IAsyncDisposable
@inject RentkuttCRM.Services.SessionState Session
@inject RentkuttCRM.Services.SettingsService Settings
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Flyt — Rentekutt</PageTitle>

<div class="wide-page">
<div class="dash-head" style="margin-bottom:10px">
    <div>
        <h1 class="page-title">Flyt</h1>
        <p class="page-sub">Bygg kundereisen som et flyt-board. Dra noder for å flytte, koble dem med piler, og beskriv hendelser (bank, postnr, avslag …).</p>
    </div>
</div>

<div class="flyt-toolbar">
    <button class="btn-primary btn-sm" @onclick="LeggTilNode">+ Ny node</button>
    <span class="flyt-hint">Klikk en node for å velge/redigere · dra for å flytte</span>
    @if (_kobleFra is not null)
    {
        <span class="flyt-koble-banner">Klikk målnoden for å koble fra «@NodeTekst(_kobleFra)» — <button class="lenke" @onclick="() => _kobleFra = null">avbryt</button></span>
    }
    <div class="db-spacer"></div>
    @if (_lagret)
    {
        <span class="flyt-lagret">Lagret ✓</span>
    }
    <button class="btn-sec btn-sm" @onclick="Tilbakestill" title="Nullstill til standard-eksempel">Tilbakestill</button>
</div>

<div class="flyt-layout">
    <div class="flyt-canvas" style="width:@(Bredde)px; height:@(Hoyde)px">
        <svg class="flyt-edges" width="@Bredde" height="@Hoyde">
            <defs>
                <marker id="flyt-arrow" markerWidth="12" markerHeight="12" refX="9" refY="4" orient="auto">
                    <path d="M0,0 L9,4 L0,8 Z" fill="#94a3b8" />
                </marker>
            </defs>
            @foreach (var kant in _board.Kanter)
            {
                var fra = Finn(kant.Fra); var til = Finn(kant.Til);
                if (fra is null || til is null) { continue; }
                var (x1, y1) = BoxKant(SenterX(fra), SenterY(fra), SenterX(til), SenterY(til));
                var (x2, y2) = BoxKant(SenterX(til), SenterY(til), SenterX(fra), SenterY(fra));
                <line x1="@F(x1)" y1="@F(y1)" x2="@F(x2)" y2="@F(y2)" stroke="@(_valgtKant == kant ? "#1f5fc4" : "#94a3b8")" stroke-width="@(_valgtKant == kant ? 3 : 2)" marker-end="url(#flyt-arrow)" />
            }
        </svg>
        @foreach (var kant in _board.Kanter)
        {
            var fra = Finn(kant.Fra); var til = Finn(kant.Til);
            if (fra is null || til is null) { continue; }
            var mx = (SenterX(fra) + SenterX(til)) / 2;
            var my = (SenterY(fra) + SenterY(til)) / 2;
            <div class="flyt-kant-etikett @(string.IsNullOrWhiteSpace(kant.Etikett) ? "tom" : "")" style="left:@(F(mx))px; top:@(F(my))px" @onclick="() => VelgKant(kant)">
                @(string.IsNullOrWhiteSpace(kant.Etikett) ? "＋" : kant.Etikett)
            </div>
        }
        @foreach (var node in _board.Noder)
        {
            <div class="flyt-node @(_valgtNode == node.Id ? "valgt" : "")" @key="node.Id" data-flytid="@node.Id"
                 style="left:@(F(node.X))px; top:@(F(node.Y))px; --nc:@node.Farge">
                <span class="flyt-node-dot"></span>
                <span class="flyt-node-tekst">@node.Tekst</span>
            </div>
        }
    </div>

    <div class="flyt-side">
        @if (_valgtNode is not null && Finn(_valgtNode) is { } n)
        {
            <div class="flyt-panel">
                <div class="flyt-panel-h">Node</div>
                <label class="flyt-lbl">Tekst</label>
                <textarea class="flyt-ta" rows="3" @bind="n.Tekst" @bind:after="Lagre"></textarea>
                <label class="flyt-lbl">Farge</label>
                <div class="flyt-farger">
                    @foreach (var f in Farger)
                    {
                        <button class="flyt-farge @(n.Farge == f ? "on" : "")" style="background:@f" @onclick="() => SettFarge(n, f)"></button>
                    }
                </div>
                <button class="btn-primary btn-sm" style="margin-top:12px; width:100%" @onclick="() => StartKobling(n.Id)">Koble til neste →</button>
                <button class="btn-sec btn-sm" style="margin-top:8px; width:100%; color:#b42318" @onclick="() => SlettNode(n)">Slett node</button>
            </div>
        }
        else if (_valgtKant is not null)
        {
            <div class="flyt-panel">
                <div class="flyt-panel-h">Pil</div>
                <div class="page-sub" style="margin:0 0 8px">@NodeTekst(_valgtKant.Fra) → @NodeTekst(_valgtKant.Til)</div>
                <label class="flyt-lbl">Etikett (f.eks. «avslag», «postnr 7288»)</label>
                <input class="flyt-inp" @bind="_valgtKant.Etikett" @bind:after="Lagre" placeholder="valgfri tekst" />
                <button class="btn-sec btn-sm" style="margin-top:10px; width:100%; color:#b42318" @onclick="SlettKant">Slett pil</button>
            </div>
        }
        else
        {
            <div class="flyt-panel flyt-panel-tom">
                <p class="page-sub" style="margin:0">Velg en node eller pil for å redigere. Legg til noder med «+ Ny node», og koble dem med «Koble til neste».</p>
            </div>
        }
    </div>
</div>
</div>

@code {
    private const double Bredde = 2400, Hoyde = 1500;
    private const double NodeW = 190, NodeH = 58;
    private static readonly string[] Farger = { "#1f5fc4", "#2f8a3e", "#e0a800", "#b42318", "#6b3fc4", "#0e7490", "#5b6b7f" };

    private FlytBoard _board = new();
    private string? _valgtNode;
    private FlytKant? _valgtKant;
    private string? _kobleFra;
    private bool _lagret;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Flyt>? _ref;

    private const string Key = "flyt_board";

    public class FlytNode { public string Id { get; set; } = Guid.NewGuid().ToString("N")[..8]; public string Tekst { get; set; } = ""; public double X { get; set; } public double Y { get; set; } public string Farge { get; set; } = "#1f5fc4"; }
    public class FlytKant { public string Fra { get; set; } = ""; public string Til { get; set; } = ""; public string Etikett { get; set; } = ""; }
    public class FlytBoard { public List<FlytNode> Noder { get; set; } = new(); public List<FlytKant> Kanter { get; set; } = new(); }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        var json = await Settings.GetAsync(Key);
        if (!string.IsNullOrWhiteSpace(json))
        {
            try { _board = System.Text.Json.JsonSerializer.Deserialize<FlytBoard>(json) ?? new(); } catch { _board = new(); }
        }
        if (_board.Noder.Count == 0) _board = Standard();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./flyt.js");
            _ref = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _ref);
        }
        if (_module is not null) await _module.InvokeVoidAsync("attachAll");
    }

    [JSInvokable]
    public async Task OppdaterPosisjon(string id, double x, double y)
    {
        var n = Finn(id);
        if (n is null) return;
        n.X = Math.Round(x); n.Y = Math.Round(y);
        await Lagre();
        StateHasChanged();
    }

    [JSInvokable]
    public void NodeKlikk(string id)
    {
        if (_kobleFra is not null)
        {
            if (_kobleFra != id && !_board.Kanter.Any(k => k.Fra == _kobleFra && k.Til == id))
                _board.Kanter.Add(new FlytKant { Fra = _kobleFra, Til = id });
            _kobleFra = null;
            _ = Lagre();
        }
        else
        {
            _valgtNode = id; _valgtKant = null;
        }
        StateHasChanged();
    }

    private void LeggTilNode()
    {
        var n = new FlytNode { Tekst = "Ny hendelse", X = 60 + _board.Noder.Count % 5 * 40, Y = 60 + _board.Noder.Count % 5 * 40, Farge = "#1f5fc4" };
        _board.Noder.Add(n);
        _valgtNode = n.Id; _valgtKant = null;
        _ = Lagre();
    }

    private void StartKobling(string id) { _kobleFra = id; _valgtNode = null; _valgtKant = null; }
    private void VelgKant(FlytKant k) { _valgtKant = k; _valgtNode = null; }
    private void SettFarge(FlytNode n, string f) { n.Farge = f; _ = Lagre(); }

    private void SlettNode(FlytNode n)
    {
        _board.Noder.Remove(n);
        _board.Kanter.RemoveAll(k => k.Fra == n.Id || k.Til == n.Id);
        _valgtNode = null;
        _ = Lagre();
    }

    private void SlettKant()
    {
        if (_valgtKant is not null) { _board.Kanter.Remove(_valgtKant); _valgtKant = null; _ = Lagre(); }
    }

    private async Task Tilbakestill()
    {
        _board = Standard(); _valgtNode = null; _valgtKant = null; _kobleFra = null;
        await Lagre();
    }

    private async Task Lagre()
    {
        await Settings.SetAsync(Key, System.Text.Json.JsonSerializer.Serialize(_board));
        _lagret = true;
        StateHasChanged();
    }

    private FlytNode? Finn(string? id) => id is null ? null : _board.Noder.FirstOrDefault(n => n.Id == id);
    private string NodeTekst(string? id) => Finn(id)?.Tekst ?? "?";
    private double SenterX(FlytNode n) => n.X + NodeW / 2;
    private double SenterY(FlytNode n) => n.Y + NodeH / 2;
    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Punkt der linjen fra (cx,cy) mot senter (tx,ty) treffer målboksens kant.
    private static (double, double) BoxKant(double tx, double ty, double cx, double cy)
    {
        double dx = cx - tx, dy = cy - ty;
        if (dx == 0 && dy == 0) return (tx, ty);
        double hw = NodeW / 2, hh = NodeH / 2;
        double sx = dx == 0 ? double.PositiveInfinity : hw / Math.Abs(dx);
        double sy = dy == 0 ? double.PositiveInfinity : hh / Math.Abs(dy);
        double t = Math.Min(sx, sy);
        return (tx + dx * t, ty + dy * t);
    }

    private static FlytBoard Standard() => new()
    {
        Noder = new()
        {
            new() { Id = "n1", Tekst = "Nytt lead", X = 120, Y = 60, Farge = "#e0a800" },
            new() { Id = "n2", Tekst = "Påbegynt søknad", X = 120, Y = 200, Farge = "#e0a800" },
            new() { Id = "n3", Tekst = "Ny søknad (fullført)", X = 120, Y = 340, Farge = "#e0a800" },
            new() { Id = "n4", Tekst = "Bank: Soknedal (postnr 7288)", X = 120, Y = 480, Farge = "#6b3fc4" },
            new() { Id = "n5", Tekst = "Avslag", X = 470, Y = 480, Farge = "#b42318" },
            new() { Id = "n6", Tekst = "Ny bank / videre oppfølging", X = 470, Y = 620, Farge = "#1f5fc4" },
            new() { Id = "n7", Tekst = "Utbetalt", X = 120, Y = 620, Farge = "#2f8a3e" },
        },
        Kanter = new()
        {
            new() { Fra = "n1", Til = "n2" },
            new() { Fra = "n2", Til = "n3" },
            new() { Fra = "n3", Til = "n4" },
            new() { Fra = "n4", Til = "n5", Etikett = "avslag" },
            new() { Fra = "n5", Til = "n6" },
            new() { Fra = "n4", Til = "n7", Etikett = "innvilget" },
        },
    };

    public async ValueTask DisposeAsync()
    {
        _ref?.Dispose();
        if (_module is not null) { try { await _module.DisposeAsync(); } catch { } }
    }
}
