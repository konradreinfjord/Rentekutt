@page "/crm/flyt"
@implements IAsyncDisposable
@inject RentkuttCRM.Services.SessionState Session
@inject RentkuttCRM.Services.SettingsService Settings
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Flyt — Rentekutt</PageTitle>

<div class="wide-page">
<div class="dash-head" style="margin-bottom:10px">
    <div>
        <h1 class="page-title">Flyt</h1>
        <p class="page-sub">Bygg kundereisen som et flyt-board. Dra noder for å flytte, koble dem med piler, og beskriv hendelser (bank, postnr, avslag …).</p>
    </div>
</div>

<div class="flyt-toolbar">
    <button class="btn-primary btn-sm" @onclick="LeggTilNode">+ Ny node</button>
    <span class="flyt-hint">Klikk en node for å velge/redigere · dra for å flytte</span>
    @if (_kobleFra is not null)
    {
        <span class="flyt-koble-banner">Klikk målnoden for å koble fra «@NodeTekst(_kobleFra)» — <button class="lenke" @onclick="() => _kobleFra = null">avbryt</button></span>
    }
    <div class="db-spacer"></div>
    <div class="flyt-zoom">
        <button class="btn-sec btn-sm" @onclick="() => Zoom(-0.1)" title="Zoom ut">−</button>
        <span class="flyt-zoom-tall">@((int)Math.Round(_board.Zoom * 100)) %</span>
        <button class="btn-sec btn-sm" @onclick="() => Zoom(0.1)" title="Zoom inn">+</button>
        <button class="btn-sec btn-sm" @onclick="() => SettZoom(1)" title="Tilbakestill zoom">100 %</button>
    </div>
    @if (_lagret)
    {
        <span class="flyt-lagret">Lagret ✓</span>
    }
    <button class="btn-sec btn-sm" @onclick="Tilbakestill" title="Nullstill til standard-eksempel">Tilbakestill</button>
</div>

<div class="flyt-layout">
    <div class="flyt-canvas" data-zoom="@F(_board.Zoom)" data-off="@F(Off)">
        <div class="flyt-scaler" style="width:@(F(CW * _board.Zoom))px; height:@(F(CH * _board.Zoom))px">
            <div class="flyt-content" style="width:@(F(CW))px; height:@(F(CH))px; transform:scale(@F(_board.Zoom)); transform-origin:0 0">
                <svg class="flyt-edges" width="@F(CW)" height="@F(CH)">
                    <defs>
                        <marker id="flyt-arrow" markerWidth="12" markerHeight="12" refX="9" refY="4" orient="auto">
                            <path d="M0,0 L9,4 L0,8 Z" fill="#94a3b8" />
                        </marker>
                    </defs>
                    @for (var i = 0; i < _board.Kanter.Count; i++)
                    {
                        var kant = _board.Kanter[i];
                        <path class="flyt-edge-hit" data-edge="@i" @onclick="() => VelgKant(kant)"></path>
                        <path class="flyt-edge" data-from="@kant.Fra" data-to="@kant.Til" data-edge="@i" data-retning="@kant.Retning"
                              data-fraanker="@kant.FraAnker" data-tilanker="@kant.TilAnker" data-punkter="@PunkterJson(kant)" fill="none"
                              stroke="@(_valgtKant == kant ? "#1f5fc4" : "#94a3b8")" stroke-width="@(_valgtKant == kant ? 3 : 2)"
                              stroke-linejoin="round" marker-end="@(kant.Pil ? "url(#flyt-arrow)" : null)"></path>
                    }
                </svg>
                @for (var i = 0; i < _board.Kanter.Count; i++)
                {
                    var kant = _board.Kanter[i];
                    var fra = Finn(kant.Fra); var til = Finn(kant.Til);
                    if (fra is null || til is null) { continue; }
                    var mx = (SenterX(fra) + SenterX(til)) / 2 + Off;
                    var my = (SenterY(fra) + SenterY(til)) / 2 + Off;
                    <div class="flyt-kant-etikett flyt-str-@(kant.Str) @(_valgtKant == kant ? "valgt" : "") @(string.IsNullOrWhiteSpace(kant.Etikett) ? "tom" : "")" data-edge="@i" style="left:@(F(mx))px; top:@(F(my))px; @(string.IsNullOrWhiteSpace(kant.EtikettFarge) ? "" : $"--ec:{kant.EtikettFarge}")" @onclick="() => VelgKant(kant)">
                        @(string.IsNullOrWhiteSpace(kant.Etikett) ? "＋" : kant.Etikett)
                    </div>
                }
                @foreach (var node in _board.Noder)
                {
                    <div class="flyt-node @(_valgtNode == node.Id ? "valgt" : "")" @key="node.Id" data-flytid="@node.Id"
                         style="left:@(F(node.X + Off))px; top:@(F(node.Y + Off))px; --nc:@node.Farge">
                        <span class="flyt-node-dot"></span>
                        <span class="flyt-node-tekst">@node.Tekst</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="flyt-side">
        @if (_valgtNode is not null && Finn(_valgtNode) is { } n)
        {
            <div class="flyt-panel">
                <div class="flyt-panel-h">Node</div>
                <label class="flyt-lbl">Tekst</label>
                <textarea class="flyt-ta" rows="3" @bind="n.Tekst" @bind:after="Lagre"></textarea>
                <label class="flyt-lbl">Farge</label>
                <div class="flyt-farger">
                    @foreach (var f in Farger)
                    {
                        <button class="flyt-farge @(n.Farge == f ? "on" : "")" style="background:@f" @onclick="() => SettFarge(n, f)"></button>
                    }
                </div>
                <button class="btn-primary btn-sm" style="margin-top:12px; width:100%" @onclick="() => StartKobling(n.Id)">Koble til neste →</button>
                <button class="btn-sec btn-sm" style="margin-top:8px; width:100%; color:#b42318" @onclick="() => SlettNode(n)">Slett node</button>
            </div>
        }
        else if (_valgtKant is not null)
        {
            <div class="flyt-panel">
                <div class="flyt-panel-h">Pil</div>

                <label class="flyt-lbl">Fra</label>
                <select class="flyt-inp" value="@_valgtKant.Fra" @onchange="e => KobleOm(_valgtKant, (string?)e.Value, null)">
                    @foreach (var nd in _board.Noder)
                    {
                        <option value="@nd.Id" selected="@(nd.Id == _valgtKant.Fra)">@nd.Tekst</option>
                    }
                </select>
                <label class="flyt-lbl">Til</label>
                <select class="flyt-inp" value="@_valgtKant.Til" @onchange="e => KobleOm(_valgtKant, null, (string?)e.Value)">
                    @foreach (var nd in _board.Noder)
                    {
                        <option value="@nd.Id" selected="@(nd.Id == _valgtKant.Til)">@nd.Tekst</option>
                    }
                </select>

                <label class="flyt-lbl">Etikett (f.eks. «avslag», «postnr 7288»)</label>
                <input class="flyt-inp" @bind="_valgtKant.Etikett" @bind:after="Lagre" placeholder="valgfri tekst" />

                <label class="flyt-lbl">Etikett-farge</label>
                <div class="flyt-farger">
                    <button class="flyt-farge @(_valgtKant.EtikettFarge == "" ? "on" : "")" style="background:#fff; border-color:#cbd5e1" title="Standard" @onclick='() => SettEtikettFarge(_valgtKant, "")'></button>
                    @foreach (var f in Farger)
                    {
                        <button class="flyt-farge @(_valgtKant.EtikettFarge == f ? "on" : "")" style="background:@f" @onclick="() => SettEtikettFarge(_valgtKant, f)"></button>
                    }
                </div>

                <label class="flyt-lbl">Etikett-størrelse</label>
                <div class="seg onoff flyt-retning">
                    <button class="@(_valgtKant.Str == "s" ? "active" : "")" @onclick='() => SettStr(_valgtKant, "s")'>Liten</button>
                    <button class="@(_valgtKant.Str == "m" ? "active" : "")" @onclick='() => SettStr(_valgtKant, "m")'>Normal</button>
                    <button class="@(_valgtKant.Str == "l" ? "active" : "")" @onclick='() => SettStr(_valgtKant, "l")'>Stor</button>
                </div>

                <label class="flyt-lbl">Pilspiss</label>
                <div class="seg onoff flyt-retning">
                    <button class="@(_valgtKant.Pil ? "active" : "")" @onclick="() => SettPil(_valgtKant, true)">Pil →</button>
                    <button class="@(!_valgtKant.Pil ? "active" : "")" @onclick="() => SettPil(_valgtKant, false)">Ingen</button>
                </div>

                <label class="flyt-lbl">Fest på «@NodeTekst(_valgtKant.Fra)» (fra)</label>
                <div class="seg onoff flyt-anker">
                    <button class="@(_valgtKant.FraAnker == "" ? "active" : "")" @onclick='() => SettAnker(_valgtKant, true, "")' title="Auto">Auto</button>
                    <button class="@(_valgtKant.FraAnker == "t" ? "active" : "")" @onclick='() => SettAnker(_valgtKant, true, "t")' title="Topp">↑</button>
                    <button class="@(_valgtKant.FraAnker == "r" ? "active" : "")" @onclick='() => SettAnker(_valgtKant, true, "r")' title="Høyre">→</button>
                    <button class="@(_valgtKant.FraAnker == "b" ? "active" : "")" @onclick='() => SettAnker(_valgtKant, true, "b")' title="Bunn">↓</button>
                    <button class="@(_valgtKant.FraAnker == "l" ? "active" : "")" @onclick='() => SettAnker(_valgtKant, true, "l")' title="Venstre">←</button>
                </div>
                <label class="flyt-lbl">Fest på «@NodeTekst(_valgtKant.Til)» (til)</label>
                <div class="seg onoff flyt-anker">
                    <button class="@(_valgtKant.TilAnker == "" ? "active" : "")" @onclick='() => SettAnker(_valgtKant, false, "")' title="Auto">Auto</button>
                    <button class="@(_valgtKant.TilAnker == "t" ? "active" : "")" @onclick='() => SettAnker(_valgtKant, false, "t")' title="Topp">↑</button>
                    <button class="@(_valgtKant.TilAnker == "r" ? "active" : "")" @onclick='() => SettAnker(_valgtKant, false, "r")' title="Høyre">→</button>
                    <button class="@(_valgtKant.TilAnker == "b" ? "active" : "")" @onclick='() => SettAnker(_valgtKant, false, "b")' title="Bunn">↓</button>
                    <button class="@(_valgtKant.TilAnker == "l" ? "active" : "")" @onclick='() => SettAnker(_valgtKant, false, "l")' title="Venstre">←</button>
                </div>

                <label class="flyt-lbl">Egen vei (punktvis)</label>
                @if (_wpEdge == _board.Kanter.IndexOf(_valgtKant))
                {
                    <div class="flyt-wp-banner">Klikk på lerretet for å legge veipunkter… <button class="lenke" @onclick="StoppWaypoint">ferdig</button></div>
                }
                else
                {
                    <button class="btn-sec btn-sm" style="width:100%" @onclick="() => StartWaypoint(_valgtKant)">✏ Tegn egen vei</button>
                }
                @if (_valgtKant.Punkter.Count > 0)
                {
                    <button class="btn-sec btn-sm" style="width:100%; margin-top:6px" @onclick="() => NullstillVei(_valgtKant)">Nullstill vei (@_valgtKant.Punkter.Count punkt)</button>
                }

                <button class="btn-sec btn-sm" style="margin-top:10px; width:100%; color:#b42318" @onclick="SlettKant">Slett pil</button>
            </div>
        }
        else
        {
            <div class="flyt-panel flyt-panel-tom">
                <p class="page-sub" style="margin:0">Velg en node eller pil for å redigere. Legg til noder med «+ Ny node», og koble dem med «Koble til neste».</p>
            </div>
        }
    </div>
</div>
</div>

@code {
    private const double Bredde = 2400, Hoyde = 1500;
    private const double Off = 800;                 // ledig plass til venstre/oppe (så noder kan flyttes utenfor origo)
    private const double CW = Bredde + Off, CH = Hoyde + Off;   // faktisk innhold-størrelse
    private const double NodeW = 190, NodeH = 58;
    private static readonly string[] Farger = { "#1f5fc4", "#2f8a3e", "#e0a800", "#b42318", "#6b3fc4", "#0e7490", "#5b6b7f" };

    private FlytBoard _board = new();
    private string? _valgtNode;
    private FlytKant? _valgtKant;
    private string? _kobleFra;
    private int _wpEdge = -1;   // kant-indeks vi legger veipunkter på (-1 = av)
    private bool _lagret;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Flyt>? _ref;

    private const string Key = "flyt_board";

    private static string PunkterJson(FlytKant k) =>
        System.Text.Json.JsonSerializer.Serialize(k.Punkter.Select(p => new { x = p.X + Off, y = p.Y + Off }));

    public class FlytNode { public string Id { get; set; } = Guid.NewGuid().ToString("N")[..8]; public string Tekst { get; set; } = ""; public double X { get; set; } public double Y { get; set; } public string Farge { get; set; } = "#1f5fc4"; }
    public class Punkt { public double X { get; set; } public double Y { get; set; } }
    public class FlytKant { public string Fra { get; set; } = ""; public string Til { get; set; } = ""; public string Etikett { get; set; } = ""; public string Retning { get; set; } = ""; public List<Punkt> Punkter { get; set; } = new(); public string EtikettFarge { get; set; } = ""; public string Str { get; set; } = "m"; public string FraAnker { get; set; } = ""; public string TilAnker { get; set; } = ""; public bool Pil { get; set; } = true; }
    public class FlytBoard { public List<FlytNode> Noder { get; set; } = new(); public List<FlytKant> Kanter { get; set; } = new(); public double Zoom { get; set; } = 1; }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        var json = await Settings.GetAsync(Key);
        if (!string.IsNullOrWhiteSpace(json))
        {
            try { _board = System.Text.Json.JsonSerializer.Deserialize<FlytBoard>(json) ?? new(); } catch { _board = new(); }
        }
        if (_board.Noder.Count == 0) _board = Standard();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./flyt.js");
            _ref = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _ref);
        }
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("attachAll");
            await _module.InvokeVoidAsync("redrawEdges");
        }
    }

    [JSInvokable]
    public async Task OppdaterPosisjon(string id, double x, double y)
    {
        var n = Finn(id);
        if (n is null) return;
        n.X = Math.Round(x); n.Y = Math.Round(y);
        await Lagre();
        StateHasChanged();
    }

    [JSInvokable]
    public void NodeKlikk(string id)
    {
        if (_kobleFra is not null)
        {
            if (_kobleFra != id && !_board.Kanter.Any(k => k.Fra == _kobleFra && k.Til == id))
                _board.Kanter.Add(new FlytKant { Fra = _kobleFra, Til = id });
            _kobleFra = null;
            _ = Lagre();
        }
        else
        {
            _valgtNode = id; _valgtKant = null;
        }
        StateHasChanged();
    }

    private void LeggTilNode()
    {
        var n = new FlytNode { Tekst = "Ny hendelse", X = 60 + _board.Noder.Count % 5 * 40, Y = 60 + _board.Noder.Count % 5 * 40, Farge = "#1f5fc4" };
        _board.Noder.Add(n);
        _valgtNode = n.Id; _valgtKant = null;
        _ = Lagre();
    }

    private void StartKobling(string id) { _kobleFra = id; _valgtNode = null; _valgtKant = null; }
    private void VelgKant(FlytKant k) { _valgtKant = k; _valgtNode = null; _ = StoppWaypoint(); }
    private void SettFarge(FlytNode n, string f) { n.Farge = f; _ = Lagre(); }

    private async Task Zoom(double delta) => await SettZoom(_board.Zoom + delta);
    private async Task SettZoom(double z)
    {
        _board.Zoom = Math.Clamp(Math.Round(z, 2), 0.4, 2.0);
        await Lagre();
        if (_module is not null) { await _module.InvokeVoidAsync("redrawEdges"); }
    }

    private void SettRetning(FlytKant k, string r) { k.Retning = r; _ = Lagre(); }
    private void SettPil(FlytKant k, bool pil) { k.Pil = pil; _ = Lagre(); }
    private async Task SettAnker(FlytKant k, bool fra, string a)
    {
        if (fra) k.FraAnker = a; else k.TilAnker = a;
        await Lagre();
        if (_module is not null) await _module.InvokeVoidAsync("redrawEdges");
    }
    private void SettEtikettFarge(FlytKant k, string f) { k.EtikettFarge = f; _ = Lagre(); }
    private void SettStr(FlytKant k, string s) { k.Str = s; _ = Lagre(); }

    // Koble om pilens endepunkt (fra/til) til en annen node.
    private async Task KobleOm(FlytKant k, string? fra, string? til)
    {
        if (fra is not null) k.Fra = fra;
        if (til is not null) k.Til = til;
        k.Punkter.Clear();   // gammel egendefinert vei passer ikke lenger
        await Lagre();
        if (_module is not null) await _module.InvokeVoidAsync("redrawEdges");
    }

    // Veipunkt-modus: klikk på lerretet legger punkter på valgt kant.
    private async Task StartWaypoint(FlytKant k)
    {
        _wpEdge = _board.Kanter.IndexOf(k);
        if (_module is not null) await _module.InvokeVoidAsync("settWaypointModus", _wpEdge);
    }
    private async Task StoppWaypoint()
    {
        if (_wpEdge < 0) return;
        _wpEdge = -1;
        if (_module is not null) await _module.InvokeVoidAsync("settWaypointModus", -1);
    }
    private async Task NullstillVei(FlytKant k) { k.Punkter.Clear(); await Lagre(); if (_module is not null) await _module.InvokeVoidAsync("redrawEdges"); }

    [JSInvokable]
    public async Task LeggTilPunkt(int edgeIdx, double x, double y)
    {
        if (edgeIdx < 0 || edgeIdx >= _board.Kanter.Count) return;
        _board.Kanter[edgeIdx].Punkter.Add(new Punkt { X = Math.Round(x - Off), Y = Math.Round(y - Off) });
        await Lagre();
        if (_module is not null) await _module.InvokeVoidAsync("redrawEdges");
    }

    private void SlettNode(FlytNode n)
    {
        _board.Noder.Remove(n);
        _board.Kanter.RemoveAll(k => k.Fra == n.Id || k.Til == n.Id);
        _valgtNode = null;
        _ = Lagre();
    }

    private void SlettKant()
    {
        if (_valgtKant is not null) { _board.Kanter.Remove(_valgtKant); _valgtKant = null; _ = Lagre(); }
    }

    private async Task Tilbakestill()
    {
        _board = Standard(); _valgtNode = null; _valgtKant = null; _kobleFra = null;
        await Lagre();
    }

    private async Task Lagre()
    {
        await Settings.SetAsync(Key, System.Text.Json.JsonSerializer.Serialize(_board));
        _lagret = true;
        StateHasChanged();
    }

    private FlytNode? Finn(string? id) => id is null ? null : _board.Noder.FirstOrDefault(n => n.Id == id);
    private string NodeTekst(string? id) => Finn(id)?.Tekst ?? "?";
    private double SenterX(FlytNode n) => n.X + NodeW / 2;
    private double SenterY(FlytNode n) => n.Y + NodeH / 2;
    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static FlytBoard Standard() => new()
    {
        Noder = new()
        {
            new() { Id = "n1", Tekst = "Nytt lead", X = 120, Y = 60, Farge = "#e0a800" },
            new() { Id = "n2", Tekst = "Påbegynt søknad", X = 120, Y = 200, Farge = "#e0a800" },
            new() { Id = "n3", Tekst = "Ny søknad (fullført)", X = 120, Y = 340, Farge = "#e0a800" },
            new() { Id = "n4", Tekst = "Bank: Soknedal (postnr 7288)", X = 120, Y = 480, Farge = "#6b3fc4" },
            new() { Id = "n5", Tekst = "Avslag", X = 470, Y = 480, Farge = "#b42318" },
            new() { Id = "n6", Tekst = "Ny bank / videre oppfølging", X = 470, Y = 620, Farge = "#1f5fc4" },
            new() { Id = "n7", Tekst = "Utbetalt", X = 120, Y = 620, Farge = "#2f8a3e" },
        },
        Kanter = new()
        {
            new() { Fra = "n1", Til = "n2" },
            new() { Fra = "n2", Til = "n3" },
            new() { Fra = "n3", Til = "n4" },
            new() { Fra = "n4", Til = "n5", Etikett = "avslag" },
            new() { Fra = "n5", Til = "n6" },
            new() { Fra = "n4", Til = "n7", Etikett = "innvilget" },
        },
    };

    public async ValueTask DisposeAsync()
    {
        _ref?.Dispose();
        if (_module is not null) { try { await _module.DisposeAsync(); } catch { } }
    }
}
