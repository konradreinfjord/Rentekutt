@page "/"
@page "/login"
@inject RentkuttCRM.Services.SessionState Session
@inject RentkuttCRM.Services.SupabaseUserService Users
@inject RentkuttCRM.Services.TwoFactorService TwoFactor
@inject RentkuttCRM.Services.SettingsService Settings
@inject NavigationManager Nav
@inject ILogger<Login> Logger
@inject ProtectedLocalStorage LocalStorage

<PageTitle>Logg inn — Rentekutt</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <div class="login-brand">
            <img src="rentekutt-logo.svg" alt="Rentekutt" class="login-logo" />
        </div>

        @if (_step == 1)
        {
            <EditForm Model="@model" OnValidSubmit="HandleLogin">
                <div class="form-field">
                    <label>E-post</label>
                    <InputText @bind-Value="model.Email" placeholder="navn@rentekutt.no" autocomplete="username" />
                </div>
                <div class="form-field">
                    <label>Passord</label>
                    <InputText type="password" @bind-Value="model.Password" placeholder="••••••••" autocomplete="current-password" />
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="login-error">@_error</div>
                }
                <button type="submit" class="btn-primary full" disabled="@_busy">
                    @(_busy ? "Logger inn…" : "Logg inn")
                </button>
            </EditForm>
        }
        else if (_step == 3)
        {
            <div>
                <p class="page-sub" style="margin:0 0 14px">
                    Tofaktor-autentisering er påkrevd. Registrer mobilnummeret ditt for å motta engangskoder på SMS.
                </p>
                <div class="form-field">
                    <label>Mobilnummer</label>
                    <input @bind="_mobil" placeholder="+47 …" autocomplete="tel" inputmode="tel" />
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="login-error">@_error</div>
                }
                <button class="btn-primary full" @onclick="RegistrerMobil" disabled="@_busy">
                    @(_busy ? "Sender kode…" : "Registrer og send kode")
                </button>
                <p class="login-note"><a href="/login" @onclick:preventDefault @onclick="Reset">Start på nytt</a></p>
            </div>
        }
        else
        {
            <div>
                <p class="page-sub" style="margin:0 0 14px">Vi sendte en engangskode på SMS. Skriv den inn for å fullføre innloggingen.</p>
                <div class="form-field">
                    <label>SMS-kode</label>
                    <input @bind="_code" placeholder="6-sifret kode" autocomplete="one-time-code" inputmode="numeric" />
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="login-error">@_error</div>
                }
                <button class="btn-primary full" @onclick="HandleVerify" disabled="@_busy">
                    @(_busy ? "Verifiserer…" : "Bekreft kode")
                </button>
                <p class="login-note">Feil nummer? <a href="/login" @onclick:preventDefault @onclick="Reset">Start på nytt</a></p>
            </div>
        }

        @if (_step == 1 && !Users.IsConfigured)
        {
            <p class="login-note">Staging — skriv hva som helst for å logge inn.</p>
        }
    </div>
</div>

@code {
    private readonly LoginModel model = new();
    private string _code = "";
    private string _mobil = "";
    private int _step = 1;
    private UserRow? _pending;
    // Brukeren må aktivere 2FA nå (global påkrevd, men ennå ikke satt opp) — settes true i selvbetjent oppsett.
    private bool _maaAktivere2fa;
    private string? _error;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (Session.IsLoggedIn) Nav.NavigateTo("/crm");
    }

    private async Task HandleLogin()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Users.SignInAsync(model.Email, model.Password);
            if (result is not { Ok: true, User: not null })
            {
                _error = result.Error ?? "Innlogging feilet.";
                _busy = false;
                return;
            }

            var user = result.User;

            // Krever kontoen 2FA? Enten globalt påkrevd (alle ansatte) eller per-bruker-flagget.
            // I staging (uten Supabase/SMS) hoppes 2FA over slik at man kommer inn.
            var globaltPaakrevd = await Settings.GetBoolAsync(TwoFactorService.KeyRequireAll, true);
            var kreverTofaktor = Users.IsConfigured && (globaltPaakrevd || user.TwoFactorEnabled);

            if (kreverTofaktor)
            {
                // Fail-closed: uten SMS-kanal (LinkMobility) kan vi ikke levere andrefaktor.
                if (!TwoFactor.SmsKonfigurert)
                {
                    _error = "Tofaktor er påkrevd, men SMS-tjenesten er ikke konfigurert. Kontakt administrator.";
                    _busy = false;
                    return;
                }

                _pending = user;

                // Selvbetjent oppsett: mangler brukeren mobilnummer, la hen registrere det nå
                // (i stedet for å bli utestengt).
                if (string.IsNullOrWhiteSpace(user.Mobilnummer))
                {
                    _maaAktivere2fa = true;
                    _step = 3;
                    _busy = false;
                    return;
                }

                var (sent, error) = await TwoFactor.SendKodeAsync(user);
                if (!sent) { _error = error; _busy = false; return; }
                _maaAktivere2fa = globaltPaakrevd && !user.TwoFactorEnabled;
                _step = 2;
                _busy = false;
                return;
            }

            await FullforInnlogging(user);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Innlogging feilet uventet");
            _error = "Teknisk feil ved innlogging. Prøv igjen senere.";
            _busy = false;
        }
    }

    // Selvbetjent 2FA-oppsett: lagre mobilnummer og send første engangskode.
    private async Task RegistrerMobil()
    {
        _busy = true;
        _error = null;
        try
        {
            if (_pending is null) { Reset(); return; }
            var mobil = (_mobil ?? "").Trim();
            if (new string(mobil.Where(char.IsDigit).ToArray()).Length < 8)
            {
                _error = "Skriv inn et gyldig mobilnummer.";
                _busy = false;
                return;
            }

            await Users.SetMobilAsync(_pending.Id, mobil);
            _pending = _pending with { Mobilnummer = mobil };

            var (sent, error) = await TwoFactor.SendKodeAsync(_pending);
            if (!sent) { _error = error; _busy = false; return; }
            _step = 2;
            _busy = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registrering av mobil (2FA-oppsett) feilet");
            _error = "Teknisk feil. Prøv igjen senere.";
            _busy = false;
        }
    }

    private async Task HandleVerify()
    {
        _busy = true;
        _error = null;
        try
        {
            if (_pending is not null && TwoFactor.Verifiser(_pending.Email, _code))
            {
                // Marker 2FA som aktivert på kontoen når brukeren nettopp satte det opp.
                if (_maaAktivere2fa && !_pending.TwoFactorEnabled)
                {
                    try { await Users.SetTwoFactorAsync(_pending.Id, true); }
                    catch (Exception ex) { Logger.LogWarning(ex, "Kunne ikke sette 2FA=på (fortsetter)"); }
                }
                await FullforInnlogging(_pending);
                return;
            }
            _error = "Feil eller utløpt kode.";
            _busy = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "2FA-verifisering feilet uventet");
            _error = "Teknisk feil. Prøv igjen senere.";
            _busy = false;
        }
    }

    // Sett in-memory-sesjon + persister kryptert i nettleseren (overlever refresh), og gå til CRM.
    private async Task FullforInnlogging(UserRow user)
    {
        Session.SignIn(user);
        try { await LocalStorage.SetAsync("rk_session", new PersistertSesjon(user.Id, user.Email, user.FullName, user.Role)); }
        catch (Exception ex) { Logger.LogWarning(ex, "Kunne ikke persistere sesjon (fortsetter uten)"); }
        Nav.NavigateTo("/crm");
    }

    private void Reset()
    {
        _step = 1;
        _pending = null;
        _code = "";
        _mobil = "";
        _maaAktivere2fa = false;
        _error = null;
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
