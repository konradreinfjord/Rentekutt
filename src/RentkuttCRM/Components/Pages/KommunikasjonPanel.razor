@* Kommunikasjonspanel — Klaviyo-hendelser + 24-timers SMS-løp. Brukes som fane under Admin
   (og av den tynne siden /crm/kommunikasjon). Ingen @page her; verten styrer tilgang. *@
@inject RentkuttCRM.Services.SettingsService Settings
@inject RentkuttCRM.Services.SmsMalService SmsMaler
@inject RentkuttCRM.Services.SmsLoepService Loep
@inject RentkuttCRM.Services.PartnerService Partners
@inject RentkuttCRM.Services.SmsUtsendingService SmsLogg
@inject RentkuttCRM.Services.KlaviyoService Klaviyo
@inject RentkuttCRM.Services.LinkMobilityService LinkMobility

@if (_laster)
{
    <p class="page-sub">Laster…</p>
}
else
{
    @* ============ KLAVIYO ============ *@
    <div class="section">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:12px">
            <h2 style="margin:0">Klaviyo <span class="ww-tag">Hendelser</span></h2>
            <span class="status @(Klaviyo.ErKonfigurert ? "on" : "off")">@(Klaviyo.ErKonfigurert ? "Konfigurert" : "Ikke konfigurert")</span>
        </div>
        <p class="page-sub" style="margin:8px 0 16px">
            Send hendelser (events) fra portalen til Klaviyo for e-post-/markedsføringsflyt. Profiler knyttes på e-post.
        </p>

        <div class="kv-list" style="margin-bottom:16px">
            <span class="k">Status</span>
            <span class="v">@(Klaviyo.ErKonfigurert ? "API-nøkkel satt ✓" : "Mangler Klaviyo__ApiKey")</span>
            <span class="k">API-revisjon</span><span class="v">@Klaviyo.Revisjon</span>
        </div>

        <label class="ff-check" style="margin-bottom:12px">
            <input type="checkbox" @bind="_klaviyoEnabled" /> Aktivér utsending av hendelser til Klaviyo
        </label>
        <div class="rule-builder" style="margin-bottom:6px">
            <button class="btn-primary rb-add" @onclick="LagreKlaviyo">Lagre</button>
        </div>
        @if (!string.IsNullOrEmpty(_klaviyoMsg)) { <p class="page-sub" style="margin:0 0 14px; font-size:12px">@_klaviyoMsg</p> }

        <h3 class="ww-h">Hendelser som er klargjort for Klaviyo</h3>
        <table class="data-table" style="margin-bottom:16px">
            <thead><tr><th>Hendelse (metric)</th><th>Utløses når</th></tr></thead>
            <tbody>
                @foreach (var e in RentkuttCRM.Services.KlaviyoService.Eventtyper)
                {
                    <tr><td><strong>@e.Metric</strong></td><td class="brk-kilde">@e.Beskrivelse</td></tr>
                }
            </tbody>
        </table>

        <h3 class="ww-h">Test</h3>
        <div class="rule-builder" style="align-items:flex-end; margin-bottom:6px">
            <button class="btn-sm" @onclick="TestKlaviyo" disabled="@_klaviyoJobber">Test tilkobling</button>
            <div class="rb-field" style="max-width:260px"><label>Send testevent til e-post</label><input class="rb-input" @bind="_testEpost" placeholder="navn@eksempel.no" /></div>
            <button class="btn-sm" @onclick="SendTestEvent" disabled="@_klaviyoJobber">Send testevent</button>
        </div>
        @if (!string.IsNullOrEmpty(_testMsg)) { <p class="page-sub" style="margin:0 0 14px; font-size:12px">@_testMsg</p> }

        <h3 class="ww-h">Konfigurasjon (Azure App Settings)</h3>
        <pre class="code-block">Klaviyo__ApiKey    = &lt;privat API-nøkkel (pk_...)&gt;
Klaviyo__Revision  = 2025-01-15        (valgfri)</pre>
        <p class="page-sub" style="margin:12px 0 0; font-size:12px">
            🔒 API-nøkkelen leses kun fra server-config (Azure), aldri fra databasen.
        </p>
    </div>

    @* ============ SMS-MALER ============ *@
    <div class="section">
        <h2 style="margin:0 0 4px">SMS-maler</h2>
        <p class="page-sub" style="margin:0 0 10px">Maler som kan sendes til kunder (fra kundekortet og i SMS-løp).</p>
        <div class="kv-list" style="margin-bottom:14px; background:#f4f7fb; border:1px solid var(--border); border-radius:8px; padding:10px 13px">
            <span class="k">Flettefelt</span>
            <span class="v"><code>{navn}</code> <code>{signeringslenke}</code> <code>{belop}</code> <code>{lanetype}</code> <code>{bank}</code> — settes inn automatisk per kunde ved utsending.</span>
        </div>
        <div class="table-scroll">
        <table class="data-table" style="margin-bottom:14px">
            <thead><tr><th>Navn</th><th>Tekst</th><th></th></tr></thead>
            <tbody>
                @if (_maler.Count == 0) { <tr><td colspan="3" class="empty-row">Ingen maler ennå — opprett en under.</td></tr> }
                @foreach (var m in _maler)
                {
                    @if (_redigerMalId == m.Id)
                    {
                        <tr>
                            <td style="vertical-align:top"><input class="rb-input" @bind="_redigerNavn" style="max-width:180px" /></td>
                            <td><textarea class="rb-input" style="min-height:110px; resize:vertical; line-height:1.5; width:100%" rows="5" @bind="_redigerTekst"></textarea></td>
                            <td style="vertical-align:top; white-space:nowrap">
                                <button class="btn-primary btn-sm" @onclick="LagreMalRedigering">Lagre</button>
                                <button class="btn-sm" @onclick="AvbrytMalRedigering">Avbryt</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td style="vertical-align:top"><strong>@m.Navn</strong></td>
                            <td style="white-space:pre-wrap; max-width:560px; line-height:1.5">@m.Tekst</td>
                            <td style="vertical-align:top; white-space:nowrap">
                                <button class="btn-sm" @onclick="() => StartMalRedigering(m)">Endre</button>
                                <button class="btn-sm" @onclick="() => SlettMal(m.Id)">Slett</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
        <div class="rule-builder" style="align-items:flex-start">
            <div class="rb-field" style="max-width:200px"><label>Malnavn</label><input class="rb-input" @bind="_nyMalNavn" placeholder="F.eks. Velkomst" /></div>
            <div class="rb-field" style="flex:1; min-width:280px">
                <label>Meldingstekst</label>
                <textarea class="rb-input" style="min-height:120px; resize:vertical; line-height:1.5" rows="5" @bind="_nyMalTekst"
                          placeholder="Hei {navn},&#10;&#10;Søknaden din er innvilget. Fullfør signeringen her: {signeringslenke}&#10;&#10;Mvh Rentekutt"></textarea>
                <span class="page-sub" style="font-size:11px; margin-top:4px">Trykk Enter for linjeskift. Flettefelt: <code>{navn}</code> <code>{signeringslenke}</code> <code>{belop}</code> <code>{lanetype}</code> <code>{bank}</code>.</span>
            </div>
            <button class="btn-primary rb-add" @onclick="LeggTilMal">Legg til mal</button>
        </div>
        @if (!string.IsNullOrEmpty(_malMsg)) { <p class="page-sub" style="margin:8px 0 0; font-size:12px">@_malMsg</p> }
    </div>

    @* ============ SMS-LØP (konfigurerbare) ============ *@
    <div class="section">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:12px">
            <h2 style="margin:0">SMS-løp <span class="ww-tag">LinkMobility</span></h2>
            <span class="status @(LinkMobility.ErKonfigurert ? "on" : "off")">@(LinkMobility.ErKonfigurert ? "SMS aktiv" : "SMS av")</span>
        </div>
        <p class="page-sub" style="margin:8px 0 14px">
            Automatiske SMS-er basert på status og tid. Hvert løp sender <strong>én gang per sak</strong>, og kun hvis
            saken fremdeles står i valgt status. Avsender: <strong>@LinkMobility.Sender</strong>. Bruk <code>{navn}</code> for kundens fornavn.
        </p>

        @if (!LinkMobility.ErKonfigurert)
        {
            <p class="page-sub" style="color:#b42318; margin:0 0 14px">⚠️ LinkMobility er ikke konfigurert (ClientId/secret mangler). Løpene sender ingenting før dette er på plass. Sett det opp under Admin → API og Data → LinkMobility.</p>
        }

        <div class="kv-list" style="margin-bottom:16px">
            <span class="k">Sendevindu</span>
            <span class="v">⏰ <strong>08–21 på hverdager</strong> (man–fre). Meldinger utenfor vinduet venter til neste virketime.</span>
            <span class="k">Skann hvert</span>
            <span class="v"><input class="rb-input" type="number" min="5" style="max-width:80px; display:inline-block" @bind="_intervall" /> min <button class="btn-sm" @onclick="LagreIntervall">Lagre</button></span>
        </div>

        <h3 class="ww-h">Løp</h3>
        <div class="table-scroll">
        <table class="data-table" style="margin-bottom:14px">
            <thead><tr><th>Navn</th><th>Når saken står i</th><th>Bank</th><th>Send etter</th><th>Ikke eldre enn</th><th>Mal</th><th>Klaviyo</th><th>Aktiv</th><th></th></tr></thead>
            <tbody>
                @if (_loep.Count == 0) { <tr><td colspan="9" class="empty-row">Ingen SMS-løp ennå — opprett ett under.</td></tr> }
                @foreach (var l in _loep)
                {
                    <tr>
                        <td><strong>@l.Navn</strong></td>
                        <td>@l.TriggerStatus</td>
                        <td>@(string.IsNullOrWhiteSpace(l.Bank) ? "Alle" : l.Bank)</td>
                        <td>@l.SendEtterTimer t</td>
                        <td>@l.IkkeEldreTimer t</td>
                        <td>@(string.IsNullOrWhiteSpace(l.MalNavn) ? "—" : l.MalNavn)</td>
                        <td>@(string.IsNullOrWhiteSpace(l.KlaviyoEvent) ? "—" : l.KlaviyoEvent)</td>
                        <td><input type="checkbox" checked="@l.Aktiv" @onchange="e => ToggleAktiv(l, e)" /></td>
                        <td style="white-space:nowrap"><button class="btn-sm" @onclick="() => StartRediger(l)">Endre</button> <button class="btn-sm" @onclick="() => SlettLoep(l)">Slett</button></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <h3 class="ww-h">@(_fRedigerId is null ? "Nytt løp" : "Endre løp")</h3>
        <div class="rule-builder" style="align-items:flex-end; flex-wrap:wrap">
            <div class="rb-field" style="max-width:190px"><label>Navn</label><input class="rb-input" @bind="_fNavn" placeholder="F.eks. 1-times påminnelse" /></div>
            <div class="rb-field" style="max-width:185px"><label>Når saken står i status</label>
                <select class="rb-input" @bind="_fStatus">
                    @foreach (var s in RentkuttCRM.Services.KundekortService.Statuser) { <option value="@s">@s</option> }
                </select>
            </div>
            <div class="rb-field" style="max-width:170px"><label>Bank (valgfritt)</label>
                <select class="rb-input" @bind="_fBank">
                    <option value="">Alle banker</option>
                    @foreach (var p in _partnere) { <option value="@p.Navn">@p.Navn</option> }
                </select>
            </div>
            <div class="rb-field rb-op" style="max-width:120px"><label>Send etter (t)</label><input class="rb-input" type="number" min="1" @bind="_fSendEtter" /></div>
            <div class="rb-field rb-op" style="max-width:130px"><label>Ikke eldre (t)</label><input class="rb-input" type="number" min="2" @bind="_fIkkeEldre" /></div>
            <div class="rb-field" style="max-width:190px"><label>Mal</label>
                <select class="rb-input" @bind="_fMal">
                    <option value="">— velg mal —</option>
                    @foreach (var m in _maler) { <option value="@m.Navn">@m.Navn</option> }
                </select>
            </div>
            <div class="rb-field" style="max-width:190px"><label>Klaviyo-event (valgfritt)</label><input class="rb-input" @bind="_fKlaviyo" placeholder="F.eks. Innvilget" /></div>
            <button class="btn-primary rb-add" @onclick="LagreLoep">@(_fRedigerId is null ? "Legg til løp" : "Lagre endring")</button>
            @if (_fRedigerId is not null) { <button class="btn-sec rb-add" @onclick="AvbrytRediger">Avbryt</button> }
        </div>
        <p class="page-sub" style="margin:8px 0 0; font-size:12px">
            «Send etter» måles fra saken ble registrert. «Ikke eldre enn» hindrer masseutsending til gamle leads når et løp skrus på.
            Eksempel: to løp på «Påbegynt søknad» — ett som sender etter 1 time og ett etter 24 timer, begge kun hvis saken fortsatt er påbegynt.
            Instabank-eksempel: løp på status <strong>«Innvilget»</strong> med Klaviyo-event «Innvilget» → kunden får SMS med signeringslenke + event sendes til Klaviyo.
            <br />Flettefelt i malen: <code>{navn}</code> <code>{signeringslenke}</code> <code>{belop}</code> <code>{lanetype}</code> <code>{bank}</code> (samme felt følger med som egenskaper på Klaviyo-eventen).
        </p>
        @if (!string.IsNullOrEmpty(_smsMsg)) { <p class="page-sub" style="margin:6px 0 0; font-size:12px">@_smsMsg</p> }

        <h3 class="ww-h" style="margin-top:20px">Send test-SMS</h3>
        <p class="page-sub" style="margin:-4px 0 10px; font-size:12px">
            Send en test til deg selv. Avsender blir <strong>@LinkMobility.Sender</strong>. Skriv meldingen du vil teste. <code>{navn}</code> blir «Test».
        </p>
        <div class="rule-builder" style="align-items:flex-start; flex-wrap:wrap">
            <div class="rb-field" style="max-width:180px"><label>Mobilnummer</label><input class="rb-input" @bind="_testMobil" placeholder="F.eks. 99887766" /></div>
            <div class="rb-field" style="flex:1; min-width:260px"><label>Melding</label><textarea class="rb-input" rows="2" @bind="_testSmsTekst" placeholder="Skriv meldingen du vil teste"></textarea></div>
            <button class="btn-primary rb-add" @onclick="SendTestSms" disabled="@(_testSender || !LinkMobility.ErKonfigurert)">@(_testSender ? "Sender…" : "Send test-SMS")</button>
        </div>
        @if (!LinkMobility.ErKonfigurert) { <p class="page-sub" style="margin:6px 0 0; font-size:12px; color:#b42318">LinkMobility er ikke konfigurert — kan ikke sende test.</p> }
        @if (!string.IsNullOrEmpty(_testSmsMsg)) { <p class="page-sub" style="margin:8px 0 0; font-size:12px">@_testSmsMsg</p> }

        <h3 class="ww-h" style="margin-top:20px">Siste utsendinger</h3>
        <div class="table-scroll">
        <table class="data-table">
            <thead><tr><th>Tidspunkt</th><th>Type</th><th>Mobil</th><th>Resultat</th><th>Detalj</th></tr></thead>
            <tbody>
                @if (_sisteSms.Count == 0) { <tr><td colspan="5" class="empty-row">Ingen utsendinger ennå.</td></tr> }
                @foreach (var s in _sisteSms)
                {
                    <tr>
                        <td style="white-space:nowrap">@s.SendtAt.TilOslo().ToString("dd.MM.yy HH:mm")</td>
                        <td>@(s.Type != null && s.Type.StartsWith("sms_loep:") ? "SMS-løp" : s.Type == RentkuttCRM.Services.SmsUtsendingService.TypePaamindelse24t ? "24t-påminnelse" : s.Type)</td>
                        <td class="mono-cell">@(s.Mobil ?? "—")</td>
                        <td><span class="status @(s.Ok ? "on" : "off")">@(s.Ok ? "Sendt" : "Feilet")</span></td>
                        <td class="brk-kilde">@(string.IsNullOrWhiteSpace(s.Detalj) ? "—" : s.Detalj)</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}

@code {
    private bool _laster = true;

    // Klaviyo
    private bool _klaviyoEnabled;
    private string _testEpost = "";
    private bool _klaviyoJobber;
    private string? _klaviyoMsg, _testMsg;

    // SMS-løp
    private int _intervall = RentkuttCRM.Services.Paamindelse24tWorker.StandardIntervallMin;
    private string? _smsMsg;
    private List<RentkuttCRM.Services.SmsLoep> _loep = new();
    // Skjema (nytt/endre løp)
    private string? _fRedigerId;
    private string _fNavn = "", _fStatus = RentkuttCRM.Services.KundekortService.StatusPaabegynt, _fMal = "";
    private string _fKlaviyo = "", _fBank = "";
    private int _fSendEtter = 24, _fIkkeEldre = 72;
    private List<RentkuttCRM.Services.Partner> _partnere = new();
    // SMS-maler
    private string _nyMalNavn = "", _nyMalTekst = "";
    private string? _malMsg;
    private Guid? _redigerMalId;
    private string _redigerNavn = "", _redigerTekst = "";
    private string _testMobil = "";
    private string _testSmsTekst = "";
    private bool _testSender;
    private string? _testSmsMsg;
    private List<RentkuttCRM.Services.SmsMal> _maler = new();
    private List<RentkuttCRM.Services.SmsUtsending> _sisteSms = new();

    protected override async Task OnInitializedAsync() => await Last();

    private async Task Last()
    {
        _laster = true;
        _maler = await SmsMaler.ListAsync();
        _klaviyoEnabled = await Settings.GetBoolAsync(RentkuttCRM.Services.KlaviyoService.KeyEnabled, false);
        _intervall = await Settings.GetIntAsync(RentkuttCRM.Services.Paamindelse24tWorker.KeyIntervallMin, RentkuttCRM.Services.Paamindelse24tWorker.StandardIntervallMin);
        _loep = await Loep.HentAsync();
        _partnere = await Partners.ListAsync();
        _sisteSms = await SmsLogg.SisteAsync(30);
        _laster = false;
    }

    private async Task LagreKlaviyo()
    {
        await Settings.SetAsync(RentkuttCRM.Services.KlaviyoService.KeyEnabled, _klaviyoEnabled ? "true" : "false");
        _klaviyoMsg = "Lagret.";
    }

    private async Task TestKlaviyo()
    {
        _klaviyoJobber = true; _testMsg = "Tester …";
        var (ok, status, detalj) = await Klaviyo.TestTilkoblingAsync();
        _testMsg = (ok ? "✓ " : "✗ ") + detalj + (status > 0 ? $" (HTTP {status})" : "");
        _klaviyoJobber = false;
    }

    private async Task SendTestEvent()
    {
        if (string.IsNullOrWhiteSpace(_testEpost)) { _testMsg = "Skriv inn en e-post først."; return; }
        _klaviyoJobber = true; _testMsg = "Sender …";
        var (ok, status, detalj) = await Klaviyo.SendEventAsync(
            "Test event", _testEpost.Trim(),
            new Dictionary<string, object?> { ["kilde"] = "admin-test" });
        _testMsg = (ok ? "✓ " : "✗ ") + detalj + (status > 0 ? $" (HTTP {status})" : "");
        _klaviyoJobber = false;
    }

    private async Task SendTestSms()
    {
        if (string.IsNullOrWhiteSpace(_testMobil)) { _testSmsMsg = "Skriv inn et mobilnummer."; return; }
        var tekst = _testSmsTekst;
        if (string.IsNullOrWhiteSpace(tekst)) { _testSmsMsg = "Skriv en melding å teste."; return; }
        _testSender = true; _testSmsMsg = "Sender …";
        var (ok, detalj) = await SmsMaler.SendTilKundeAsync(_testMobil.Trim(), tekst, "Test");
        _testSmsMsg = ok ? "✓ Test-SMS sendt." : "✗ Feilet: " + detalj;
        _testSender = false;
    }

    // --- SMS-maler (flyttet hit fra LinkMobility-fanen) ---
    private async Task LeggTilMal()
    {
        var (ok, error) = await SmsMaler.AddAsync(_nyMalNavn, _nyMalTekst);
        _malMsg = ok ? "Mal lagt til." : error;
        if (ok) { _nyMalNavn = ""; _nyMalTekst = ""; _maler = await SmsMaler.ListAsync(); }
    }

    private void StartMalRedigering(RentkuttCRM.Services.SmsMal m)
    {
        _redigerMalId = m.Id; _redigerNavn = m.Navn; _redigerTekst = m.Tekst; _malMsg = null;
    }

    private void AvbrytMalRedigering()
    {
        _redigerMalId = null; _redigerNavn = ""; _redigerTekst = "";
    }

    private async Task LagreMalRedigering()
    {
        if (_redigerMalId is not { } id) return;
        var (ok, error) = await SmsMaler.UpdateAsync(id, _redigerNavn, _redigerTekst);
        _malMsg = ok ? "Mal oppdatert." : error;
        if (ok) { AvbrytMalRedigering(); _maler = await SmsMaler.ListAsync(); }
    }

    private async Task SlettMal(Guid id)
    {
        await SmsMaler.DeleteAsync(id);
        if (_redigerMalId == id) AvbrytMalRedigering();
        _maler = await SmsMaler.ListAsync();
    }

    private async Task LagreIntervall()
    {
        if (_intervall < 5) _intervall = 5;
        await Settings.SetAsync(RentkuttCRM.Services.Paamindelse24tWorker.KeyIntervallMin, _intervall.ToString());
        _smsMsg = "Skann-intervall lagret.";
    }

    private async Task LagreLoep()
    {
        _fNavn = (_fNavn ?? "").Trim();
        if (string.IsNullOrWhiteSpace(_fNavn)) { _smsMsg = "Gi løpet et navn."; return; }
        if (string.IsNullOrWhiteSpace(_fMal)) { _smsMsg = "Velg en mal."; return; }
        if (_fSendEtter < 1) _fSendEtter = 1;
        if (_fIkkeEldre <= _fSendEtter) _fIkkeEldre = _fSendEtter + 1;

        if (_fRedigerId is null)
        {
            _loep.Add(new RentkuttCRM.Services.SmsLoep
            {
                Navn = _fNavn, Aktiv = true, TriggerStatus = _fStatus,
                SendEtterTimer = _fSendEtter, IkkeEldreTimer = _fIkkeEldre, MalNavn = _fMal,
                Bank = string.IsNullOrWhiteSpace(_fBank) ? null : _fBank,
                KlaviyoEvent = string.IsNullOrWhiteSpace(_fKlaviyo) ? null : _fKlaviyo.Trim(),
            });
        }
        else
        {
            var l = _loep.FirstOrDefault(x => x.Id == _fRedigerId);
            if (l is not null)
            {
                l.Navn = _fNavn; l.TriggerStatus = _fStatus;
                l.SendEtterTimer = _fSendEtter; l.IkkeEldreTimer = _fIkkeEldre; l.MalNavn = _fMal;
                l.Bank = string.IsNullOrWhiteSpace(_fBank) ? null : _fBank;
                l.KlaviyoEvent = string.IsNullOrWhiteSpace(_fKlaviyo) ? null : _fKlaviyo.Trim();
            }
        }
        await Loep.LagreAsync(_loep);
        _smsMsg = _fRedigerId is null ? "Løp lagt til." : "Løp oppdatert.";
        AvbrytRediger();
    }

    private void StartRediger(RentkuttCRM.Services.SmsLoep l)
    {
        _fRedigerId = l.Id; _fNavn = l.Navn; _fStatus = l.TriggerStatus;
        _fSendEtter = l.SendEtterTimer; _fIkkeEldre = l.IkkeEldreTimer; _fMal = l.MalNavn;
        _fKlaviyo = l.KlaviyoEvent ?? ""; _fBank = l.Bank ?? "";
        _smsMsg = null;
    }

    private void AvbrytRediger()
    {
        _fRedigerId = null; _fNavn = ""; _fStatus = RentkuttCRM.Services.KundekortService.StatusPaabegynt;
        _fMal = ""; _fSendEtter = 24; _fIkkeEldre = 72; _fKlaviyo = ""; _fBank = "";
    }

    private async Task SlettLoep(RentkuttCRM.Services.SmsLoep l)
    {
        _loep.Remove(l);
        if (_fRedigerId == l.Id) AvbrytRediger();
        await Loep.LagreAsync(_loep);
        _smsMsg = "Løp slettet.";
    }

    private async Task ToggleAktiv(RentkuttCRM.Services.SmsLoep l, ChangeEventArgs e)
    {
        l.Aktiv = e.Value is true;
        await Loep.LagreAsync(_loep);
    }
}
